@using PagedList.Core.Mvc
@using QuanLyThuVien.Models
@model PagedList.Core.IPagedList<tblAuthor>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Tác giả";
}

<main class="main">
    <!-- Page Title -->
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Tác giả</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="current">Tác giả</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->

    <!-- Courses 2 Section -->
    <section id="courses-2" class="courses-2 section">
        <div class="container" data-aos="fade-up" data-aos-delay="100">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@Html.Raw(TempData["ErrorMessage"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="row">
                <!-- Sidebar Search -->
                <div class="col-lg-3">
                    <div class="course-filters" data-aos="fade-right" data-aos-delay="100">
                        <h4 class="filter-title">Tìm kiếm</h4>
                        <form method="get" asp-action="Index" class="mb-3">
                            <div class="filter-group">
                                <div class="input-group">
                                    <input type="text" name="searchString" class="form-control" value="@ViewBag.SearchString" placeholder="Nhập tên tác giả...">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                                <small class="text-muted d-block mt-1">Tìm kiếm theo tên tác giả</small>
                            </div>
                        </form>

                        @if (!string.IsNullOrWhiteSpace(ViewBag.SearchString))
                        {
                            <div class="mt-3">
                                <a asp-action="Index" class="btn btn-outline-danger w-100">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Xóa tìm kiếm
                                </a>
                            </div>
                        }
                    </div><!-- End Course Filters -->
                </div>

                <!-- Main Content -->
                <div class="col-lg-9">
                    <div class="courses-header" data-aos="fade-left" data-aos-delay="100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Danh sách tác giả (@(Model?.TotalItemCount ?? 0) tác giả) </h5>
                            <div class="text-muted small ms-2">
                                @if (Model != null && Model.PageCount > 1)
                                {
                                    <span> Trang @Model.PageNumber / @Model.PageCount</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="courses-grid" data-aos="fade-up" data-aos-delay="200">
                        <div class="row">
                            @if (Model != null && Model.Count > 0)
                            {
                                @foreach (var author in Model)
                                {
                                    <div class="col-lg-4 col-md-6 mb-4">
                                        <div class="course-card h-100">
                                            <div class="course-image position-relative">
                                                @if (!string.IsNullOrEmpty(author.Avatar))
                                                {
                                                    <img src="@author.Avatar" alt="@author.AuthorName" class="img-fluid" style="height: 250px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                                        <i class="bi bi-person text-muted" style="font-size: 4rem;"></i>
                                                    </div>
                                                }
                                            </div>
                                            <div class="course-content">
                                                <div class="course-meta">
                                                    <span class="category">Tác giả</span>
                                                    @if (author.DateOfBirth.HasValue)
                                                    {
                                                        <span class="level">@author.DateOfBirth.Value.ToString("yyyy")</span>
                                                    }
                                                </div>
                                                <h3>@author.AuthorName</h3>
                                                <p>@(!string.IsNullOrEmpty(author.Biography) ? (author.Biography.Length > 100 ? author.Biography.Substring(0, 100) + "..." : author.Biography) : "Chưa có tiểu sử")</p>
                                                <div class="course-stats">
                                                    @if (author.DateOfBirth.HasValue)
                                                    {
                                                        <div class="stat">
                                                            <i class="bi bi-calendar"></i>
                                                            <span>Sinh: @author.DateOfBirth.Value.ToString("dd/MM/yyyy")</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(author.Email))
                                                    {
                                                        <div class="stat">
                                                            <i class="bi bi-envelope"></i>
                                                            <span>@author.Email</span>
                                                        </div>
                                                    }
                                                </div>
                                                
                                                <div class="d-flex gap-2 mt-3 mb-2">
                                                    <a asp-action="Details" asp-route-id="@author.AuthorID" class="btn btn-outline-primary btn-sm flex-fill">
                                                        <i class="bi bi-info-circle me-1"></i>Chi tiết
                                                    </a>
                                                </div>
                                            </div>
                                        </div><!-- End Course Card -->
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12">
                                    <div class="alert alert-info text-center">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        Không tìm thấy tác giả nào.
                                    </div>
                                </div>
                            }
                        </div>
                    </div><!-- End Courses Grid -->

                    <!-- Pagination -->
                    @if (Model != null && Model.PageCount > 1)
                    {
                        <div class="pagination-wrapper" data-aos="fade-up" data-aos-delay="300">
                            <nav aria-label="Authors pagination">
                                <ul class="pagination justify-content-center">
                                    @if (Model.HasPreviousPage)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-searchString="@ViewBag.SearchString">&laquo; Trước</a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="page-item disabled"><span class="page-link">&laquo; Trước</span></li>
                                    }

                                    @{
                                        int current = Model.PageNumber;
                                        int total = Model.PageCount;
                                        int start = Math.Max(1, current - 2);
                                        int end = Math.Min(total, current + 2);
                                        if (start > 1)
                                        {
                                            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="1" asp-route-searchString="@ViewBag.SearchString">1</a></li>
                                            if (start > 2)
                                            {
                                                <li class="page-item disabled"><span class="page-link">...</span></li>
                                            }
                                        }

                                        for (int i = start; i <= end; i++)
                                        {
                                            if (i == current)
                                            {
                                                <li class="page-item active" aria-current="page"><span class="page-link">@i</span></li>
                                            }
                                            else
                                            {
                                                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewBag.SearchString">@i</a></li>
                                            }
                                        }

                                        if (end < total)
                                        {
                                            if (end < total - 1)
                                            {
                                                <li class="page-item disabled"><span class="page-link">...</span></li>
                                            }
                                            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@total" asp-route-searchString="@ViewBag.SearchString">@total</a></li>
                                        }
                                    }

                                    @if (Model.HasNextPage)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-searchString="@ViewBag.SearchString">Tiếp &raquo;</a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="page-item disabled"><span class="page-link">Tiếp &raquo;</span></li>
                                    }

                                </ul>
                            </nav>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section><!-- /Courses 2 Section -->
</main>
