@model QuanLyThuVien.Models.tblAuthor

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.AuthorName ?? "Chi tiết tác giả";
}

<main class="main">
    <!-- Page Title -->
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Chi tiết tác giả</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li><a asp-controller="Author" asp-action="Index">Tác giả</a></li>
                    <li class="current">@Model.AuthorName</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->

    <section id="courses" class="courses section">
        <div class="container" data-aos="fade-up">
            <div class="row">
                <!-- Thông tin tác giả -->
                <div class="col-lg-4 col-md-5 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            @if (!string.IsNullOrEmpty(Model.Avatar))
                            {
                                <img src="@Model.Avatar" alt="@Model.AuthorName" 
                                     class="img-fluid rounded mb-3" 
                                     style="max-height: 300px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center rounded mb-3" 
                                     style="height: 300px;">
                                    <i class="bi bi-person text-muted" style="font-size: 5rem;"></i>
                                </div>
                            }
                            
                            <h3 class="mb-3">@Model.AuthorName</h3>
                            
                            <div class="text-start mb-3">
                                @if (Model.DateOfBirth.HasValue)
                                {
                                    <div class="mb-2">
                                        <i class="bi bi-calendar me-2"></i><strong>Ngày sinh:</strong><br>
                                        <span class="text-muted">@Model.DateOfBirth.Value.ToString("dd/MM/yyyy")</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.Email))
                                {
                                    <div class="mb-2">
                                        <i class="bi bi-envelope me-2"></i><strong>Email:</strong><br>
                                        <span class="text-muted">@Model.Email</span>
                                    </div>
                                }
                            </div>
                            
                            @if (!string.IsNullOrEmpty(Model.Biography))
                            {
                                <div class="border-top pt-3">
                                    <h5 class="mb-2"><i class="bi bi-file-text me-2"></i>Tiểu sử</h5>
                                    <p class="text-muted text-start">@Model.Biography</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Danh sách sách -->
                <div class="col-lg-8 col-md-7">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h2 class="card-title mb-3">
                                <i class="bi bi-book me-2"></i>Sách của tác giả (@(Model.BookAuthors != null ? Model.BookAuthors.Count : 0))
                            </h2>
                            
                            @if (Model.BookAuthors != null && Model.BookAuthors.Any())
                            {
                                <div class="row">
                                    @foreach (var bookAuthor in Model.BookAuthors)
                                    {
                                        var book = bookAuthor.Book;
                                        if (book != null && book.IsActive == true)
                                        {
                                            <div class="col-md-6 mb-4">
                                                <div class="course-card h-100">
                                                    <div class="course-image position-relative">
                                                        @if (!string.IsNullOrEmpty(book.CoverImage))
                                                        {
                                                            <img src="@book.CoverImage" alt="@book.Title" class="img-fluid" style="height: 200px; object-fit: cover;">
                                                        }
                                                        else
                                                        {
                                                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                                                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                                                            </div>
                                                        }
                                                        <div class="position-absolute top-0 end-0 m-2">
                                                            <span class="badge bg-@(book.Quantity > 0 ? "success" : "danger")">
                                                                @(book.Quantity > 0 ? $"{book.Quantity} cuốn" : "Hết sách")
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="course-content">
                                                        <div class="course-meta">
                                                            <span class="category">@book.Category?.CategoryName</span>
                                                            <span class="level">@book.PublishedYear</span>
                                                        </div>
                                                        <h4>@book.Title</h4>
                                                        <p>@(!string.IsNullOrEmpty(book.Description) ? (book.Description.Length > 100 ? book.Description.Substring(0, 100) + "..." : book.Description) : "Không có mô tả")</p>
                                                        <div class="course-stats">
                                                            <div class="stat">
                                                                <i class="bi bi-building"></i>
                                                                <span>@book.Publisher?.PublisherName</span>
                                                            </div>
                                                        </div>
                                                        <div class="d-flex gap-2 mt-3">
                                                            <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookID" class="btn btn-outline-primary btn-sm flex-fill">
                                                                <i class="bi bi-info-circle me-1"></i>Chi tiết
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info text-center">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Không có sách nào của tác giả này.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
