@model IList<QuanLyThuVien.Models.tblBorrow>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Lịch sử mượn sách";
}

<main class="main">
    <!-- Page Title -->
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Lịch sử mượn sách</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="current">Lịch sử mượn</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->

    <section id="courses" class="courses section">
        <div class="container" data-aos="fade-up">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@Html.Raw(TempData["ErrorMessage"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model != null && Model.Count > 0)
            {
                @foreach (var borrow in Model)
                {
                    <div class="card mb-4 shadow-sm">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-0">
                                    <i class="bi bi-receipt me-2"></i>Phiếu mượn #@borrow.BorrowID
                                </h5>
                                <small>Ngày mượn: @borrow.BorrowDate.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                            <div class="text-end">
                                @if (borrow.Status == "Returned")
                                {
                                    <span class="badge bg-success fs-6">Đã trả</span>
                                }
                                else if (borrow.Status == "Overdue")
                                {
                                    <span class="badge bg-danger fs-6">Quá hạn</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning fs-6">Đang mượn</span>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong>Hạn trả:</strong> 
                                    <span class="@(DateTime.Now > borrow.DueDate && borrow.Status != "Returned" ? "text-danger fw-bold" : "")">
                                        @borrow.DueDate.ToString("dd/MM/yyyy")
                                    </span>
                                    @{
                                        var daysRemaining = 0;
                                        var isOverdue = false;
                                        if (borrow.Status != "Returned")
                                        {
                                            var timeSpan = borrow.DueDate - DateTime.Now;
                                            daysRemaining = (int)timeSpan.TotalDays;
                                            isOverdue = daysRemaining < 0;
                                        }
                                    }
                                    @if (borrow.Status != "Returned")
                                    {
                                        <br>
                                        @if (isOverdue)
                                        {
                                            <span class="badge bg-danger mt-1">
                                                <i class="bi bi-exclamation-triangle me-1"></i>Quá hạn @Math.Abs(daysRemaining) ngày
                                            </span>
                                        }
                                        else if (daysRemaining <= 3)
                                        {
                                            <span class="badge bg-warning mt-1">
                                                <i class="bi bi-clock me-1"></i>Còn @daysRemaining ngày
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success mt-1">
                                                <i class="bi bi-check-circle me-1"></i>Còn @daysRemaining ngày
                                            </span>
                                        }
                                    }
                                    @if (borrow.Status == "Returned")
                                    {
                                        var lastReturnDate = borrow.BorrowDetails?.Where(bd => bd.ReturnDate.HasValue).Max(bd => bd.ReturnDate);
                                        if (lastReturnDate.HasValue)
                                        {
                                            <br>
                                            <strong class="text-success">Ngày trả:</strong>
                                            <span class="text-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                @lastReturnDate.Value.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        }
                                    }
                                </div>
                                <div class="col-md-6">
                                    <strong>Tổng số sách:</strong> @(borrow.BorrowDetails?.Count ?? 0) cuốn
                                </div>
                            </div>

                            <hr>

                            <h6 class="mb-3"><i class="bi bi-book me-2"></i>Danh sách sách:</h6>
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>STT</th>
                                            <th>Tên sách</th>
                                            <th>Danh mục</th>
                                            <th>Trạng thái</th>
                                            <th>Ngày trả</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (borrow.BorrowDetails != null && borrow.BorrowDetails.Any())
                                        {
                                            int stt = 1;
                                            @foreach (var detail in borrow.BorrowDetails)
                                            {
                                                <tr>
                                                    <td>@stt</td>
                                                    <td>
                                                        <strong>@detail.Book?.Title</strong>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-info">@detail.Book?.Category?.CategoryName</span>
                                                    </td>
                                                    <td>
                                                        @if (detail.BorrowStatus == "Returned")
                                                        {
                                                            <span class="badge bg-success">Đã trả</span>
                                                        }
                                                        else if (DateTime.Now > borrow.DueDate)
                                                        {
                                                            <span class="badge bg-danger">Quá hạn</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning">Đang mượn</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (detail.BorrowStatus == "Returned" && detail.ReturnDate.HasValue)
                                                        {
                                                            <span class="text-success">
                                                                <i class="bi bi-check-circle me-1"></i>
                                                                @detail.ReturnDate.Value.ToString("dd/MM/yyyy HH:mm")
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">Chưa trả</span>
                                                        }
                                                    </td>
                                                </tr>
                                                stt++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    <h5>Bạn chưa có phiếu mượn nào.</h5>
                    <a asp-controller="Borrow" asp-action="Borrow" class="btn btn-primary mt-3">
                        <i class="bi bi-cart-plus me-1"></i>Mượn sách ngay
                    </a>
                </div>
            }
        </div>
    </section>
</main>

@section Scripts {
    <script>
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
}

