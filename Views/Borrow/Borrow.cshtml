@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<QuanLyThuVien.Models.tblBook>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Mượn sách";
}

<main class="main">
    <!-- Page Title -->
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Mượn sách</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="current">Mượn sách</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->

    <!-- Courses Section -->
    <section id="courses" class="courses section">
        <div class="container" data-aos="fade-up">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@Html.Raw(TempData["ErrorMessage"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post" asp-action="Borrow" id="borrowForm">
                @Html.AntiForgeryToken()

                <!-- Bộ lọc và tìm kiếm -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <input type="text" name="searchString" class="form-control" value="@ViewBag.SearchString" placeholder="Tìm kiếm theo tên sách...">
                    </div>
                    <div class="col-md-3">
                        <select name="categoryId" class="form-select">
                            <option value="">Tất cả danh mục</option>
                            @if (ViewBag.Categories != null)
                            {
                                @foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.CategoryID" selected="@(ViewBag.CategoryId == category.CategoryID)">
                                        @category.CategoryName
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" formaction="@Url.Action("Borrow")" formmethod="get" class="btn btn-primary w-100">
                            <i class="bi bi-search me-1"></i>Tìm kiếm
                        </button>
                    </div>
                    <div class="col-md-3 text-end">
                        <button type="submit" class="btn btn-success w-100" id="submitBorrow">
                            <i class="bi bi-cart-check me-1"></i>Mượn sách đã chọn
                        </button>
                    </div>
                </div>

                <!-- Danh sách sách -->
                <div class="row">
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var book in Model)
                        {
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="position-relative">
                                        @if (!string.IsNullOrEmpty(book.CoverImage))
                                        {
                                            <img src="@book.CoverImage" class="card-img-top" alt="@book.Title" style="height: 300px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 300px;">
                                                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                                            </div>
                                        }
                                        <div class="position-absolute top-0 end-0 m-2">
                                            <span class="badge bg-@(book.Quantity > 0 ? "success" : "danger")">
                                                @(book.Quantity > 0 ? $"{book.Quantity} cuốn" : "Hết sách")
                                            </span>
                                        </div>
                                    </div>
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title">@book.Title</h5>
                                        <p class="card-text text-muted small">
                                            @if (!string.IsNullOrEmpty(book.Description))
                                            {
                                                @(book.Description.Length > 100 ? book.Description.Substring(0, 100) + "..." : book.Description)
                                            }
                                        </p>
                                        <div class="mb-2">
                                            @if (book.BookAuthors != null && book.BookAuthors.Any())
                                            {
                                                <small class="text-muted">
                                                    <i class="bi bi-person me-1"></i>
                                                    @string.Join(", ", book.BookAuthors.Select(ba => ba.Author?.AuthorName))
                                                </small>
                                            }
                                        </div>
                                        <div class="mb-2">
                                            <span class="badge bg-info">@book.Category?.CategoryName</span>
                                            <span class="badge bg-secondary">@book.PublishedYear</span>
                                        </div>
                                        <div class="mt-auto">
                                            @if (book.Quantity > 0)
                                            {
                                                <div class="input-group">
                                                    <label class="input-group-text">
                                                        <input type="checkbox" class="form-check-input me-2" name="selectedBooks" value="@book.BookID" id="book_@book.BookID" onchange="toggleQuantity(@book.BookID)">
                                                        Số lượng:
                                                    </label>
                                                    <input type="number" name="quantity_@book.BookID" id="quantity_@book.BookID" 
                                                           class="form-control" min="1" max="@book.Quantity" value="1" 
                                                           disabled style="max-width: 100px;">
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger w-100 py-2">
                                                    <i class="bi bi-x-circle me-1"></i>Hết sách
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <div class="alert alert-info text-center">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không tìm thấy sách nào.
                            </div>
                        </div>
                    }
                </div>

                <!-- Phân trang -->
                @if (Model != null && Model.PageCount > 1)
                {
                    <div class="d-flex justify-content-center mt-4">
                        <ul class="pagination">
                            <pager class="pager-container"
                                   list="@Model"
                                   options="@PagedListRenderOptions.Bootstrap4PageNumbersOnly"
                                   asp-controller="Borrow"
                                   asp-action="Borrow"
                                   asp-route-searchString="@ViewBag.SearchString"
                                   asp-route-categoryId="@ViewBag.CategoryId">
                            </pager>
                        </ul>
                    </div>
                }
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <script>
        function toggleQuantity(bookId) {
            var checkbox = document.getElementById('book_' + bookId);
            var quantityInput = document.getElementById('quantity_' + bookId);
            quantityInput.disabled = !checkbox.checked;
            if (!checkbox.checked) {
                quantityInput.value = 1;
            }
        }

        function updateCheckbox(bookId) {
            var quantityInput = document.getElementById('quantity_' + bookId);
            var checkbox = document.getElementById('book_' + bookId);
            if (quantityInput.value > 0) {
                checkbox.checked = true;
                quantityInput.disabled = false;
            } else {
                checkbox.checked = false;
                quantityInput.disabled = true;
            }
        }

        document.getElementById('borrowForm').addEventListener('submit', function(e) {
            var checkedBoxes = document.querySelectorAll('input[name="selectedBooks"]:checked');
            if (checkedBoxes.length === 0) {
                e.preventDefault();
                alert('Vui lòng chọn ít nhất một cuốn sách để mượn!');
                return false;
            }
            
            // Chỉ submit các sách đã được chọn
            checkedBoxes.forEach(function(checkbox) {
                var bookId = checkbox.value;
                var quantityInput = document.getElementById('quantity_' + bookId);
                if (quantityInput && quantityInput.value <= 0) {
                    checkbox.checked = false;
                }
            });
        });
    </script>
}

