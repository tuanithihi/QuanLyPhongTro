@model QuanLyThuVien.Models.tblCategory

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.CategoryName ?? "Chi tiết danh mục";
}

<main class="main">
    <!-- Page Title -->
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Chi tiết danh mục</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li><a asp-controller="Category" asp-action="Index">Danh mục</a></li>
                    <li class="current">@Model.CategoryName</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->

    <section id="courses" class="courses section">
        <div class="container" data-aos="fade-up">
            <div class="row">
                <!-- Thông tin danh mục -->
                <div class="col-lg-4 col-md-5 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            <div class="bg-primary d-flex align-items-center justify-content-center rounded mb-3" 
                                 style="height: 300px;">
                                <i class="bi bi-tags text-white" style="font-size: 5rem;"></i>
                            </div>
                            
                            <h3 class="mb-3">@Model.CategoryName</h3>
                            
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                <p class="text-muted">@Model.Description</p>
                            }
                            else
                            {
                                <p class="text-muted">Chưa có mô tả</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Danh sách sách -->
                <div class="col-lg-8 col-md-7">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h2 class="card-title mb-3">
                                <i class="bi bi-book me-2"></i>Sách trong danh mục (@(ViewBag.Books != null ? ((List<QuanLyThuVien.Models.tblBook>)ViewBag.Books).Count : 0))
                            </h2>
                            
                            @if (ViewBag.Books != null && ((List<QuanLyThuVien.Models.tblBook>)ViewBag.Books).Any())
                            {
                                <div class="row">
                                    @foreach (var book in (List<QuanLyThuVien.Models.tblBook>)ViewBag.Books)
                                    {
                                        <div class="col-md-6 mb-4">
                                            <div class="course-card h-100">
                                                <div class="course-image position-relative">
                                                    @if (!string.IsNullOrEmpty(book.CoverImage))
                                                    {
                                                        <img src="@book.CoverImage" alt="@book.Title" class="img-fluid" style="height: 200px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                                            <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                                                        </div>
                                                    }
                                                    <div class="position-absolute top-0 end-0 m-2">
                                                        <span class="badge bg-@(book.Quantity > 0 ? "success" : "danger")">
                                                            @(book.Quantity > 0 ? $"{book.Quantity} cuốn" : "Hết sách")
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="course-content">
                                                    <div class="course-meta">
                                                        <span class="category">@book.Publisher?.PublisherName</span>
                                                        <span class="level">@book.PublishedYear</span>
                                                    </div>
                                                    <h4>@book.Title</h4>
                                                    <p>@(!string.IsNullOrEmpty(book.Description) ? (book.Description.Length > 100 ? book.Description.Substring(0, 100) + "..." : book.Description) : "Không có mô tả")</p>
                                                    <div class="course-stats">
                                                        @if (book.BookAuthors != null && book.BookAuthors.Any())
                                                        {
                                                            <div class="stat">
                                                                <i class="bi bi-person"></i>
                                                                <span>@string.Join(", ", book.BookAuthors.Take(2).Select(ba => ba.Author?.AuthorName))</span>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="d-flex gap-2 mt-3">
                                                        <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookID" class="btn btn-outline-primary btn-sm flex-fill">
                                                            <i class="bi bi-info-circle me-1"></i>Chi tiết
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info text-center">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Không có sách nào trong danh mục này.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
