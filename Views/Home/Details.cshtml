@model RoomDetailViewModel
@using QuanLyPhongTro.Models
@{
    ViewData["Title"] = Model.Room.RoomName;
    var room          = Model.Room;
    bool hasAlert     = TempData["BookingSuccess"] != null || TempData["BookingError"] != null;
    bool hasReviewMsg = TempData["ReviewSuccess"]  != null || TempData["ReviewError"]  != null;
    bool isLoggedIn   = ViewBag.IsLoggedIn ?? false;
    string preName    = ViewBag.BookingName  ?? "";
    string prePhone   = ViewBag.BookingPhone ?? "";
    double avg        = Model.AverageRating;
    int    rCount     = Model.ReviewCount;
    var galleryImages = new List<string>();
    if (!string.IsNullOrWhiteSpace(room.ThumbnailImage))
    {
        galleryImages.Add(room.ThumbnailImage);
    }
    galleryImages.AddRange((room.GalleryImages ?? "")
        .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
    galleryImages = galleryImages.Distinct().ToList();
    var amenityItems = (room.IncludedAmenities ?? "")
        .Split(new[] { "\r\n", "\n", ",", ";" }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
}

@* ── Breadcrumb ─────────────────────────────────────────────────────── *@
<div class="bg-light border-bottom py-2">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                        <i class="bi bi-house me-1"></i>Trang chủ
                    </a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">@room.RoomName</li>
            </ol>
        </nav>
    </div>
</div>

@* ── Alerts TempData ─────────────────────────────────────────────────── *@
@if (TempData["BookingSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-0 rounded-0 text-center" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @Html.Raw(TempData["BookingSuccess"]!.ToString())
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["BookingError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-0 rounded-0 text-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["BookingError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ReviewSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-0 rounded-0 text-center" role="alert">
        <i class="bi bi-star-fill me-2"></i>@TempData["ReviewSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ReviewError"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-0 rounded-0 text-center" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["ReviewError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ════════════════════════════ NỘI DUNG CHÍNH ════════════════════════════ *@
<section class="py-5">
<div class="container">

    <div class="row g-5 align-items-start">

        @* ══════════════ LEFT — Thông tin phòng ══════════════ *@
        <div class="col-lg-8">

            @* ── Ảnh phòng ── *@
            @if (galleryImages.Any())
            {
                <div id="roomGalleryCarousel" class="carousel slide rounded-4 overflow-hidden mb-3 shadow-sm detail-hero-img">
                    <div class="carousel-inner">
                        @for (int i = 0; i < galleryImages.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@galleryImages[i]" alt="@room.RoomName" class="w-100"
                                     style="height:420px;object-fit:cover;"
                                     onerror="this.src='https://placehold.co/900x420/e2e8f0/64748b?text=Ảnh+phòng'" />
                            </div>
                        }
                    </div>
                    @if (galleryImages.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#roomGalleryCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Trước</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#roomGalleryCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Sau</span>
                        </button>
                    }
                </div>
                @if (galleryImages.Count > 1)
                {
                    <div class="d-flex gap-2 flex-wrap mb-4">
                        @for (int i = 0; i < galleryImages.Count; i++)
                        {
                            <button type="button" class="p-0 border rounded-3 overflow-hidden bg-white gallery-thumb"
                                    data-bs-target="#roomGalleryCarousel" data-bs-slide-to="@i" aria-label="Ảnh @(i + 1)">
                                <img src="@galleryImages[i]" alt="Ảnh @(i + 1)" style="width:88px;height:64px;object-fit:cover;">
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="rounded-4 overflow-hidden mb-4 shadow-sm detail-hero-img">
                    <img src="https://placehold.co/900x420/e2e8f0/64748b?text=Ảnh+phòng"
                         alt="@room.RoomName" class="w-100" style="height:420px;object-fit:cover;" />
                </div>
            }

            @* ── Tiêu đề + badges ── *@
            <div class="d-flex flex-wrap align-items-start gap-2 mb-1">
                <span class="badge @(room.Status == RoomStatus.Available ? "bg-success" : "bg-secondary") rounded-pill px-3">
                    @(room.Status == RoomStatus.Available ? "Còn trống" : "Đã thuê")
                </span>
                <span class="badge bg-light text-dark border rounded-pill px-3">@room.RoomCode</span>
                @if (room.RoomType != null)
                {
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3">
                        @room.RoomType.RoomTypeName
                    </span>
                }
                @* ── Số sao đánh giá trung bình ── *@
                @if (rCount > 0)
                {
                    <span class="badge bg-warning text-dark rounded-pill px-3 d-flex align-items-center gap-1">
                        <i class="bi bi-star-fill"></i>
                        @avg.ToString("0.0") <span class="fw-normal">(@rCount đánh giá)</span>
                    </span>
                }
            </div>
            <h1 class="fw-bold fs-3 mb-4">@room.RoomName</h1>

            @* ── Thông số nhanh ── *@
            <div class="row g-3 mb-4">
                @{
                    var specs = new[]
                    {
                        (Icon:"bi-rulers",           Color:"text-primary",  Label:"Diện tích",       Value:$"{room.Area} m²"),
                        (Icon:"bi-building",         Color:"text-info",     Label:"Tầng",            Value:$"Tầng {room.Floor}"),
                        (Icon:"bi-people-fill",      Color:"text-success",  Label:"Số người tối đa", Value:$"{room.MaxOccupants} người"),
                        (Icon:"bi-shield-lock-fill", Color:"text-warning",  Label:"Tiền đặt cọc",    Value:room.DefaultDeposit.ToString("N0") + " đ"),
                    };
                }
                @foreach (var spec in specs)
                {
                    <div class="col-6 col-sm-3">
                        <div class="border rounded-4 p-3 text-center h-100 bg-white shadow-sm">
                            <i class="bi @spec.Icon @spec.Color fs-4 d-block mb-1"></i>
                            <div class="text-secondary" style="font-size:.78rem;">@spec.Label</div>
                            <div class="fw-semibold text-dark small">@spec.Value</div>
                        </div>
                    </div>
                }
            </div>

            @if (amenityItems.Any())
            {
                <div class="mb-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-box-seam text-primary"></i> Vật dụng có sẵn
                    </h5>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var item in amenityItems)
                        {
                            <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                                <i class="bi bi-check2 text-success me-1"></i>@item
                            </span>
                        }
                    </div>
                </div>
                <hr class="my-4">
            }

            @* ── Mô tả chi tiết ── *@
            @if (!string.IsNullOrWhiteSpace(room.Description))
            {
                <div class="mb-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-card-text text-primary"></i> Mô tả phòng
                    </h5>
                    <div class="text-secondary lh-lg" style="white-space:pre-wrap;">@room.Description</div>
                </div>
                <hr class="my-4">
            }

            @* ── Bảng dịch vụ hàng tháng ── *@
            <div class="mb-4">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-receipt text-primary"></i> Phí dịch vụ hàng tháng
                </h5>

                @if (!Model.Services.Any())
                {
                    <p class="text-muted small fst-italic">Chưa có thông tin dịch vụ.</p>
                }
                else
                {
                    <div class="table-responsive rounded-4 border shadow-sm">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Dịch vụ</th>
                                    <th>Cách tính</th>
                                    <th class="text-end pe-3">Đơn giá</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var svc in Model.Services)
                                {
                                    var svcIcon = svc.ServiceType switch {
                                        ServiceType.Electric => "bi-lightning-charge-fill",
                                        ServiceType.Water    => "bi-droplet-fill",
                                        ServiceType.Garbage  => "bi-trash3-fill",
                                        ServiceType.Wifi     => "bi-wifi",
                                        ServiceType.Parking  => "bi-bicycle",
                                        _                    => "bi-gear-fill"
                                    };
                                    var svcColor = svc.ServiceType switch {
                                        ServiceType.Electric => "text-warning",
                                        ServiceType.Water    => "text-info",
                                        ServiceType.Wifi     => "text-purple",
                                        ServiceType.Parking  => "text-success",
                                        _                    => "text-secondary"
                                    };
                                    <tr>
                                        <td class="ps-3">
                                            <i class="bi @svcIcon @svcColor me-2 fs-5"></i>
                                            <span class="fw-medium">@svc.ServiceName</span>
                                            @if (!string.IsNullOrEmpty(svc.Description))
                                            {
                                                <div class="text-muted" style="font-size:.78rem;">@svc.Description</div>
                                            }
                                        </td>
                                        <td>
                                            @if (svc.PricingMethod == PricingMethod.PerUnit)
                                            {
                                                <span class="badge bg-info-subtle text-info rounded-pill">Theo tiêu thụ</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary rounded-pill">Cố định/tháng</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3 fw-semibold text-primary">
                                            @svc.UnitPrice.ToString("N0") đ
                                            @if (!string.IsNullOrEmpty(svc.Unit))
                                            {
                                                <span class="text-muted fw-normal small">/@svc.Unit</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="text-muted small mt-2 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Điện/nước tính theo chỉ số thực tế hàng tháng. Các phí cố định thu vào ngày lập hóa đơn.
                    </p>
                }
            </div>

            @* ════════════ ĐÁNH GIÁ PHÒNG ════════════ *@
            <div class="mb-4" id="room-reviews">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-star-half text-warning"></i> Đánh giá phòng
                    @if (rCount > 0)
                    {
                        <span class="ms-1 text-muted fw-normal" style="font-size:.85rem;">
                            — trung bình
                            @for (int s = 1; s <= 5; s++)
                            {
                                if (s <= Math.Floor(avg))
                                {
                                    <i class="bi bi-star-fill text-warning" style="font-size:.85rem;"></i>
                                }
                                else if (s - avg < 1 && avg % 1 >= 0.5)
                                {
                                    <i class="bi bi-star-half text-warning" style="font-size:.85rem;"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-warning" style="font-size:.85rem;"></i>
                                }
                            }
                            <strong class="text-dark ms-1">@avg.ToString("0.0")</strong> / 5
                            &nbsp;(@rCount nhận xét)
                        </span>
                    }
                </h5>

                @* ── Danh sách đánh giá ── *@
                @if (!Model.RoomReviews.Any())
                {
                    <p class="text-muted small fst-italic">
                        <i class="bi bi-chat-square-dots me-1"></i>Chưa có đánh giá nào. Hãy là người đầu tiên!
                    </p>
                }
                else
                {
                    <div class="review-list mb-4">
                        @foreach (var rv in Model.RoomReviews)
                        {
                            <div class="review-card d-flex gap-3 py-3 border-bottom">
                                <div class="review-avatar flex-shrink-0 rounded-circle bg-success-subtle d-flex align-items-center justify-content-center"
                                     style="width:44px;height:44px;">
                                    <span class="fw-bold text-success" style="font-size:1.1rem;">
                                        @rv.FullName.Substring(0, 1).ToUpper()
                                    </span>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                        <span class="fw-semibold text-dark">@rv.FullName</span>
                                        <span class="ms-auto text-muted small">
                                            <i class="bi bi-clock me-1"></i>@rv.CreatedAt.ToString("dd/MM/yyyy")
                                        </span>
                                    </div>
                                    <div class="mb-1">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            <i class="bi @(s <= rv.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")" style="font-size:.8rem;"></i>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(rv.Comment))
                                    {
                                        <p class="text-secondary small mb-0">@rv.Comment</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @* ── Form gửi / sửa đánh giá ── *@
                @if (isLoggedIn)
                {
                    var isEdit = Model.MyReview != null;
                    var formAction = isEdit ? "UpdateRoomReview" : "SubmitRoomReview";
                    var formTitle  = isEdit ? "Sửa đánh giá của bạn" : "Gửi đánh giá của bạn";
                    var formIcon   = isEdit ? "bi-pencil" : "bi-pencil-square";
                    var btnText    = isEdit ? "Cập nhật đánh giá" : "Gửi đánh giá";
                    var prefillComment = isEdit ? Model.MyReview!.Comment : "";
                    var prefillRating  = isEdit ? Model.MyReview!.Rating : 5;
                    var prefillName2   = isEdit ? Model.MyReview!.FullName : Model.ReviewName;

                    <div class="card border-0 @(isEdit ? "bg-warning-subtle" : "bg-light") rounded-4 p-4">
                        <h6 class="fw-bold mb-3 d-flex align-items-center gap-2">
                            <i class="bi @formIcon text-primary"></i> @formTitle
                        </h6>
                        <form asp-controller="Home" asp-action="@formAction" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="roomId" value="@room.RoomId" />
                            @if (isEdit)
                            {
                                <input type="hidden" name="reviewId" value="@Model.MyReview!.RoomReviewId" />
                            }

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Họ và tên <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input type="text" name="reviewName" class="form-control"
                                           placeholder="Nguyễn Văn A"
                                           value="@prefillName2" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Số sao đánh giá <span class="text-danger">*</span></label>
                                <div class="star-picker d-flex gap-2" id="starPicker">
                                    @for (int s = 5; s >= 1; s--)
                                    {
                                        <input type="radio" class="d-none star-radio" name="reviewRating"
                                               id="star@(s)" value="@s" @(s == prefillRating ? "checked" : "") />
                                        <label for="star@(s)" class="star-label" title="@s sao">
                                            <i class="bi bi-star-fill"></i>
                                        </label>
                                    }
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Nhận xét (tùy chọn)</label>
                                <textarea name="reviewComment" class="form-control" rows="3"
                                          placeholder="Chia sẻ trải nghiệm của bạn về phòng...">@prefillComment</textarea>
                            </div>

                            <button type="submit" class="btn btn-primary fw-semibold rounded-3">
                                <i class="bi @(isEdit ? "bi-check-lg" : "bi-send") me-1"></i> @btnText
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="alert alert-light border rounded-4 text-center small py-3">
                        <i class="bi bi-lock me-1 text-warning"></i>
                        <a href="#" onclick="openGuestLogin(event)" class="fw-semibold">Đăng nhập</a>
                        để gửi đánh giá của bạn về phòng này.
                    </div>
                }
            </div>

        </div>

        @* ══════════════ RIGHT — Sidebar giá & đặt lịch ══════════════ *@
        <div class="col-lg-4">
            <div class="sticky-sidebar">

                @* ── Thẻ giá ── *@
                <div class="card border-0 shadow rounded-4 mb-3">
                    <div class="card-body p-4">

                        <div class="d-flex align-items-baseline gap-1 mb-1">
                            <span class="text-primary fw-bolder" style="font-size:2rem;">
                                @room.RoomPrice.ToString("N0")
                            </span>
                            <span class="text-muted">đ</span>
                            <span class="text-secondary small">/ tháng</span>
                        </div>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-shield-check me-1 text-warning"></i>
                            Đặt cọc: <strong>@room.DefaultDeposit.ToString("N0") đ</strong>
                        </p>

                        <hr class="my-3">

                        @* Quick info *@
                        <ul class="list-unstyled text-secondary small mb-4">
                            <li class="d-flex justify-content-between py-1 border-bottom">
                                <span><i class="bi bi-house me-2 text-primary"></i>Loại phòng</span>
                                <strong class="text-dark">@(room.RoomType?.RoomTypeName ?? "—")</strong>
                            </li>
                            <li class="d-flex justify-content-between py-1 border-bottom">
                                <span><i class="bi bi-rulers me-2 text-primary"></i>Diện tích</span>
                                <strong class="text-dark">@room.Area m²</strong>
                            </li>
                            <li class="d-flex justify-content-between py-1 border-bottom">
                                <span><i class="bi bi-building me-2 text-primary"></i>Tầng</span>
                                <strong class="text-dark">@room.Floor</strong>
                            </li>
                            <li class="d-flex justify-content-between py-1">
                                <span><i class="bi bi-people me-2 text-primary"></i>Số người tối đa</span>
                                <strong class="text-dark">@room.MaxOccupants người</strong>
                            </li>
                        </ul>

                        @* Nút đặt lịch *@
                        @if (isLoggedIn)
                        {
                            <button type="button"
                                    class="btn btn-primary btn-lg w-100 fw-semibold rounded-3"
                                    data-bs-toggle="modal" data-bs-target="#bookingModal">
                                <i class="bi bi-calendar-plus me-2"></i>Đặt lịch xem phòng
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-primary btn-lg w-100 fw-semibold rounded-3"
                                    onclick="openGuestLogin(event)">
                                <i class="bi bi-person-lock me-2"></i>Đăng nhập để đặt lịch
                            </button>
                            <p class="text-center text-muted small mt-2 mb-0">
                                Chưa có tài khoản?
                                <a href="#" onclick="openGuestLogin(event, 'register')">
                                    Đăng ký ngay
                                </a>
                            </p>
                        }

                    </div>
                </div>

                @* ── Thông tin liên hệ ── *@
                <div class="card border-0 shadow-sm rounded-4 bg-primary-subtle">
                    <div class="card-body p-3">
                        <p class="fw-semibold text-primary mb-2">
                            <i class="bi bi-person-circle me-1"></i> Thông tin chủ phòng
                        </p>
                        <p class="text-secondary small mb-1">
                            <i class="bi bi-telephone me-1"></i> 0xxx xxx xxx
                        </p>
                        <p class="text-secondary small mb-0">
                            <i class="bi bi-clock me-1"></i> Hỗ trợ: 7:00 – 21:00 hàng ngày
                        </p>
                    </div>
                </div>

            </div>
        </div>

    </div><!-- /row -->

</div>
</section>

@* ════════════════════  MODAL ĐẶT LỊCH XEM  ════════════════════ *@
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
        <div class="modal-content rounded-4 border-0 shadow-lg">

            <div class="modal-header border-0 px-4 pt-4 pb-2">
                <div>
                    <h5 class="modal-title fw-bold" id="bookingModalLabel">
                        <i class="bi bi-calendar-check text-primary me-2"></i>Đặt lịch xem phòng
                    </h5>
                    <p class="text-muted small mb-0">@room.RoomName — @room.RoomCode</p>
                </div>
                <button type="button" class="btn-close ms-3" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body px-4 pb-4">
                <form asp-controller="Home" asp-action="BookViewing" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="roomId" value="@room.RoomId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Họ và tên <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" name="bookingName" class="form-control"
                                   placeholder="Nguyễn Văn A"
                                   value="@preName" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Số điện thoại <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input type="tel" name="bookingPhone" class="form-control"
                                   placeholder="0xxx xxx xxx"
                                   value="@prePhone" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ngày muốn xem phòng</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                            <input type="date" name="bookingDate" class="form-control"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Ghi chú thêm</label>
                        <textarea name="bookingNote" class="form-control" rows="2"
                                  placeholder="Ví dụ: buổi sáng, sau 17h, cuối tuần..."></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold rounded-3">
                            <i class="bi bi-send me-1"></i> Gửi yêu cầu đặt lịch
                        </button>
                        <button type="button" class="btn btn-outline-secondary rounded-3"
                                data-bs-dismiss="modal">Huỷ</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<style>
    .sticky-sidebar { position: sticky; top: 80px; }
    .text-purple { color: #7c3aed; }

    /* Override Bootstrap primary color to green */
    .btn-primary {
        background-color: #27AE60;
        border-color: #27AE60;
    }
    .btn-primary:hover {
        background-color: #1E8449;
        border-color: #1E8449;
    }
    .btn-primary:focus,
    .btn-primary.focus {
        background-color: #1E8449;
        border-color: #1E8449;
        box-shadow: 0 0 0 0.25rem rgba(39, 174, 96, 0.5);
    }
    .btn-primary:active,
    .btn-primary.active {
        background-color: #1E8449;
        border-color: #1E8449;
    }
    .btn-primary:disabled,
    .btn-primary.disabled {
        background-color: #27AE60;
        border-color: #27AE60;
    }

    .badge.bg-primary-subtle {
        background-color: #E8F8F5 !important;
        color: #27AE60 !important;
    }

    .text-primary {
        color: #27AE60 !important;
    }

    /* ── Star Picker (form đánh giá phòng) ── */
    .star-picker {
        flex-direction: row-reverse;
        justify-content: flex-end;
    }
    .star-label {
        font-size: 1.6rem;
        color: #d1d5db;
        cursor: pointer;
        transition: color .15s;
        line-height: 1;
    }
    /* Tô màu sao đang hover và tất cả sao trước nó (nhờ RTL + ~ selector) */
    .star-label:hover,
    .star-label:hover ~ .star-label {
        color: #f59e0b;
    }
    /* Tô màu sao đã chọn */
    .star-radio:checked + .star-label,
    .star-radio:checked + .star-label ~ .star-label {
        color: #f59e0b;
    }
    /* Review card hover */
    .review-card {
        transition: background .15s;
        border-radius: .5rem;
        padding-left: .5rem;
        padding-right: .5rem;
    }
    .review-card:hover {
        background: #f0fdf4;
    }
</style>

<script>
    @if (hasAlert || hasReviewMsg)
    {
        <text>window.scrollTo({ top: 0, behavior: 'smooth' });</text>
    }

    // Scroll to review section after submitting
    @if (hasReviewMsg)
    {
        <text>
        window.addEventListener('DOMContentLoaded', function () {
            var sec = document.getElementById('room-reviews');
            if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        </text>
    }

    async function openGuestLogin(event, tab) {
        if (event) event.preventDefault();

        try {
            await fetch('/Account/ClearAdminSession', { method: 'POST' });
        } catch {
            // Nếu request lỗi, vẫn mở modal để người dùng có thể đăng nhập lại.
        }

        var retInput = document.getElementById('loginReturnUrl');
        if (retInput) retInput.value = window.location.pathname + window.location.search;

        if (tab === 'register' && typeof authSwitchTab === 'function') {
            authSwitchTab('register');
        } else if (typeof authSwitchTab === 'function') {
            authSwitchTab('login');
        }

        new bootstrap.Modal(document.getElementById('authModal')).show();
    }
</script>
}
