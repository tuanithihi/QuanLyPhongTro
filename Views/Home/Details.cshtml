@model RoomDetailViewModel
@using QuanLyPhongTro.Models
@{
    ViewData["Title"] = Model.Room.RoomName;
    var room        = Model.Room;
    bool hasAlert   = TempData["BookingSuccess"] != null || TempData["BookingError"] != null;
    bool isLoggedIn = ViewBag.IsLoggedIn ?? false;
    string preName  = ViewBag.BookingName  ?? "";
    string prePhone = ViewBag.BookingPhone ?? "";
}

@* ── Breadcrumb ─────────────────────────────────────────────────────── *@
<div class="bg-light border-bottom py-2">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                        <i class="bi bi-house me-1"></i>Trang chủ
                    </a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">@room.RoomName</li>
            </ol>
        </nav>
    </div>
</div>

@* ── Alerts TempData ─────────────────────────────────────────────────── *@
@if (TempData["BookingSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-0 rounded-0 text-center" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @Html.Raw(TempData["BookingSuccess"]!.ToString())
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["BookingError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-0 rounded-0 text-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["BookingError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ════════════════════════════ NỘI DUNG CHÍNH ════════════════════════════ *@
<section class="py-5">
<div class="container">

    <div class="row g-5 align-items-start">

        @* ══════════════ LEFT — Thông tin phòng ══════════════ *@
        <div class="col-lg-8">

            @* ── Ảnh phòng ── *@
            <div class="rounded-4 overflow-hidden mb-4 shadow-sm detail-hero-img"
                 style="max-height:420px;">
                <img src="@(string.IsNullOrEmpty(room.ThumbnailImage) ? "" : room.ThumbnailImage)"
                     alt="@room.RoomName"
                     class="w-100 h-100"
                     style="object-fit:cover; max-height:420px;"
                     onerror="this.src='https://placehold.co/900x420/e2e8f0/64748b?text=Ảnh+phòng'" />
            </div>

            @* ── Tiêu đề + badges ── *@
            <div class="d-flex flex-wrap align-items-start gap-2 mb-1">
                <span class="badge @(room.Status == RoomStatus.Available ? "bg-success" : "bg-secondary") rounded-pill px-3">
                    @(room.Status == RoomStatus.Available ? "Còn trống" : "Đã thuê")
                </span>
                <span class="badge bg-light text-dark border rounded-pill px-3">@room.RoomCode</span>
                @if (room.RoomType != null)
                {
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3">
                        @room.RoomType.RoomTypeName
                    </span>
                }
            </div>
            <h1 class="fw-bold fs-3 mb-4">@room.RoomName</h1>

            @* ── Thông số nhanh ── *@
            <div class="row g-3 mb-4">
                @{
                    var specs = new[]
                    {
                        (Icon:"bi-rulers",           Color:"text-primary",  Label:"Diện tích",       Value:$"{room.Area} m²"),
                        (Icon:"bi-building",         Color:"text-info",     Label:"Tầng",            Value:$"Tầng {room.Floor}"),
                        (Icon:"bi-people-fill",      Color:"text-success",  Label:"Số người tối đa", Value:$"{room.MaxOccupants} người"),
                        (Icon:"bi-shield-lock-fill", Color:"text-warning",  Label:"Tiền đặt cọc",    Value:room.DefaultDeposit.ToString("N0") + " đ"),
                    };
                }
                @foreach (var spec in specs)
                {
                    <div class="col-6 col-sm-3">
                        <div class="border rounded-4 p-3 text-center h-100 bg-white shadow-sm">
                            <i class="bi @spec.Icon @spec.Color fs-4 d-block mb-1"></i>
                            <div class="text-secondary" style="font-size:.78rem;">@spec.Label</div>
                            <div class="fw-semibold text-dark small">@spec.Value</div>
                        </div>
                    </div>
                }
            </div>

            @* ── Mô tả chi tiết ── *@
            @if (!string.IsNullOrWhiteSpace(room.Description))
            {
                <div class="mb-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-card-text text-primary"></i> Mô tả phòng
                    </h5>
                    <div class="text-secondary lh-lg" style="white-space:pre-wrap;">@room.Description</div>
                </div>
                <hr class="my-4">
            }

            @* ── Bảng dịch vụ hàng tháng ── *@
            <div class="mb-4">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-receipt text-primary"></i> Phí dịch vụ hàng tháng
                </h5>

                @if (!Model.Services.Any())
                {
                    <p class="text-muted small fst-italic">Chưa có thông tin dịch vụ.</p>
                }
                else
                {
                    <div class="table-responsive rounded-4 border shadow-sm">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Dịch vụ</th>
                                    <th>Cách tính</th>
                                    <th class="text-end pe-3">Đơn giá</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var svc in Model.Services)
                                {
                                    var svcIcon = svc.ServiceType switch {
                                        ServiceType.Electric => "bi-lightning-charge-fill",
                                        ServiceType.Water    => "bi-droplet-fill",
                                        ServiceType.Garbage  => "bi-trash3-fill",
                                        ServiceType.Wifi     => "bi-wifi",
                                        ServiceType.Parking  => "bi-bicycle",
                                        _                    => "bi-gear-fill"
                                    };
                                    var svcColor = svc.ServiceType switch {
                                        ServiceType.Electric => "text-warning",
                                        ServiceType.Water    => "text-info",
                                        ServiceType.Wifi     => "text-purple",
                                        ServiceType.Parking  => "text-success",
                                        _                    => "text-secondary"
                                    };
                                    <tr>
                                        <td class="ps-3">
                                            <i class="bi @svcIcon @svcColor me-2 fs-5"></i>
                                            <span class="fw-medium">@svc.ServiceName</span>
                                            @if (!string.IsNullOrEmpty(svc.Description))
                                            {
                                                <div class="text-muted" style="font-size:.78rem;">@svc.Description</div>
                                            }
                                        </td>
                                        <td>
                                            @if (svc.PricingMethod == PricingMethod.PerUnit)
                                            {
                                                <span class="badge bg-info-subtle text-info rounded-pill">Theo tiêu thụ</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary rounded-pill">Cố định/tháng</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3 fw-semibold text-primary">
                                            @svc.UnitPrice.ToString("N0") đ
                                            @if (!string.IsNullOrEmpty(svc.Unit))
                                            {
                                                <span class="text-muted fw-normal small">/@svc.Unit</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="text-muted small mt-2 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Điện/nước tính theo chỉ số thực tế hàng tháng. Các phí cố định thu vào ngày lập hóa đơn.
                    </p>
                }
            </div>

        </div>

        @* ══════════════ RIGHT — Sidebar giá & đặt lịch ══════════════ *@
        <div class="col-lg-4">
            <div class="sticky-sidebar">

                @* ── Thẻ giá ── *@
                <div class="card border-0 shadow rounded-4 mb-3">
                    <div class="card-body p-4">

                        <div class="d-flex align-items-baseline gap-1 mb-1">
                            <span class="text-primary fw-bolder" style="font-size:2rem;">
                                @room.RoomPrice.ToString("N0")
                            </span>
                            <span class="text-muted">đ</span>
                            <span class="text-secondary small">/ tháng</span>
                        </div>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-shield-check me-1 text-warning"></i>
                            Đặt cọc: <strong>@room.DefaultDeposit.ToString("N0") đ</strong>
                        </p>

                        <hr class="my-3">

                        @* Quick info *@
                        <ul class="list-unstyled text-secondary small mb-4">
                            <li class="d-flex justify-content-between py-1 border-bottom">
                                <span><i class="bi bi-house me-2 text-primary"></i>Loại phòng</span>
                                <strong class="text-dark">@(room.RoomType?.RoomTypeName ?? "—")</strong>
                            </li>
                            <li class="d-flex justify-content-between py-1 border-bottom">
                                <span><i class="bi bi-rulers me-2 text-primary"></i>Diện tích</span>
                                <strong class="text-dark">@room.Area m²</strong>
                            </li>
                            <li class="d-flex justify-content-between py-1 border-bottom">
                                <span><i class="bi bi-building me-2 text-primary"></i>Tầng</span>
                                <strong class="text-dark">@room.Floor</strong>
                            </li>
                            <li class="d-flex justify-content-between py-1">
                                <span><i class="bi bi-people me-2 text-primary"></i>Số người tối đa</span>
                                <strong class="text-dark">@room.MaxOccupants người</strong>
                            </li>
                        </ul>

                        @* Nút đặt lịch *@
                        @if (isLoggedIn)
                        {
                            <button type="button"
                                    class="btn btn-primary btn-lg w-100 fw-semibold rounded-3"
                                    data-bs-toggle="modal" data-bs-target="#bookingModal">
                                <i class="bi bi-calendar-plus me-2"></i>Đặt lịch xem phòng
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-primary btn-lg w-100 fw-semibold rounded-3"
                                    onclick="openLoginForBooking()">
                                <i class="bi bi-person-lock me-2"></i>Đăng nhập để đặt lịch
                            </button>
                            <p class="text-center text-muted small mt-2 mb-0">
                                Chưa có tài khoản?
                                <a href="#" data-bs-toggle="modal" data-bs-target="#authModal" data-open-tab="register">
                                    Đăng ký ngay
                                </a>
                            </p>
                        }

                    </div>
                </div>

                @* ── Thông tin liên hệ ── *@
                <div class="card border-0 shadow-sm rounded-4 bg-primary-subtle">
                    <div class="card-body p-3">
                        <p class="fw-semibold text-primary mb-2">
                            <i class="bi bi-person-circle me-1"></i> Thông tin chủ phòng
                        </p>
                        <p class="text-secondary small mb-1">
                            <i class="bi bi-telephone me-1"></i> 0xxx xxx xxx
                        </p>
                        <p class="text-secondary small mb-0">
                            <i class="bi bi-clock me-1"></i> Hỗ trợ: 7:00 – 21:00 hàng ngày
                        </p>
                    </div>
                </div>

            </div>
        </div>

    </div><!-- /row -->

</div>
</section>

@* ════════════════════  MODAL ĐẶT LỊCH XEM  ════════════════════ *@
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
        <div class="modal-content rounded-4 border-0 shadow-lg">

            <div class="modal-header border-0 px-4 pt-4 pb-2">
                <div>
                    <h5 class="modal-title fw-bold" id="bookingModalLabel">
                        <i class="bi bi-calendar-check text-primary me-2"></i>Đặt lịch xem phòng
                    </h5>
                    <p class="text-muted small mb-0">@room.RoomName — @room.RoomCode</p>
                </div>
                <button type="button" class="btn-close ms-3" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body px-4 pb-4">
                <form asp-controller="Home" asp-action="BookViewing" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="roomId" value="@room.RoomId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Họ và tên <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" name="bookingName" class="form-control"
                                   placeholder="Nguyễn Văn A"
                                   value="@preName" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Số điện thoại <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input type="tel" name="bookingPhone" class="form-control"
                                   placeholder="0xxx xxx xxx"
                                   value="@prePhone" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ngày muốn xem phòng</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                            <input type="date" name="bookingDate" class="form-control"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Ghi chú thêm</label>
                        <textarea name="bookingNote" class="form-control" rows="2"
                                  placeholder="Ví dụ: buổi sáng, sau 17h, cuối tuần..."></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold rounded-3">
                            <i class="bi bi-send me-1"></i> Gửi yêu cầu đặt lịch
                        </button>
                        <button type="button" class="btn btn-outline-secondary rounded-3"
                                data-bs-dismiss="modal">Huỷ</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<style>
    .sticky-sidebar { position: sticky; top: 80px; }
    .text-purple { color: #7c3aed; }

    /* Override Bootstrap primary color to green */
    .btn-primary {
        background-color: #27AE60;
        border-color: #27AE60;
    }
    .btn-primary:hover {
        background-color: #1E8449;
        border-color: #1E8449;
    }
    .btn-primary:focus,
    .btn-primary.focus {
        background-color: #1E8449;
        border-color: #1E8449;
        box-shadow: 0 0 0 0.25rem rgba(39, 174, 96, 0.5);
    }
    .btn-primary:active,
    .btn-primary.active {
        background-color: #1E8449;
        border-color: #1E8449;
    }
    .btn-primary:disabled,
    .btn-primary.disabled {
        background-color: #27AE60;
        border-color: #27AE60;
    }

    .badge.bg-primary-subtle {
        background-color: #E8F8F5 !important;
        color: #27AE60 !important;
    }

    .text-primary {
        color: #27AE60 !important;
    }
</style>

<script>
    @if (hasAlert)
    {
        <text>window.scrollTo({ top: 0, behavior: 'smooth' });</text>
    }

    function openLoginForBooking() {
        // Ghi returnUrl vào hidden field của login form trong authModal
        var retInput = document.getElementById('loginReturnUrl');
        if (retInput) retInput.value = window.location.pathname + window.location.search;
        new bootstrap.Modal(document.getElementById('authModal')).show();
    }
</script>
}
