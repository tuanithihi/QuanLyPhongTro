@model HomeIndexViewModel
@{
    ViewData["Title"] = "Phòng Trọ Mới - Nền tảng tìm kiếm và cho thuê phòng trọ uy tín";
    ViewData["Description"] = "Hàng ngàn phòng trọ, căn hộ mini, nhà nguyên căn được xác thực, thông tin giá cả, diện tích và dịch vụ minh bạch tại Việt Nam.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home.css" />
}

<!-- ════════════════════════════════════════════════════════════════
     1. HERO SEARCH SECTION (Batdongsan Style)
     ════════════════════════════════════════════════════════════════ -->
<section class="home-hero">
    <div class="container-xl">
        <div class="row justify-content-center">
            <div class="col-lg-11 col-xl-10">
                <div class="text-center mb-4">
                    <h1 class="home-hero-title">Kênh Thông Tin Phòng Trọ Số 1 Việt Nam</h1>
                    <p class="home-hero-subtitle">Tìm kiếm nhanh chóng, phòng trọ thật, giá thật, liên hệ trực tiếp chủ nhà</p>
                </div>

                <!-- Search Card -->
                <div class="search-box-card">
                    <ul class="search-box-tabs">
                        <li>
                            <button type="button" class="search-tab-btn active" data-type-name="Tất cả">
                                <i class="bi bi-houses me-1"></i>Cho thuê phòng trọ
                            </button>
                        </li>
                        <li>
                            <button type="button" class="search-tab-btn" data-type-name="Căn hộ mini">
                                <i class="bi bi-building me-1"></i>Căn hộ mini / Studio
                            </button>
                        </li>
                        <li>
                            <button type="button" class="search-tab-btn" data-type-name="Nhà nguyên căn">
                                <i class="bi bi-house-door me-1"></i>Nhà nguyên căn
                            </button>
                        </li>
                    </ul>

                    <form action="/phong-tro" method="get" id="heroSearchForm">
                        <div class="search-inputs-grid">
                            <!-- Keyword / Area -->
                            <div>
                                <label class="form-label"><i class="bi bi-geo-alt me-1 text-danger"></i>Khu vực / Tên đường</label>
                                <input type="text" name="Keyword" class="form-control" 
                                       placeholder="Nhập quận, huyện, tên đường hoặc địa điểm..." 
                                       autocomplete="off" />
                            </div>

                            <!-- Province -->
                            <div>
                                <label class="form-label"><i class="bi bi-map me-1 text-primary"></i>Tỉnh / Thành</label>
                                <select name="ProvinceId" id="heroProvinceSelect" class="form-select">
                                    <option value="">Tất cả Tỉnh/Thành</option>
                                    @if (Model.PopularProvinces != null)
                                    {
                                        foreach (var prov in Model.PopularProvinces)
                                        {
                                            <option value="@prov.ProvinceId">@prov.Name</option>
                                        }
                                    }
                                </select>
                            </div>

                            <!-- Price Range -->
                            <div>
                                <label class="form-label"><i class="bi bi-cash-coin me-1 text-success"></i>Khoảng giá</label>
                                <select id="heroPriceSelect" class="form-select">
                                    <option value="" data-min="" data-max="">Tất cả mức giá</option>
                                    <option value="1" data-min="0" data-max="2000000">Dưới 2 triệu</option>
                                    <option value="2" data-min="2000000" data-max="3500000">2 - 3.5 triệu</option>
                                    <option value="3" data-min="3500000" data-max="5000000">3.5 - 5 triệu</option>
                                    <option value="4" data-min="5000000" data-max="8000000">5 - 8 triệu</option>
                                    <option value="5" data-min="8000000" data-max="">Trên 8 triệu</option>
                                </select>
                                <input type="hidden" name="MinPrice" id="heroMinPrice" />
                                <input type="hidden" name="MaxPrice" id="heroMaxPrice" />
                            </div>

                            <!-- Area Range -->
                            <div>
                                <label class="form-label"><i class="bi bi-aspect-ratio me-1 text-secondary"></i>Diện tích</label>
                                <select id="heroAreaSelect" class="form-select">
                                    <option value="" data-min="" data-max="">Tất cả diện tích</option>
                                    <option value="1" data-min="0" data-max="20">Dưới 20 m²</option>
                                    <option value="2" data-min="20" data-max="30">20 - 30 m²</option>
                                    <option value="3" data-min="30" data-max="45">30 - 45 m²</option>
                                    <option value="4" data-min="45" data-max="">Trên 45 m²</option>
                                </select>
                                <input type="hidden" name="MinArea" id="heroMinArea" />
                                <input type="hidden" name="MaxArea" id="heroMaxArea" />
                            </div>

                            <!-- Submit Button -->
                            <div>
                                <button type="submit" class="btn btn-brand w-100" style="height:38px;">
                                    <i class="bi bi-search"></i>
                                    <span>Tìm kiếm</span>
                                </button>
                            </div>
                        </div>

                        <!-- Quick Tags -->
                        <div class="search-quick-tags">
                            <span class="quick-tag-label">Gợi ý tìm nhanh:</span>
                            <a href="/phong-tro/ha-noi" class="quick-tag-link">Hà Nội</a>
                            <a href="/phong-tro/ho-chi-minh" class="quick-tag-link">TP. Hồ Chí Minh</a>
                            <a href="/phong-tro/da-nang" class="quick-tag-link">Đà Nẵng</a>
                            <a href="/phong-tro/nghe-an" class="quick-tag-link">Nghệ An</a>
                            <a href="/phong-tro?maxPrice=3000000" class="quick-tag-link">Giá dưới 3 triệu</a>
                            <a href="/phong-tro?minPrice=3000000&maxPrice=5000000" class="quick-tag-link">Từ 3 - 5 triệu</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     2. FEATURED AREAS (Khu vực nổi bật)
     ════════════════════════════════════════════════════════════════ -->
<section class="py-5 bg-white border-bottom">
    <div class="container-xl">
        <div class="section-header">
            <div>
                <h2 class="section-title">Khu vực phòng trọ nổi bật</h2>
                <p class="section-subtitle">Lựa chọn khu vực tập trung đông trường đại học, khu công nghiệp và tiện ích</p>
            </div>
            <a href="/phong-tro" class="section-view-all">
                Xem tất cả tỉnh thành <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-3">
            <div class="col-6 col-md-4 col-lg-2">
                <a href="/phong-tro/ha-noi" class="location-card">
                    <div class="location-card-content">
                        <div class="location-card-name">Hà Nội</div>
                        <div class="location-card-count">Cầu Giấy, Đống Đa, Bách Khoa...</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a href="/phong-tro/ho-chi-minh" class="location-card">
                    <div class="location-card-content">
                        <div class="location-card-name">TP. Hồ Chí Minh</div>
                        <div class="location-card-count">Bình Thạnh, Quận 7, Thủ Đức...</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a href="/phong-tro/da-nang" class="location-card">
                    <div class="location-card-content">
                        <div class="location-card-name">Đà Nẵng</div>
                        <div class="location-card-count">Hải Châu, Ngũ Hành Sơn, Cẩm Lệ...</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a href="/phong-tro/nghe-an" class="location-card">
                    <div class="location-card-content">
                        <div class="location-card-name">Nghệ An</div>
                        <div class="location-card-count">TP. Vinh, Lê Viết Thuật, Bến Thủy...</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a href="/phong-tro/can-tho" class="location-card">
                    <div class="location-card-content">
                        <div class="location-card-name">Cần Thơ</div>
                        <div class="location-card-count">Ninh Kiều, Cái Răng, Bình Thủy...</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a href="/phong-tro/hai-phong" class="location-card">
                    <div class="location-card-content">
                        <div class="location-card-name">Hải Phòng</div>
                        <div class="location-card-count">Ngô Quyền, Lê Chân, Hải An...</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     3. FEATURED LISTINGS (Phòng trọ nổi bật)
     ════════════════════════════════════════════════════════════════ -->
<section class="py-5" style="background-color: var(--color-bg-page);">
    <div class="container-xl">
        <div class="section-header">
            <div>
                <h2 class="section-title">Phòng trọ xác thực nổi bật</h2>
                <p class="section-subtitle">Được kiểm tra đầy đủ tiện nghi, an ninh, phòng cháy chữa cháy</p>
            </div>
            <a href="/phong-tro" class="section-view-all">
                Xem thêm phòng nổi bật <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        @if (Model.FeaturedCardRooms != null && Model.FeaturedCardRooms.Any())
        {
            <div class="row g-4">
                @foreach (var room in Model.FeaturedCardRooms)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        @await Html.PartialAsync("_RoomCard", room)
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="bi bi-buildings"></i>
                </div>
                <div class="empty-state-title">Chưa có tin đăng nổi bật</div>
                <p class="empty-state-desc">Hãy quay lại sau hoặc sử dụng bộ lọc tìm kiếm để xem toàn bộ danh sách phòng hiện có.</p>
                <a href="/phong-tro" class="btn btn-brand">Xem danh sách phòng</a>
            </div>
        }
    </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     4. RECENT LISTINGS (Phòng mới đăng)
     ════════════════════════════════════════════════════════════════ -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container-xl">
        <div class="section-header">
            <div>
                <h2 class="section-title">Tin đăng phòng trọ mới nhất</h2>
                <p class="section-subtitle">Cập nhật liên tục từ các chủ nhà và quản lý khu trọ</p>
            </div>
            <a href="/phong-tro?sortBy=newest" class="section-view-all">
                Xem toàn bộ tin mới <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        @if (Model.RecentCardRooms != null && Model.RecentCardRooms.Any())
        {
            <div class="row g-4">
                @foreach (var room in Model.RecentCardRooms)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        @await Html.PartialAsync("_RoomCard", room)
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="bi bi-inbox"></i>
                </div>
                <div class="empty-state-title">Chưa có tin đăng mới</div>
                <p class="empty-state-desc">Hiện tại các phòng đang được rà soát phê duyệt. Vui lòng quay lại sau.</p>
            </div>
        }
    </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     5. VERIFIED LANDLORDS (Chủ trọ uy tín)
     ════════════════════════════════════════════════════════════════ -->
@if (Model.FeaturedLandlords != null && Model.FeaturedLandlords.Any())
{
    <section class="py-5" style="background-color: var(--color-bg-page);">
        <div class="container-xl">
            <div class="section-header">
                <div>
                    <h2 class="section-title">Chủ trọ uy tín được xác thực</h2>
                    <p class="section-subtitle">Chủ nhà có hồ sơ minh bạch, nhiều năm vận hành khu trọ chất lượng</p>
                </div>
            </div>

            <div class="row g-3">
                @foreach (var landlord in Model.FeaturedLandlords)
                {
                    string lSlug = QuanLyPhongTro.Services.SlugHelper.ToSlug(landlord.FullName);
                    <div class="col-12 col-md-6 col-lg-3">
                        <a href="/chu-tro/@lSlug" class="landlord-card">
                            @if (!string.IsNullOrEmpty(landlord.Avatar))
                            {
                                <img src="@landlord.Avatar" alt="@landlord.FullName" class="landlord-avatar-lg" />
                            }
                            else
                            {
                                <div class="landlord-avatar-lg d-flex align-items-center justify-content-center text-muted">
                                    <i class="bi bi-person-fill fs-3"></i>
                                </div>
                            }
                            <div class="flex-grow-1 min-w-0">
                                <div class="landlord-info-name text-truncate">@landlord.FullName</div>
                                <div class="landlord-info-meta">
                                    <span class="badge-status badge-status-verified">
                                        <i class="bi bi-patch-check-fill me-1"></i>Đã duyệt
                                    </span>
                                </div>
                                <div class="small text-muted mt-1">
                                    <i class="bi bi-buildings me-1"></i>@landlord.Properties.Count khu trọ
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ════════════════════════════════════════════════════════════════
     6. RENTING GUIDES (Kinh nghiệm thuê trọ thực tế - Không lorem ipsum)
     ════════════════════════════════════════════════════════════════ -->
<section class="py-5 bg-white border-top">
    <div class="container-xl">
        <div class="section-header">
            <div>
                <h2 class="section-title">Cẩm nang &amp; Kinh nghiệm thuê phòng trọ</h2>
                <p class="section-subtitle">Kiến thức pháp lý, hợp đồng đặt cọc và bí quyết chọn phòng chất lượng</p>
            </div>
            <a href="/Blog" class="section-view-all">
                Xem thêm bài viết <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-4">
                <div class="guide-card">
                    <div class="guide-card-body">
                        <span class="guide-card-tag">Pháp lý &amp; Hợp đồng</span>
                        <h3 class="guide-card-title">
                            <a href="/Blog">Những điều khoản bắt buộc phải có trong hợp đồng thuê phòng trọ</a>
                        </h3>
                        <p class="guide-card-excerpt">
                            Hướng dẫn kiểm tra tiền đặt cọc, thời hạn thông báo trả phòng, định mức đơn giá điện nước sinh hoạt và trách nhiệm sửa chữa trang thiết bị khi xảy ra hư hỏng.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="guide-card">
                    <div class="guide-card-body">
                        <span class="guide-card-tag">Cảnh báo lừa đảo</span>
                        <h3 class="guide-card-title">
                            <a href="/Blog">Nhận biết 5 chiêu trò lừa tiền cọc giữ phòng qua mạng xã hội</a>
                        </h3>
                        <p class="guide-card-excerpt">
                            Tuyệt đối không chuyển tiền cọc khi chưa xem phòng thực tế và chưa xác minh CCCD của chủ nhà hoặc giấy ủy quyền quản lý khu trọ hợp pháp.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="guide-card">
                    <div class="guide-card-body">
                        <span class="guide-card-tag">An toàn &amp; PCCC</span>
                        <h3 class="guide-card-title">
                            <a href="/Blog">Tiêu chuẩn kiểm tra an toàn phòng cháy chữa cháy khi đi thuê trọ</a>
                        </h3>
                        <p class="guide-card-excerpt">
                            Cách nhận biết lối thoát hiểm thứ hai, kiểm tra thiết bị báo khói, bình chữa cháy mini và hệ thống ngắt điện tự động tại khu nhà trọ nhiều tầng.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Price select sync
            var priceSelect = document.getElementById('heroPriceSelect');
            var minPrice = document.getElementById('heroMinPrice');
            var maxPrice = document.getElementById('heroMaxPrice');
            priceSelect.addEventListener('change', function () {
                var opt = this.options[this.selectedIndex];
                minPrice.value = opt.getAttribute('data-min') || '';
                maxPrice.value = opt.getAttribute('data-max') || '';
            });

            // Area select sync
            var areaSelect = document.getElementById('heroAreaSelect');
            var minArea = document.getElementById('heroMinArea');
            var maxArea = document.getElementById('heroMaxArea');
            areaSelect.addEventListener('change', function () {
                var opt = this.options[this.selectedIndex];
                minArea.value = opt.getAttribute('data-min') || '';
                maxArea.value = opt.getAttribute('data-max') || '';
            });
        });

        function toggleFavorite(roomId, btn) {
            btn.classList.toggle('active');
            var icon = btn.querySelector('i');
            if (btn.classList.contains('active')) {
                icon.className = 'bi bi-heart-fill text-danger';
            } else {
                icon.className = 'bi bi-heart';
            }
        }
    </script>
}
