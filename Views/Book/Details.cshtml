@model QuanLyThuVien.Models.tblBook

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Title ?? "Chi tiết sách";
}

<main class="main">
    <!-- Page Title -->
    <div class="page-title light-background">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Chi tiết sách</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li><a asp-controller="Book" asp-action="Index">Sách & Tài liệu</a></li>
                    <li class="current">Chi tiết</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->

    <section id="courses" class="courses section">
        <div class="container" data-aos="fade-up">
            <div class="row">
                <!-- Ảnh bìa và PDF -->
                <div class="col-lg-4 col-md-5 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            @if (!string.IsNullOrEmpty(Model.CoverImage))
                            {
                                <img src="@Model.CoverImage" alt="@Model.Title" 
                                     class="img-fluid rounded mb-3" 
                                     style="max-height: 400px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center rounded mb-3" 
                                     style="height: 400px;">
                                    <i class="bi bi-image text-muted" style="font-size: 5rem;"></i>
                                </div>
                            }
                            
                            <!-- Thông tin nhanh -->
                            <div class="mb-3">
                                <span class="badge bg-@(Model.Quantity > 0 ? "success" : "danger") fs-6 px-3 py-2">
                                    <i class="bi bi-@(Model.Quantity > 0 ? "check-circle" : "x-circle") me-1"></i>
                                    @(Model.Quantity > 0 ? $"Còn {Model.Quantity} cuốn" : "Hết sách")
                                </span>
                            </div>

                            <!-- Nút xem PDF và tải xuống -->
                            @if (!string.IsNullOrEmpty(Model.BookFile))
                            {
                                <div class="d-grid gap-2">
                                    <button type="button" class="btn btn-danger" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#pdfPreviewModal">
                                        <i class="bi bi-file-pdf me-1"></i>Xem trước PDF
                                    </button>
                                    <button type="button" class="btn btn-success" 
                                            onclick="openAiAnalysisModal()">
                                        <i class="bi bi-volume-up me-1"></i>AI Đọc văn bản PDF
                                    </button>
                                    <a href="@Model.BookFile" target="_blank" class="btn btn-outline-danger">
                                        <i class="bi bi-download me-1"></i>Tải xuống PDF
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Thông tin chi tiết -->
                <div class="col-lg-8 col-md-7">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h2 class="card-title mb-3">@Model.Title</h2>
                            
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <table class="table table-borderless">
                                        <tr>
                                            <th style="width: 150px;"><i class="bi bi-tags me-2"></i>Danh mục:</th>
                                            <td><span class="badge bg-info">@Model.Category?.CategoryName</span></td>
                                        </tr>
                                        <tr>
                                            <th><i class="bi bi-calendar me-2"></i>Năm xuất bản:</th>
                                            <td>@Model.PublishedYear</td>
                                        </tr>
                                        <tr>
                                            <th><i class="bi bi-building me-2"></i>Nhà xuất bản:</th>
                                            <td>@Model.Publisher?.PublisherName</td>
                                        </tr>
                                        <tr>
                                            <th><i class="bi bi-person me-2"></i>Tác giả:</th>
                                            <td>
                                                @if (Model.BookAuthors != null && Model.BookAuthors.Any())
                                                {
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach (var bookAuthor in Model.BookAuthors)
                                                        {
                                                            <span class="badge bg-secondary">@bookAuthor.Author?.AuthorName</span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Chưa có tác giả</span>
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <th><i class="bi bi-box me-2"></i>Số lượng:</th>
                                            <td>
                                                <span class="badge bg-@(Model.Quantity > 0 ? "success" : "danger")">
                                                    @(Model.Quantity > 0 ? $"{Model.Quantity} cuốn" : "Hết sách")
                                                </span>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                <div class="mb-4">
                                    <h5><i class="bi bi-file-text me-2"></i>Mô tả</h5>
                                    <p class="text-muted">@Model.Description</p>
                                </div>
                            }

                            <!-- Form mượn sách -->
                            @if (QuanLyThuVien.Utilities.Functions.IsLogin() && Model.Quantity > 0)
                            {
                                <div class="border-top pt-3">
                                    <h5 class="mb-3"><i class="bi bi-cart-plus me-2"></i>Mượn sách</h5>
                                    <form method="post" asp-controller="Book" asp-action="Index">
                                        @Html.AntiForgeryToken()
                                        <div class="row align-items-end">
                                            <div class="col-md-4">
                                                <label class="form-label">Số lượng muốn mượn:</label>
                                                <input type="number" name="quantity_@Model.BookID" 
                                                       class="form-control" min="1" max="@Model.Quantity" value="1" required>
                                                <input type="hidden" name="selectedBooks" value="@Model.BookID" />
                                            </div>
                                            <div class="col-md-8">
                                                <button type="submit" class="btn btn-primary w-100">
                                                    <i class="bi bi-cart-check me-1"></i>Xác nhận mượn sách
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            }
                            else if (!QuanLyThuVien.Utilities.Functions.IsLogin())
                            {
                                <div class="border-top pt-3">
                                    <div class="alert alert-info">
                                        <i class="bi bi-info-circle me-2"></i>
                                        Vui lòng <a asp-controller="Account" asp-action="Login" class="alert-link">đăng nhập</a> để mượn sách.
                                    </div>
                                </div>
                            }
                            else if (QuanLyThuVien.Utilities.Functions.IsLogin() && Model.Quantity <= 0)
                            {
                                <div class="border-top pt-3">
                                    <div class="alert alert-danger">
                                        <i class="bi bi-x-circle me-2"></i>
                                        <strong>Hết sách</strong> - Sách hiện đã hết trong kho, vui lòng quay lại sau.
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- AI Recommended Books Section -->
    @if (ViewBag.RelatedBooks != null && ((List<QuanLyThuVien.Models.tblBook>)ViewBag.RelatedBooks).Any())
    {
        <section id="related-books" class="related-books section light-background">
            <div class="container" data-aos="fade-up">
                <div class="section-header mb-4">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-robot me-2" style="font-size: 1.5rem; color: var(--accent-color);"></i>
                        <h4 class="mb-0">Gợi ý dành cho bạn</h4>
                    </div>
                    <p class="text-muted small mb-0">Các cuốn sách liên quan</p>
                </div>

                <div class="row g-3">
                    @foreach (var relatedBook in (List<QuanLyThuVien.Models.tblBook>)ViewBag.RelatedBooks)
                    {
                        <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="100">
                            <div class="related-book-card-compact h-100">
                                <a asp-controller="Book" asp-action="Details" asp-route-id="@relatedBook.BookID" class="text-decoration-none">
                                    <div class="book-image-compact position-relative">
                                        @if (!string.IsNullOrEmpty(relatedBook.CoverImage))
                                        {
                                            <img src="@relatedBook.CoverImage" alt="@relatedBook.Title" class="img-fluid">
                                        }
                                        else
                                        {
                                            <div class="no-image bg-light d-flex align-items-center justify-content-center">
                                                <i class="bi bi-book text-muted" style="font-size: 2rem;"></i>
                                            </div>
                                        }
                                        @if (relatedBook.Quantity > 0)
                                        {
                                            <span class="badge bg-success position-absolute top-0 end-0 m-1 small">
                                                <i class="bi bi-check"></i>
                                            </span>
                                        }
                                    </div>
                                    <div class="book-content-compact p-2">
                                        <div class="mb-1">
                                            <span class="badge bg-info" style="font-size: 0.7rem;">@relatedBook.Category?.CategoryName</span>
                                        </div>
                                        <h6 class="book-title-compact mb-1 fw-bold text-dark">@relatedBook.Title</h6>
                                        @if (relatedBook.BookAuthors != null && relatedBook.BookAuthors.Any())
                                        {
                                            <p class="book-author-compact text-muted mb-0">
                                                <i class="bi bi-person" style="font-size: 0.8rem;"></i>
                                                <small>@relatedBook.BookAuthors.FirstOrDefault()?.Author?.AuthorName</small>
                                            </p>
                                        }
                                    </div>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
</main>

<!-- Modal xem trước PDF -->
@if (!string.IsNullOrEmpty(Model.BookFile))
{
    <div class="modal fade" id="pdfPreviewModal" tabindex="-1" aria-labelledby="pdfPreviewModalLabel" aria-hidden="true" style="animation: none !important; transition: none !important;">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="pdfPreviewModalLabel">
                        <i class="bi bi-file-pdf me-2"></i>Xem trước: @Model.Title
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0" style="position: relative; overflow: hidden; height: 80vh; animation: none !important; transition: none !important;">
                    <iframe id="pdfIframeDetails" 
                            data-src="@Model.BookFile"
                            style="width: 100%; height: 100%; border: none; display: block; animation: none !important; transition: none !important;" 
                            frameborder="0"
                            allowfullscreen>
                    </iframe>
                </div>
                <div class="modal-footer bg-light">
                    <a href="@Model.BookFile" target="_blank" class="btn btn-danger">
                        <i class="bi bi-download me-1"></i>Tải xuống
                    </a>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- AI Analysis Modal -->
    <div class="modal fade" id="aiAnalysisModal" tabindex="-1" aria-labelledby="aiAnalysisModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="aiAnalysisModalLabel">
                        <i class="bi bi-volume-up me-2"></i>AI Đọc văn bản PDF: @Model.Title
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Text-to-Speech Controls -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số trang cần đọc:</label>
                        <select class="form-select" id="pagesCount">
                            <option value="5">5 trang đầu</option>
                            <option value="10" selected>10 trang đầu</option>
                            <option value="20">20 trang đầu</option>
                            <option value="0">Toàn bộ PDF</option>
                        </select>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2 mb-3">
                        <button type="button" class="btn btn-success" onclick="extractAndReadPdf()" id="readPdfBtn">
                            <i class="bi bi-volume-up me-1"></i>Trích xuất & Đọc văn bản
                        </button>
                        <button type="button" class="btn btn-warning d-none" onclick="stopReading()" id="stopPdfBtn">
                            <i class="bi bi-stop-circle me-1"></i>Dừng đọc
                        </button>
                    </div>

                    <!-- Loading Spinner -->
                    <div id="analysisLoading" class="text-center d-none my-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Đang phân tích...</span>
                        </div>
                        <p class="mt-2 text-muted">AI đang đọc và phân tích PDF... (có thể mất 10-30 giây)</p>
                    </div>

                    <!-- Result Container -->
                    <div id="analysisResult" class="mt-3" style="display: none;">
                        <div class="alert alert-info">
                            <h6 class="alert-heading fw-bold mb-2">
                                <i class="bi bi-info-circle me-1"></i>
                                <span id="resultTitle">Kết quả phân tích</span>
                            </h6>
                            <div id="resultContent" style="white-space: pre-wrap; max-height: 400px; overflow-y: auto;"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var bookId = @Model.BookID;

        document.addEventListener('DOMContentLoaded', function() {
            var pdfModal = document.getElementById('pdfPreviewModal');
            var iframe = document.getElementById('pdfIframeDetails');
            
            if (pdfModal) {
                // Tắt AOS hoàn toàn cho modal
                pdfModal.removeAttribute('data-aos');
                pdfModal.removeAttribute('data-aos-delay');
                pdfModal.removeAttribute('data-aos-duration');
                pdfModal.removeAttribute('data-aos-easing');
                
                // Thêm CSS để tắt animation
                pdfModal.style.animation = 'none !important';
                pdfModal.style.transition = 'none !important';
                
                // Disable AOS observer cho modal
                if (typeof AOS !== 'undefined') {
                    var aosElements = pdfModal.querySelectorAll('[data-aos]');
                    aosElements.forEach(function(el) {
                        el.removeAttribute('data-aos');
                    });
                }
            }
            
            if (pdfModal && iframe) {
                // Chỉ load PDF khi modal được mở (một lần duy nhất)
                pdfModal.addEventListener('show.bs.modal', function() {
                    if (!iframe.src || iframe.src === '') {
                        var pdfUrl = iframe.getAttribute('data-src');
                        if (pdfUrl) {
                            iframe.src = pdfUrl;
                        }
                    }
                });
            }
        });

        // AI Analysis Functions
        function openAiAnalysisModal() {
            var modal = new bootstrap.Modal(document.getElementById('aiAnalysisModal'));
            modal.show();
            // Reset UI
            document.getElementById('analysisResult').style.display = 'none';
            document.getElementById('readPdfBtn').classList.remove('d-none');
            document.getElementById('stopPdfBtn').classList.add('d-none');
            stopReading();
        }

        var currentUtterance = null;
        var isSpeaking = false;
        var speechSynthesis = window.speechSynthesis;

        function extractAndReadPdf() {
            var loadingEl = document.getElementById('analysisLoading');
            var resultEl = document.getElementById('analysisResult');
            var resultContent = document.getElementById('resultContent');
            var resultTitle = document.getElementById('resultTitle');
            var pagesCount = document.getElementById('pagesCount').value;
            var readBtn = document.getElementById('readPdfBtn');
            var stopBtn = document.getElementById('stopPdfBtn');

            loadingEl.classList.remove('d-none');
            resultEl.style.display = 'none';
            stopReading(); // Stop any current speech

            fetch('@Url.Action("ExtractPdfText", "Book")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({
                    bookId: bookId,
                    maxPages: parseInt(pagesCount)
                })
            })
            .then(response => response.json())
            .then(data => {
                loadingEl.classList.add('d-none');
                
                if (data.success) {
                    var pageText = pagesCount == 0 ? 'toàn bộ PDF' : pagesCount + ' trang đầu';
                    resultTitle.textContent = 'Văn bản trích xuất (' + pageText + ')';
                    resultContent.textContent = data.text;
                    resultEl.style.display = 'block';

                    // Detect language from text
                    var detectedLang = detectLanguage(data.text);
                    
                    // Chỉ dùng Web Speech API (không cần Google TTS)
                    useWebSpeechAPI(data.text, detectedLang, readBtn, stopBtn);
                } else {
                    resultTitle.textContent = 'Lỗi';
                    resultContent.textContent = data.message || 'Có lỗi xảy ra';
                    resultEl.style.display = 'block';
                }
            })
            .catch(error => {
                loadingEl.classList.add('d-none');
                resultTitle.textContent = 'Lỗi';
                resultContent.textContent = 'Lỗi kết nối: ' + error.message;
                resultEl.style.display = 'block';
            });
        }

        function detectLanguage(text) {
            console.log('🔍 Detecting language for text length:', text.length);
            
            // Simple language detection based on character patterns
            var sampleText = text.substring(0, 2000); // Check first 2000 chars for better accuracy
            
            // Count Vietnamese characters (with diacritics)
            var vietnamesePattern = /[àáạảãâầấậẩẫăằắặẳẵèéẹẻẽêềếệểễìíịỉĩòóọỏõôồốộổỗơờớợởỡùúụủũưừứựửữỳýỵỷỹđ]/gi;
            var vietnameseCount = (sampleText.match(vietnamesePattern) || []).length;
            
            console.log('Vietnamese diacritic characters:', vietnameseCount, '/', sampleText.length, '=', (vietnameseCount / sampleText.length * 100).toFixed(2) + '%');
            
            // If more than 2% of sample contains Vietnamese chars, it's Vietnamese
            if (vietnameseCount > sampleText.length * 0.02) {
                console.log('✅ Detected Vietnamese (by diacritics)');
                return 'vi-VN';
            }
            
            // Check for common Vietnamese words with word boundaries
            var vietnameseWords = [
                'của', 'và', 'là', 'có', 'trong', 'được', 'với', 'không', 'này', 'cho',
                'một', 'các', 'đã', 'người', 'năm', 'theo', 'để', 'những', 'từ', 'ngày',
                'tại', 'về', 'sau', 'khi', 'đến', 'sẽ', 'bằng', 'thành', 'trên', 'giữa'
            ];
            
            // Count Vietnamese words with word boundaries
            var vietnameseWordCount = 0;
            vietnameseWords.forEach(word => {
                var regex = new RegExp('\\b' + word + '\\b', 'gi');
                var matches = sampleText.match(regex);
                if (matches) vietnameseWordCount += matches.length;
            });
            
            console.log('Vietnamese word count:', vietnameseWordCount, '(threshold: 30)');
            
            if (vietnameseWordCount >= 30) {
                console.log('✅ Detected Vietnamese (by word count)');
                return 'vi-VN';
            }
            
            // Default to English
            console.log('✅ Detected English (default)');
            return 'en-US';
        }

        function readAloud(text, language, readBtn, stopBtn) {
            if (!text || text.trim() === '') {
                alert('Không có nội dung để đọc');
                return;
            }

            // Clean text for better speech quality
            var cleanText = text
                .replace(/--- Trang \d+ ---/g, '') // Remove page markers
                .replace(/\[.*?\]/g, '') // Remove brackets
                .replace(/https?:\/\/\S+/g, '') // Remove URLs
                .replace(/[\r\n]+/g, ' ') // Replace newlines with spaces
                .replace(/\s{2,}/g, ' ') // Remove multiple spaces
                .trim();
            
            // Try AI TTS first
            fetch('@Url.Action("TextToSpeech", "Book")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({
                    text: cleanText,
                    languageCode: language
                })
            })
            .then(response => {
                // Check if response is JSON (error/fallback) or audio file
                const contentType = response.headers.get('content-type');
                if (contentType && contentType.includes('application/json')) {
                    return response.json().then(data => {
                        if (data.useWebSpeech) {
                            // Fallback to Web Speech API
                            console.log('Using Web Speech API as fallback');
                            useWebSpeechAPI(cleanText, data.language || language, readBtn, stopBtn);
                        } else {
                            throw new Error(data.message || 'Lỗi không xác định');
                        }
                    });
                } else {
                    // Got audio file from AI TTS
                    return response.blob().then(blob => {
                        var audioUrl = URL.createObjectURL(blob);
                        var audio = new Audio(audioUrl);
                        
                        isSpeaking = true;
                        readBtn.classList.add('d-none');
                        stopBtn.classList.remove('d-none');
                        
                        var langText = language === 'vi-VN' ? 'Tiếng Việt' : 'English';
                        stopBtn.innerHTML = '<i class="bi bi-stop-circle me-1"></i>Dừng đọc (AI ' + langText + ')';
                        
                        audio.onended = function() {
                            isSpeaking = false;
                            readBtn.classList.remove('d-none');
                            stopBtn.classList.add('d-none');
                            URL.revokeObjectURL(audioUrl);
                        };
                        
                        audio.onerror = function() {
                            isSpeaking = false;
                            readBtn.classList.remove('d-none');
                            stopBtn.classList.add('d-none');
                            URL.revokeObjectURL(audioUrl);
                            alert('Lỗi phát audio');
                        };
                        
                        // Store audio reference for stopping
                        currentUtterance = audio;
                        audio.play();
                    });
                }
            })
            .catch(error => {
                console.error('AI TTS error, falling back to Web Speech API:', error);
                useWebSpeechAPI(cleanText, language, readBtn, stopBtn);
            });
        }

        function useWebSpeechAPI(text, language, readBtn, stopBtn) {
            console.log('🔊 Using Web Speech API - Language:', language, 'Text length:', text.length);
            
            // Chunk text if too long (Web Speech API has limits)
            const maxChunkSize = 4000;
            const chunks = [];
            
            if (text.length > maxChunkSize) {
                console.log('⚠️ Text too long, chunking into smaller pieces...');
                let remainingText = text;
                
                while (remainingText.length > 0) {
                    if (remainingText.length <= maxChunkSize) {
                        chunks.push(remainingText);
                        break;
                    }
                    
                    // Find a good break point (sentence end)
                    let chunkEnd = maxChunkSize;
                    const breakPoints = ['. ', '! ', '? ', '\n'];
                    
                    for (let i = maxChunkSize; i > maxChunkSize * 0.7; i--) {
                        if (breakPoints.some(bp => remainingText.substring(i, i + bp.length) === bp)) {
                            chunkEnd = i + 1;
                            break;
                        }
                    }
                    
                    chunks.push(remainingText.substring(0, chunkEnd));
                    remainingText = remainingText.substring(chunkEnd).trim();
                }
                
                console.log('📚 Split into', chunks.length, 'chunks');
            } else {
                chunks.push(text);
            }
            
            // Get available voices
            var voices = speechSynthesis.getVoices();
            console.log('Available voices:', voices.length);
            
            // Find best voice for language
            var preferredVoice = null;
            if (language === 'vi-VN') {
                // Try to find Vietnamese voice
                preferredVoice = voices.find(v => v.lang.startsWith('vi'));
                console.log('Vietnamese voice:', preferredVoice ? preferredVoice.name : 'NOT FOUND');
                
                // Fallback to any natural-sounding voice
                if (!preferredVoice) {
                    preferredVoice = voices.find(v => v.name.includes('Google') || v.name.includes('Microsoft'));
                    console.log('Fallback voice:', preferredVoice ? preferredVoice.name : 'NONE');
                }
            } else {
                // Find English voice
                preferredVoice = voices.find(v => v.lang.startsWith('en-US') && (v.name.includes('Google') || v.name.includes('Microsoft')));
                console.log('English voice:', preferredVoice ? preferredVoice.name : 'DEFAULT');
            }
            
            // Speak chunks sequentially
            let currentChunkIndex = 0;
            
            function speakNextChunk() {
                if (currentChunkIndex >= chunks.length) {
                    // All chunks spoken
                    isSpeaking = false;
                    readBtn.classList.remove('d-none');
                    stopBtn.classList.add('d-none');
                    console.log('✅ All chunks completed');
                    return;
                }
                
                const chunk = chunks[currentChunkIndex];
                console.log(`🗣️ Speaking chunk ${currentChunkIndex + 1}/${chunks.length} (${chunk.length} chars)`);
                
                currentUtterance = new SpeechSynthesisUtterance();
                currentUtterance.text = chunk;
                currentUtterance.lang = language;
                
                // Use selected voice
                if (preferredVoice) {
                    currentUtterance.voice = preferredVoice;
                }
                
                // Optimize speech parameters for naturalness
                currentUtterance.rate = language === 'vi-VN' ? 0.9 : 1.0;
                currentUtterance.pitch = 1.0;
                currentUtterance.volume = 1.0;
                
                currentUtterance.onstart = function() {
                    isSpeaking = true;
                    readBtn.classList.add('d-none');
                    stopBtn.classList.remove('d-none');
                    
                    var langText = language === 'vi-VN' ? 'Tiếng Việt' : 'English';
                    var progress = chunks.length > 1 ? ` (${currentChunkIndex + 1}/${chunks.length})` : '';
                    stopBtn.innerHTML = '<i class="bi bi-stop-circle me-1"></i>Dừng đọc' + progress;
                };
                
                currentUtterance.onend = function() {
                    console.log(`✅ Chunk ${currentChunkIndex + 1} completed`);
                    currentChunkIndex++;
                    
                    // Small delay before next chunk
                    setTimeout(speakNextChunk, 200);
                };
                
                currentUtterance.onerror = function(event) {
                    console.error('❌ Speech synthesis error:', event.error, 'for chunk', currentChunkIndex + 1);
                    
                    if (event.error === 'interrupted') {
                        // Try to continue with next chunk
                        console.log('⚠️ Interrupted, trying next chunk...');
                        currentChunkIndex++;
                        setTimeout(speakNextChunk, 500);
                    } else {
                        // Fatal error
                        isSpeaking = false;
                        readBtn.classList.remove('d-none');
                        stopBtn.classList.add('d-none');
                        
                        if (event.error === 'not-allowed' || event.error === 'network') {
                            alert('Không thể phát giọng nói. Vui lòng kiểm tra quyền trình duyệt hoặc kết nối mạng.');
                        } else {
                            alert('Lỗi đọc văn bản: ' + event.error);
                        }
                    }
                };
                
                speechSynthesis.speak(currentUtterance);
            }
            
            // Start speaking first chunk
            speakNextChunk();
        }

        function stopReading() {
            if (isSpeaking) {
                // Stop either audio or speech synthesis
                if (currentUtterance) {
                    if (currentUtterance instanceof Audio) {
                        currentUtterance.pause();
                        currentUtterance.currentTime = 0;
                    } else {
                        speechSynthesis.cancel();
                    }
                }
                isSpeaking = false;
                document.getElementById('readPdfBtn').classList.remove('d-none');
                document.getElementById('stopPdfBtn').classList.add('d-none');
            }
        }

        // Cleanup on page unload
        window.addEventListener('beforeunload', function() {
            stopReading();
        });

        // Stop reading when modal closes
        var aiModal = document.getElementById('aiAnalysisModal');
        if (aiModal) {
            aiModal.addEventListener('hidden.bs.modal', function() {
                stopReading();
            });
        }
    </script>
}


