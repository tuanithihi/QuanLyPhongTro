@using Microsoft.AspNetCore.Razor.Language
@model IList<tblMenu>

<header id="header" class="header sticky-top">
    <div class="container-xl d-flex align-items-center position-relative">

        <!-- LOGO -->
        <a asp-controller="Home" asp-action="Index"
           class="logo d-flex align-items-center order-1 me-auto">
            <img src="~/assets/img/learning_16566016.png" alt="LibraHub Logo" style="height:40px" class="me-2">
            <h1 class="sitename mb-0">LibraHub</h1>
        </a>

        <!-- LOGIN / REGISTER OR USER DROPDOWN -->
        <div class="d-flex align-items-center order-2 order-xl-3 ms-3">
            @if (QuanLyThuVien.Utilities.Functions.IsLogin())
            {
                <div class="dropdown">
                    <a class="btn-getstarted dropdown-toggle d-flex align-items-center"
                       href="#"
                       id="userDropdown"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        <i class="bi bi-person-circle me-2"></i>
                        @QuanLyThuVien.Utilities.Functions._FullName
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li class="dropdown-header">
                            <h6 class="mb-0">@QuanLyThuVien.Utilities.Functions._FullName</h6>
                            <small class="text-muted">@QuanLyThuVien.Utilities.Functions._Email</small>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item"
                               asp-controller="Account" asp-action="Info">
                                <i class="bi bi-person me-2"></i>Thông tin tài khoản
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Borrow" asp-action="History">
                                <i class="bi bi-book me-2"></i>Lịch sử mượn
                            </a>
                        </li>

                        @if (QuanLyThuVien.Utilities.Functions.IsAdmin())
                        {
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-shield-lock me-2"></i>Trang quản trị
                                </a>
                            </li>
                        }

                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger"
                               asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login"
                   class="btn-getstarted me-2">Đăng nhập</a>
                <a asp-controller="Account" asp-action="Register"
                   class="btn-getstarted">Đăng ký</a>
            }
        </div>

        <!-- NAV MENU -->
        <nav id="navmenu" class="navmenu order-3 order-xl-2">
            <ul>
                @foreach (var menu in Model.Where(m => m.Levels == 1).OrderBy(m => m.MenuOrder))
                {
                    var pID = menu.MenuID;
                    var sMenu = Model.Where(s => s.ParentID == pID)
                                     .OrderBy(s => s.MenuOrder)
                                     .ToList();

                    if (!sMenu.Any())
                    {
                        <li>
                            <a asp-controller="@menu.ControllerName"
                               asp-action="@menu.ActionName">
                                @menu.MenuName
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="dropdown">
                            <a href="javascript:void(0)">
                                <span>@menu.MenuName</span>
                                <i class="bi bi-chevron-down"></i>
                            </a>
                            <ul>
                                @foreach (var smn in sMenu)
                                {
                                    <li>
                                        <a asp-controller="@smn.ControllerName"
                                           asp-action="@smn.ActionName">
                                            @smn.MenuName
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                }
            </ul>
        </nav>

        <!-- MOBILE TOGGLE -->
        <i class="mobile-nav-toggle d-xl-none bi bi-list order-4"></i>

    </div>
</header>
