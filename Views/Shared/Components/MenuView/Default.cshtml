@using Microsoft.AspNetCore.Http
@inject QuanLyPhongTro.Services.ICurrentLandlordService _currentLandlord
@inject QuanLyPhongTro.Areas.Admin.Data.DataContext _db
@{
    var adminUser  = Context.Session.GetString("AdminUser");
    var adminRole  = Context.Session.GetString("AdminRole");
    var tenantId   = Context.Session.GetString("TenantUser");
    var tenantName = Context.Session.GetString("TenantName");
    var userId     = Context.Session.GetString("NormalUser");
    var userName   = Context.Session.GetString("UserName");

    bool isSuperAdmin       = _currentLandlord.IsSuperAdmin();
    bool isApprovedLandlord = _currentLandlord.IsApprovedLandlord();
    bool isLandlord         = string.Equals(adminRole, "Landlord", StringComparison.OrdinalIgnoreCase);
    bool isAdmin            = !string.IsNullOrEmpty(adminUser);
    bool isLoggedIn         = isAdmin || !string.IsNullOrEmpty(tenantId) || !string.IsNullOrEmpty(userId);

    string? menuAvatar = null;
    if (isAdmin)
    {
        var lid = _currentLandlord.GetCurrentLandlordId();
        var ll = lid.HasValue ? _db.Landlords.FirstOrDefault(l => l.LandlordId == lid.Value) : null;
        var usr = _db.Users.FirstOrDefault(u => u.Username == adminUser);
        menuAvatar = ll?.Avatar ?? usr?.Avatar;
    }
    else if (!string.IsNullOrEmpty(tenantId) && int.TryParse(tenantId, out int tId))
    {
        var t = _db.Tenants.Find(tId);
        menuAvatar = t?.Avatar;
    }
    else if (!string.IsNullOrEmpty(userId) && int.TryParse(userId, out int uId))
    {
        var u = _db.Users.Find(uId);
        menuAvatar = u?.Avatar;
    }

    string displayName = isAdmin                           ? adminUser!
                       : !string.IsNullOrEmpty(tenantName) ? tenantName
                       : !string.IsNullOrEmpty(userName)   ? userName
                       : "";
    string roleLabel   = isSuperAdmin                      ? "Quản trị viên Super Admin"
                       : isLandlord                        ? (isApprovedLandlord ? "Đối tác Chủ trọ" : "Chủ trọ (Chờ duyệt)")
                       : !string.IsNullOrEmpty(tenantId)   ? "Khách thuê phòng"
                       : "Thành viên";
    string roleIcon    = isSuperAdmin                      ? "bi-shield-check"
                       : isLandlord                        ? "bi-building-gear"
                       : !string.IsNullOrEmpty(tenantId)   ? "bi-house-heart"
                       : "bi-person";

    string postListingUrl = isApprovedLandlord ? "/Admin/Room/Create"
                          : (isLandlord ? "/Account/LandlordStatus" : "/dang-tin");
}

<header class="site-header">
    <div class="container-xl">
        <div class="site-navbar">
            <!-- Brand Logo -->
            <a href="/" class="navbar-brand">
                <span class="brand-icon">
                    <i class="bi bi-buildings"></i>
                </span>
                <span class="d-flex flex-column leading-tight">
                    <span style="font-size:1.15rem; font-weight:700; color:var(--gray-900); letter-spacing:-0.3px;">PHONGTRO<span style="color:var(--brand-primary);">MOI</span></span>
                    <span style="font-size:10px; font-weight:600; color:var(--color-text-muted); text-transform:uppercase; letter-spacing:0.5px;">Sàn Cho Thuê Phòng Trọ</span>
                </span>
            </a>

            <!-- Quick Navigation Links -->
            <ul class="navbar-nav-links d-none d-lg-flex">
                <li><a href="/" class="nav-link">Trang chủ</a></li>
                <li><a href="/phong-tro" class="nav-link">Thuê phòng trọ</a></li>
                <li><a href="/phong-da-luu" class="nav-link"><i class="bi bi-heart me-1 text-danger"></i>Đã lưu</a></li>
                <li><a href="/so-sanh" class="nav-link"><i class="bi bi-arrow-left-right me-1"></i>So sánh</a></li>
                <li><a href="/Blog" class="nav-link">Cẩm nang</a></li>
                <li><a href="/Contact" class="nav-link">Liên hệ</a></li>
            </ul>

            <!-- Actions (Post listing + Auth) -->
            <div class="navbar-actions">
                <a href="@postListingUrl" class="btn-post-listing">
                    <i class="bi bi-plus-circle"></i>
                    <span>Đăng tin cho thuê</span>
                </a>

                @if (isLoggedIn)
                {
                    <div class="dropdown">
                        <button class="btn btn-neutral btn-sm d-flex align-items-center gap-2"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (!string.IsNullOrEmpty(menuAvatar))
                            {
                                <img src="@menuAvatar" alt="Avatar" class="rounded-circle" style="width:24px;height:24px;object-fit:cover;" />
                            }
                            else
                            {
                                <i class="bi @roleIcon text-primary"></i>
                            }
                            <span class="d-none d-md-inline fw-semibold">@displayName</span>
                            <i class="bi bi-chevron-down" style="font-size:0.75rem;"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border" style="font-size:0.875rem;">
                            <li>
                                <span class="dropdown-item-text small text-muted">
                                    <i class="bi @roleIcon me-1"></i>@roleLabel
                                </span>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item" href="/Account/Info">
                                    <i class="bi bi-person-circle me-2"></i>Hồ sơ tài khoản
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/phong-da-luu">
                                    <i class="bi bi-heart me-2 text-danger"></i>Phòng đã lưu
                                </a>
                            </li>
                            @if (!string.IsNullOrEmpty(tenantId))
                            {
                                <li>
                                    <a class="dropdown-item" href="/Account/Invoices">
                                        <i class="bi bi-receipt me-2"></i>Hóa đơn &amp; Thanh toán
                                    </a>
                                </li>
                            }
                            @if (isSuperAdmin)
                            {
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <a class="dropdown-item fw-semibold" style="color:var(--brand-primary);"
                                       href="/Admin/Home/Index">
                                        <i class="bi bi-speedometer2 me-2"></i>Quản trị sàn (Super Admin)
                                    </a>
                                </li>
                            }
                            else if (isLandlord)
                            {
                                <li><hr class="dropdown-divider my-1"></li>
                                @if (isApprovedLandlord)
                                {
                                    <li>
                                        <a class="dropdown-item fw-semibold" style="color:var(--brand-primary);"
                                           href="/Admin/Home/Index">
                                            <i class="bi bi-building-gear me-2"></i>Kênh Quản lý Chủ trọ
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Admin/Room/Create">
                                            <i class="bi bi-plus-circle me-2"></i>Đăng tin phòng mới
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="dropdown-item fw-semibold text-warning" href="/Account/LandlordStatus">
                                            <i class="bi bi-clock-history me-2"></i>Hồ sơ chủ trọ (Chờ duyệt)
                                        </a>
                                    </li>
                                }
                            }
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="/Account/Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-1">
                        <button type="button" class="btn btn-neutral btn-sm"
                                data-bs-toggle="modal" data-bs-target="#authModal" data-open-tab="login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                        </button>
                        <button type="button" class="btn btn-brand-outline btn-sm d-none d-sm-inline-flex"
                                data-bs-toggle="modal" data-bs-target="#authModal" data-open-tab="register">
                            <i class="bi bi-person-plus me-1"></i>Đăng ký
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</header>
