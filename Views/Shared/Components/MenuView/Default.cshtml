@{
    var adminUser  = Context.Session.GetString("AdminUser");
    var tenantId   = Context.Session.GetString("TenantUser");
    var tenantName = Context.Session.GetString("TenantName");
    var userId     = Context.Session.GetString("NormalUser");
    var userName   = Context.Session.GetString("UserName");

    bool isAdmin    = !string.IsNullOrEmpty(adminUser);
    bool isLoggedIn = isAdmin || !string.IsNullOrEmpty(tenantId) || !string.IsNullOrEmpty(userId);
    string displayName = isAdmin                             ? adminUser!
                       : !string.IsNullOrEmpty(tenantName)  ? tenantName
                       : !string.IsNullOrEmpty(userName)    ? userName
                       : "";
    string roleLabel   = isAdmin                          ? "Quản trị viên"
                       : !string.IsNullOrEmpty(tenantId)  ? "Người thuê"
                       : "Khách";
    string roleIcon    = isAdmin                          ? "bi-shield-check"
                       : !string.IsNullOrEmpty(tenantId)  ? "bi-house"
                       : "bi-person";

}
<header id="header" class="header sticky-top" style="background: #27AE60;">
    <div class="container-xl d-flex align-items-center position-relative">
        <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center order-1 me-auto">
            <img src="~/assets/img/logo.png"
                 alt="Phòng Trọ Mới Logo"
                 class="me-2"
                 style="height: 36px; width: auto;" />
            <span class="sitename mb-0" style="color: white; font-weight: bold; font-size: 1.2rem;">Phòng Trọ Mới</span>
        </a>

        <nav id="navmenu" class="navmenu order-3 order-xl-2">
            <ul>
                <li><a asp-controller="Home" asp-action="Index" style="color: white;">Trang chủ</a></li>
                <li><a asp-controller="Blog" asp-action="Index" style="color: white;">Tin tức</a></li>
                <li><a asp-controller="Contact" asp-action="Index" style="color: white;">Liên hệ</a></li>
            </ul>
        </nav>

        <div class="order-4 d-flex align-items-center gap-2 ms-3">

            @if (isLoggedIn)
            {
                <!-- Dropdown khi đã đăng nhập -->
                <div class="dropdown">
                    <button class="btn btn-light btn-sm d-flex align-items-center gap-1"
                            type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi @roleIcon"></i>
                        <span class="d-none d-md-inline">@displayName</span>
                        <i class="bi bi-chevron-down" style="font-size:.7rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li>
                            <span class="dropdown-item-text small text-muted">
                                <i class="bi @roleIcon me-1"></i>@roleLabel
                            </span>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Info">
                                <i class="bi bi-person-circle me-2"></i>Thông tin cá nhân
                            </a>
                        </li>
                        @if (!string.IsNullOrEmpty(tenantId))
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="Invoices">
                                    <i class="bi bi-receipt me-2"></i>Hóa đơn &amp; Thanh toán
                                </a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item text-primary fw-semibold"
                                   asp-area="Admin" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-2"></i>Trang quản trị
                                </a>
                            </li>
                        }
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item text-danger"
                               asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <!-- Nút đăng nhập khi chưa đăng nhập -->
                <button type="button"
                        class="btn btn-light btn-sm d-flex align-items-center gap-1"
                        data-bs-toggle="modal" data-bs-target="#authModal" data-open-tab="login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Đăng nhập</span>
                </button>
                <button type="button"
                        class="btn btn-outline-light btn-sm d-none d-md-flex align-items-center gap-1"
                        data-bs-toggle="modal" data-bs-target="#authModal" data-open-tab="register">
                    <i class="bi bi-person-plus"></i>
                    <span>Đăng ký</span>
                </button>
            }
        </div>

        <i class="mobile-nav-toggle d-xl-none bi bi-list order-5" style="color: white;"></i>
    </div>
</header>
