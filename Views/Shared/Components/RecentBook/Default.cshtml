@using QuanLyThuVien.Models
@model IList<viewRecentBook>

@if (Model != null && Model.Any())
{
    <div class="courses-2 recent-book">
        <div class="row gy-4 courses-grid">
            @foreach (var recentBook in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="course-card h-100 shadow-sm">
                        <div class="course-image position-relative">
                            @if (!string.IsNullOrEmpty(recentBook.CoverImage))
                            {
                                <a asp-controller="Book" asp-action="Details" asp-route-id="@recentBook.BookID"
                                    class="d-block card-link-image">
                                    <img src="@recentBook.CoverImage" alt="@recentBook.Title" class="img-fluid card-cover"
                                        style="height: 250px; width:100%; object-fit:cover;">
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Book" asp-action="Details" asp-route-id="@recentBook.BookID" class="d-block">
                                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                        <i class="bi bi-image text-muted" style="font-size: 2.5rem;"></i>
                                    </div>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(recentBook.CategoryName))
                            {
                                <span class="badge bg-info position-absolute top-0 start-0 m-2 small">
                                    <i class="bi bi-folder"></i> @recentBook.CategoryName
                                </span>
                            }
                        </div>
                        <div class="card-body d-flex flex-column p-3">
                            <h5 class="card-title mb-2 fw-bold">
                                <a asp-controller="Book" asp-action="Details" asp-route-id="@recentBook.BookID"
                                    class="card-title-link text-decoration-none text-dark">
                                    @(recentBook.Title ?? "Không có tiêu đề")
                                </a>
                            </h5>

                            <div class="card-meta mb-3 text-muted small" style="line-height: 1.6;">
                                @if (!string.IsNullOrEmpty(recentBook.AuthorName))
                                {
                                    <span class="d-block mb-1"><i class="bi bi-person text-primary"></i> @recentBook.AuthorName</span>
                                }
                                <span class="d-block"><i class="bi bi-calendar-year text-primary"></i> @recentBook.PublishedYear</span>
                            </div>

                            <div class="mt-auto pt-2">
                                <a asp-controller="Book" asp-action="Details" asp-route-id="@recentBook.BookID"
                                    class="btn btn-sm btn-outline-primary w-100">
                                    <i class="bi bi-eye me-1"></i>Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}