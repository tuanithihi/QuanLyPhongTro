@using QuanLyThuVien.Models
@model IList<tblCategory>

@if (Model != null && Model.Any())
{
    <div class="courses-2 category">
        <div class="row gy-4 courses-grid">
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var category in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="course-card h-100 shadow-sm">
                        <div class="course-image position-relative">
                            <div class="bg-primary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-tags text-white" style="font-size: 3.5rem;"></i>
                            </div>
                        </div>
                        <div class="course-content p-3">
                            <div class="course-meta mb-2">
                                <span class="badge bg-light text-primary small">Danh mục</span>
                            </div>
                            <h5 class="fw-bold mb-2 text-dark">@category.CategoryName</h5>
                            <p class="text-muted small mb-3" style="line-height: 1.6;">
                                @(!string.IsNullOrEmpty(category.Description)
                                                    ? (category.Description.Length > 80 ? category.Description.Substring(0, 80) + "..." : category.Description)
                                                    : "Chưa có mô tả cho danh mục này")
                            </p>
                            <div class="mt-auto">
                                <a asp-controller="Category" asp-action="Details" asp-route-id="@category.CategoryID"
                                    class="btn btn-outline-primary btn-sm w-100">
                                    <i class="bi bi-book me-1"></i>Xem sách trong danh mục
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info text-center">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                Không tìm thấy danh mục nào.
            </div>
        </div>
    }
        </div>
    </div>
}