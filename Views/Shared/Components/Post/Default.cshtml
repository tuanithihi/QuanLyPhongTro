@using QuanLyThuVien.Models
@using QuanLyThuVien.Utilities
@model IList<viewPostMenu>

<div class="row gy-4">
    @{
        var recentbook = Model.Take(3).ToList();
        foreach (var post in recentbook)
        {
            string url = Functions.TitleSlugGeneration("post", post.Title, post.PostID);
            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="card">
                    <div class="card-top d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(post.Images))
                        {
                            <img src="@post.Images" alt="Author" class="rounded-circle me-2"
                                style="width: 40px; height: 40px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-2"
                                style="width: 40px; height: 40px;">
                                <i class="bi bi-person text-muted"></i>
                            </div>
                        }
                        <span class="author-name">@(post.Author ?? "Admin")</span>
                    </div>
                    <div class="card-img-wrapper">
                        @if (!string.IsNullOrEmpty(post.Images))
                        {
                            <img src="@post.Images" alt="Post Image" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">
                            <a href="/@url">
                                @(post.Title ?? "Không có tiêu đề")
                            </a>
                        </h5>
                        <p class="card-text">
                            @if (!string.IsNullOrEmpty(post.Abstract))
                            {
                                @(post.Abstract.Length > 100 ? post.Abstract.Substring(0, 100) + "..." : post.Abstract)
                            }
                            else
                            {
                                <span class="text-muted">Không có mô tả</span>
                            }
                        </p>
                        <small class="text-muted">
                            <i class="bi bi-calendar"></i>
                            @(post.CreatedDate?.ToString("dd/MM/yyyy") ?? "N/A")
                        </small>
                    </div>
                </div>
            </div>
        }
    }
</div>