@* ══════════════════════════════════════════════════════════════════════════
   FLOATING LANDLORD CHAT WIDGET
   Cửa sổ chat trực tiếp với Chủ trọ & nhận thông báo phản hồi
══════════════════════════════════════════════════════════════════════════ *@

<style>
    .ll-chat-widget {
        position: fixed;
        bottom: 24px;
        right: 24px;
        width: 380px;
        max-width: calc(100vw - 32px);
        height: 540px;
        max-height: calc(100vh - 80px);
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 12px 40px rgba(15, 23, 42, 0.18), 0 2px 8px rgba(15, 23, 42, 0.08);
        border: 1px solid rgba(226, 232, 240, 0.9);
        display: none;
        flex-direction: column;
        z-index: 1070;
        overflow: hidden;
        animation: llChatSlideUp 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        font-family: inherit;
    }

    @@keyframes llChatSlideUp {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.96);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* Header */
    .ll-chat-header {
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
        color: #ffffff;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }

    .ll-chat-header-user {
        display: flex;
        align-items: center;
        gap: 10px;
        overflow: hidden;
    }

    .ll-chat-avatar-wrap {
        position: relative;
        width: 38px;
        height: 38px;
        flex-shrink: 0;
    }

    .ll-chat-avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(255, 255, 255, 0.85);
        background: #e2e8f0;
    }

    .ll-chat-online-badge {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 10px;
        height: 10px;
        background-color: #22c55e;
        border-radius: 50%;
        border: 2px solid #ffffff;
    }

    .ll-chat-header-info {
        display: flex;
        flex-direction: column;
        line-height: 1.25;
        overflow: hidden;
    }

    .ll-chat-header-name {
        font-weight: 600;
        font-size: 0.92rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #ffffff;
    }

    .ll-chat-header-status {
        font-size: 0.72rem;
        color: rgba(255, 255, 255, 0.85);
    }

    .ll-chat-header-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .ll-chat-btn-icon {
        background: rgba(255, 255, 255, 0.15);
        border: none;
        color: #ffffff;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.15s;
        font-size: 0.85rem;
    }

    .ll-chat-btn-icon:hover {
        background: rgba(255, 255, 255, 0.3);
    }

    /* Room banner */
    .ll-chat-room-banner {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 8px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.8rem;
        flex-shrink: 0;
    }

    .ll-chat-room-badge {
        background: #dbeafe;
        color: #1e40af;
        padding: 2px 6px;
        border-radius: 6px;
        font-size: 0.7rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .ll-chat-room-name {
        font-weight: 600;
        color: #1e293b;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
    }

    .ll-chat-room-price {
        font-weight: 700;
        color: #ef4444;
        white-space: nowrap;
    }

    /* Message Body */
    .ll-chat-body {
        flex: 1;
        overflow-y: auto;
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background: #f8fafc;
    }

    .ll-msg-row {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        max-width: 82%;
    }

    .ll-msg-guest {
        align-self: flex-end;
        flex-direction: row-reverse;
    }

    .ll-msg-admin {
        align-self: flex-start;
    }

    .ll-msg-system {
        align-self: center;
        max-width: 90%;
        margin: 4px 0;
    }

    .ll-msg-avatar {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }

    .ll-msg-bubble {
        padding: 9px 13px;
        border-radius: 14px;
        font-size: 0.86rem;
        line-height: 1.4;
        word-break: break-word;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    .ll-msg-guest .ll-msg-bubble {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #ffffff;
        border-bottom-right-radius: 4px;
    }

    .ll-msg-admin .ll-msg-bubble {
        background: #ffffff;
        color: #1e293b;
        border-bottom-left-radius: 4px;
        border: 1px solid #e2e8f0;
    }

    .ll-msg-system .ll-msg-bubble {
        background: #f1f5f9;
        color: #64748b;
        border-radius: 20px;
        font-size: 0.75rem;
        padding: 4px 12px;
        text-align: center;
        box-shadow: none;
    }

    .ll-msg-time {
        font-size: 0.65rem;
        color: #94a3b8;
        margin-top: 3px;
        display: block;
    }

    .ll-msg-guest .ll-msg-time {
        text-align: right;
        color: rgba(255, 255, 255, 0.8);
    }

    /* Quick suggestions */
    .ll-chat-suggestions {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        padding: 6px 14px;
        background: #ffffff;
        border-top: 1px solid #e2e8f0;
        scrollbar-width: none;
    }
    .ll-chat-suggestions::-webkit-scrollbar { display: none; }

    .ll-suggestion-chip {
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
        padding: 4px 10px;
        border-radius: 14px;
        font-size: 0.75rem;
        white-space: nowrap;
        cursor: pointer;
        transition: all 0.15s;
    }

    .ll-suggestion-chip:hover {
        background: #dbeafe;
        color: #1d4ed8;
        border-color: #93c5fd;
    }

    /* Input section */
    .ll-chat-footer {
        padding: 10px 14px;
        background: #ffffff;
        border-top: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ll-chat-input {
        flex: 1;
        border: 1px solid #cbd5e1;
        border-radius: 20px;
        padding: 8px 14px;
        font-size: 0.86rem;
        outline: none;
        transition: border-color 0.15s;
    }

    .ll-chat-input:focus {
        border-color: #2563eb;
    }

    .ll-chat-send-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #2563eb;
        color: #ffffff;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        transition: transform 0.1s, background-color 0.15s;
    }

    .ll-chat-send-btn:hover {
        background: #1d4ed8;
    }

    .ll-chat-send-btn:active {
        transform: scale(0.92);
    }

    /* Guest info prompt modal inside widget */
    .ll-chat-guest-form {
        padding: 24px 20px;
        text-align: center;
        display: none;
        flex-direction: column;
        justify-content: center;
        flex: 1;
        background: #ffffff;
    }

    /* Floating reopen pill button */
    .ll-chat-floating-pill {
        position: fixed;
        bottom: 24px;
        right: 24px;
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
        color: #ffffff;
        padding: 10px 18px;
        border-radius: 30px;
        box-shadow: 0 8px 24px rgba(37, 99, 235, 0.35);
        display: none;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        z-index: 1069;
        font-weight: 600;
        font-size: 0.88rem;
        transition: transform 0.15s, box-shadow 0.15s;
    }

    .ll-chat-floating-pill:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(37, 99, 235, 0.45);
    }
</style>

<!-- Floating Reopen Pill Button -->
<div id="llChatFloatingPill" class="ll-chat-floating-pill" onclick="llMaximizeChat()">
    <i class="bi bi-chat-dots-fill fs-5"></i>
    <span id="llFloatingPillText">Nhắn tin chủ trọ</span>
    <span id="llFloatingBadge" class="badge bg-danger rounded-pill d-none" style="font-size:0.65rem;">1</span>
</div>

<!-- Main Chat Widget -->
<div id="llChatWidget" class="ll-chat-widget">
    <!-- Header -->
    <div class="ll-chat-header">
        <div class="ll-chat-header-user">
            <div class="ll-chat-avatar-wrap">
                <img id="llChatAvatar" src="/images/no-image.png" alt="Avatar" class="ll-chat-avatar" onerror="this.src='/images/no-image.png';" />
                <span class="ll-chat-online-badge" title="Đang trực tuyến"></span>
            </div>
            <div class="ll-chat-header-info">
                <div id="llChatLandlordName" class="ll-chat-header-name">Chủ trọ</div>
                <div class="ll-chat-header-status">
                    <i class="bi bi-circle-fill me-1" style="font-size:0.5rem; color:#4ade80;"></i>Sẵn sàng phản hồi
                </div>
            </div>
        </div>
        <div class="ll-chat-header-actions">
            <button type="button" class="ll-chat-btn-icon" onclick="llMinimizeChat()" title="Thu nhỏ">
                <i class="bi bi-dash-lg"></i>
            </button>
            <button type="button" class="ll-chat-btn-icon" onclick="llCloseChat()" title="Đóng">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <!-- Room banner (optional) -->
    <div id="llChatRoomBanner" class="ll-chat-room-banner d-none">
        <span class="ll-chat-room-badge"><i class="bi bi-door-open me-1"></i>Phòng</span>
        <span id="llChatRoomName" class="ll-chat-room-name">Phòng trọ</span>
        <span id="llChatRoomPrice" class="ll-chat-room-price">2.500.000 đ</span>
    </div>

    <!-- Guest Name & Phone prompt (nếu chưa đăng nhập & chưa có thông tin) -->
    <div id="llChatGuestForm" class="ll-chat-guest-form">
        <div class="mb-3">
            <i class="bi bi-chat-quote-fill text-primary display-6"></i>
            <h6 class="fw-bold mt-2 mb-1">Gửi tin nhắn tư vấn</h6>
            <p class="text-muted small">Vui lòng cung cấp tên & SĐT để chủ phòng phản hồi lại bạn nhé!</p>
        </div>
        <div class="mb-2 text-start">
            <label class="form-label small fw-semibold">Họ và tên của bạn</label>
            <input type="text" id="llGuestNameInput" class="form-control form-control-sm" placeholder="VD: Nguyễn Văn A" />
        </div>
        <div class="mb-3 text-start">
            <label class="form-label small fw-semibold">Số điện thoại liên hệ</label>
            <input type="tel" id="llGuestPhoneInput" class="form-control form-control-sm" placeholder="VD: 0912345678" />
        </div>
        <div id="llGuestFormError" class="alert alert-danger py-1 small mb-2 d-none"></div>
        <button type="button" class="btn btn-primary btn-sm rounded-pill py-2 fw-semibold" onclick="llSubmitGuestForm()">
            <i class="bi bi-chat-dots me-1"></i>Bắt đầu nhắn tin
        </button>
    </div>

    <!-- Messages Container -->
    <div id="llChatBody" class="ll-chat-body">
        <div class="text-center py-4 text-muted small" id="llChatLoading">
            <div class="spinner-border spinner-border-sm text-primary me-1" role="status"></div>
            Đang kết nối hội thoại...
        </div>
    </div>

    <!-- Quick suggestions -->
    <div id="llChatSuggestions" class="ll-chat-suggestions">
        <div class="ll-suggestion-chip" onclick="llSendQuick('Xin chào, phòng này hiện tại còn trống không ạ?')">Phòng còn trống không?</div>
        <div class="ll-suggestion-chip" onclick="llSendQuick('Cho tôi hỏi chi phí điện nước tính như thế nào ạ?')">Giá điện nước thế nào?</div>
        <div class="ll-suggestion-chip" onclick="llSendQuick('Tôi có thể hẹn giờ qua xem phòng thực tế được không?')">Muốn xem phòng trực tiếp</div>
    </div>

    <!-- Input Footer -->
    <div id="llChatFooter" class="ll-chat-footer">
        <input type="text" id="llChatInput" class="ll-chat-input" placeholder="Nhập tin nhắn tư vấn..." autocomplete="off" onkeydown="llHandleKeyDown(event)" />
        <button type="button" class="ll-chat-send-btn" onclick="llSendMessage()" title="Gửi tin nhắn">
            <i class="bi bi-send-fill" style="font-size:0.85rem;"></i>
        </button>
    </div>
</div>

<script>
    (function () {
        let _currentSessionKey = null;
        let _currentLandlordId = null;
        let _lastMsgId = 0;
        let _pollTimer = null;
        let _pendingRoomContext = null;
        let _currentLandlordName = "Chủ trọ";
        let _currentLandlordAvatar = "";

        // ── API: Mở chat với chủ trọ từ trang chi tiết phòng ──
        window.openLandlordChat = function (options) {
            options = options || {};
            _currentLandlordId = options.landlordId || null;
            _currentLandlordName = options.landlordName || "Chủ trọ";
            _currentLandlordAvatar = options.landlordAvatar || "/images/no-image.png";

            // Hiển thị thông tin phòng nếu có
            if (options.roomTitle) {
                _pendingRoomContext = options;
                document.getElementById('llChatRoomBanner').classList.remove('d-none');
                document.getElementById('llChatRoomName').textContent = options.roomTitle;
                document.getElementById('llChatRoomPrice').textContent = options.roomPrice || "";
            } else {
                _pendingRoomContext = null;
                document.getElementById('llChatRoomBanner').classList.add('d-none');
            }

            updateLandlordHeader(_currentLandlordName, _currentLandlordAvatar);
            showWidget();

            // Bắt đầu hoặc tiếp tục phiên chat
            startChatSession({
                roomId: options.roomId,
                landlordId: _currentLandlordId
            });
        };

        // ── API: Mở chat khi người dùng bấm vào thông báo chuông ──
        window.openChatSession = function (sessionKey, landlordId, landlordName, landlordAvatar) {
            _currentSessionKey = sessionKey;
            _currentLandlordId = landlordId || null;
            _currentLandlordName = landlordName || "Chủ trọ";
            _currentLandlordAvatar = landlordAvatar || "/images/no-image.png";

            document.getElementById('llChatRoomBanner').classList.add('d-none');
            updateLandlordHeader(_currentLandlordName, _currentLandlordAvatar);
            showWidget();

            document.getElementById('llChatGuestForm').style.display = 'none';
            document.getElementById('llChatBody').style.display = 'flex';
            document.getElementById('llChatFooter').style.display = 'flex';
            document.getElementById('llChatSuggestions').style.display = 'flex';

            _lastMsgId = 0;
            document.getElementById('llChatBody').innerHTML = `
                <div class="text-center py-4 text-muted small" id="llChatLoading">
                    <div class="spinner-border spinner-border-sm text-primary me-1" role="status"></div>
                    Đang tải cuộc trò chuyện...
                </div>`;

            pollMessages();
            startPolling();

            // Đánh dấu đã đọc trên server
            fetch('/Chat/MarkRead', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionKey: sessionKey })
            }).catch(() => {});
        };

        function updateLandlordHeader(name, avatar) {
            document.getElementById('llChatLandlordName').textContent = name || "Chủ trọ";
            const img = document.getElementById('llChatAvatar');
            if (img) img.src = avatar && avatar.trim() !== "" ? avatar : "/images/no-image.png";
            document.getElementById('llFloatingPillText').textContent = "Chat: " + (name || "Chủ trọ");
        }

        function showWidget() {
            document.getElementById('llChatWidget').style.display = 'flex';
            document.getElementById('llChatFloatingPill').style.display = 'none';
            setTimeout(() => {
                const inp = document.getElementById('llChatInput');
                if (inp) inp.focus();
            }, 300);
        }

        window.llMinimizeChat = function () {
            document.getElementById('llChatWidget').style.display = 'none';
            if (_currentSessionKey) {
                document.getElementById('llChatFloatingPill').style.display = 'flex';
            }
        };

        window.llMaximizeChat = function () {
            showWidget();
        };

        window.llCloseChat = function () {
            document.getElementById('llChatWidget').style.display = 'none';
            document.getElementById('llChatFloatingPill').style.display = 'none';
            stopPolling();
        };

        async function startChatSession(params) {
            const bodyEl = document.getElementById('llChatBody');
            const formEl = document.getElementById('llChatGuestForm');
            const footerEl = document.getElementById('llChatFooter');
            const suggEl = document.getElementById('llChatSuggestions');

            bodyEl.style.display = 'flex';
            formEl.style.display = 'none';
            footerEl.style.display = 'flex';
            suggEl.style.display = 'flex';

            bodyEl.innerHTML = `
                <div class="text-center py-4 text-muted small" id="llChatLoading">
                    <div class="spinner-border spinner-border-sm text-primary me-1" role="status"></div>
                    Đang kết nối hội thoại...
                </div>`;

            try {
                const res = await fetch('/Chat/Start', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(params || {})
                });
                const data = await res.json();

                if (data.success) {
                    _currentSessionKey = data.sessionKey;
                    if (data.landlordName) {
                        _currentLandlordName = data.landlordName;
                        _currentLandlordAvatar = data.landlordAvatar || "";
                        updateLandlordHeader(_currentLandlordName, _currentLandlordAvatar);
                    }

                    _lastMsgId = 0;
                    bodyEl.innerHTML = '';

                    // Nếu có ngữ cảnh phòng đang hỏi, gửi tin nhắn khởi đầu tự động nếu đây là phiên mới
                    if (_pendingRoomContext) {
                        const initMsg = `Xin chào chủ trọ, tôi quan tâm đến phòng "${_pendingRoomContext.roomTitle}" (${_pendingRoomContext.roomPrice || ''}). Phòng còn trống không ạ?`;
                        _pendingRoomContext = null;
                        await sendMsgDirect(initMsg);
                    }

                    await pollMessages();
                    startPolling();
                } else {
                    // Cần nhập thông tin khách
                    bodyEl.style.display = 'none';
                    footerEl.style.display = 'none';
                    suggEl.style.display = 'none';
                    formEl.style.display = 'flex';
                }
            } catch (err) {
                console.error("Lỗi khởi tạo chat:", err);
                bodyEl.innerHTML = `<div class="text-center py-4 text-danger small">Không thể kết nối máy chủ chat. Vui lòng thử lại sau.</div>`;
            }
        }

        window.llSubmitGuestForm = async function () {
            const name = document.getElementById('llGuestNameInput').value.trim();
            const phone = document.getElementById('llGuestPhoneInput').value.trim();
            const errEl = document.getElementById('llGuestFormError');

            if (!name || !phone) {
                errEl.textContent = "Vui lòng nhập đầy đủ họ tên và số điện thoại.";
                errEl.classList.remove('d-none');
                return;
            }
            errEl.classList.add('d-none');

            await startChatSession({
                guestName: name,
                guestPhone: phone,
                landlordId: _currentLandlordId,
                roomId: _pendingRoomContext ? _pendingRoomContext.roomId : null
            });
        };

        async function pollMessages() {
            if (!_currentSessionKey) return;
            try {
                const res = await fetch(`/Chat/Poll?sessionKey=${encodeURIComponent(_currentSessionKey)}&after=${_lastMsgId}`);
                if (!res.ok) return;
                const data = await res.json();

                if (data.landlordName && (!_currentLandlordName || _currentLandlordName === "Chủ trọ")) {
                    updateLandlordHeader(data.landlordName, data.landlordAvatar);
                }

                if (data.messages && data.messages.length > 0) {
                    const body = document.getElementById('llChatBody');
                    const loading = document.getElementById('llChatLoading');
                    if (loading) loading.remove();

                    data.messages.forEach(m => {
                        if (m.id > _lastMsgId) _lastMsgId = m.id;
                        appendMessageToDom(m);
                    });

                    scrollToBottom();
                } else if (_lastMsgId === 0) {
                    const loading = document.getElementById('llChatLoading');
                    if (loading) loading.remove();
                    const body = document.getElementById('llChatBody');
                    if (body && body.children.length === 0) {
                        body.innerHTML = `
                            <div class="ll-msg-row ll-msg-system">
                                <div class="ll-msg-bubble">
                                    <i class="bi bi-shield-check text-success me-1"></i>Hội thoại trực tiếp giữa bạn và chủ trọ. Hãy gửi lời chào để bắt đầu nhé!
                                </div>
                            </div>`;
                    }
                }
            } catch (err) {
                console.error("Lỗi tải tin nhắn:", err);
            }
        }

        function appendMessageToDom(m) {
            const body = document.getElementById('llChatBody');
            if (!body) return;

            // Kiểm tra xem tin nhắn đã có chưa
            if (document.getElementById(`ll-msg-${m.id}`)) return;

            const isGuest = m.senderType === 0; // Guest
            const isSystem = m.isSystem || m.senderType === 2;

            let rowClass = isGuest ? 'll-msg-row ll-msg-guest' : 'll-msg-row ll-msg-admin';
            if (isSystem) rowClass = 'll-msg-row ll-msg-system';

            const avatarHtml = (!isGuest && !isSystem) ?
                `<img src="${_currentLandlordAvatar && _currentLandlordAvatar.trim() !== '' ? _currentLandlordAvatar : '/images/no-image.png'}" class="ll-msg-avatar" alt="Chủ trọ" onerror="this.src='/images/no-image.png';" />` : '';

            const row = document.createElement('div');
            row.id = `ll-msg-${m.id}`;
            row.className = rowClass;
            row.innerHTML = `
                ${avatarHtml}
                <div class="ll-msg-bubble">
                    ${escapeHtml(m.content)}
                    ${!isSystem ? `<span class="ll-msg-time">${m.createdAt || ''}</span>` : ''}
                </div>
            `;
            body.appendChild(row);
        }

        function scrollToBottom() {
            const body = document.getElementById('llChatBody');
            if (body) body.scrollTop = body.scrollHeight;
        }

        function startPolling() {
            stopPolling();
            _pollTimer = setInterval(pollMessages, 2500);
        }

        function stopPolling() {
            if (_pollTimer) {
                clearInterval(_pollTimer);
                _pollTimer = null;
            }
        }

        window.llSendMessage = async function () {
            const input = document.getElementById('llChatInput');
            const text = input ? input.value.trim() : "";
            if (!text || !_currentSessionKey) return;
            input.value = "";
            await sendMsgDirect(text);
        };

        window.llSendQuick = async function (text) {
            if (!text || !_currentSessionKey) return;
            await sendMsgDirect(text);
        };

        async function sendMsgDirect(text) {
            if (!text || !_currentSessionKey) return;

            // Optimistic UI
            const tempId = 'temp_' + Date.now();
            const body = document.getElementById('llChatBody');
            const loading = document.getElementById('llChatLoading');
            if (loading) loading.remove();

            const row = document.createElement('div');
            row.id = tempId;
            row.className = 'll-msg-row ll-msg-guest';
            row.innerHTML = `
                <div class="ll-msg-bubble">
                    ${escapeHtml(text)}
                    <span class="ll-msg-time">Đang gửi...</span>
                </div>
            `;
            body.appendChild(row);
            scrollToBottom();

            try {
                const res = await fetch('/Chat/Send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionKey: _currentSessionKey, content: text })
                });
                const data = await res.json();
                if (data.success) {
                    const tempRow = document.getElementById(tempId);
                    if (tempRow) {
                        tempRow.id = `ll-msg-${data.messageId}`;
                        const timeEl = tempRow.querySelector('.ll-msg-time');
                        if (timeEl) timeEl.textContent = data.createdAt || 'Vừa xong';
                        if (data.messageId > _lastMsgId) _lastMsgId = data.messageId;
                    }
                }
            } catch (err) {
                console.error("Lỗi gửi tin nhắn:", err);
            }
        }

        window.llHandleKeyDown = function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                llSendMessage();
            }
        };

        function escapeHtml(s) {
            if (!s) return '';
            return s.toString().replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
    })();
</script>
