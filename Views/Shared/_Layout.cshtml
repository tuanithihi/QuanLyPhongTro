        welcome.innerHTML =
          '<div style="font-size:2.5rem;">🏠</div>' +
          '<div class="fw-bold" style="color:#1E8449;font-size:1.05rem;">Xin chào! Tôi là trợ lý AI</div>' +
          '<p class="text-muted small mb-3" style="line-height:1.6;">Tôi giúp bạn tìm phòng trọ phù hợp, tư vấn giá cả, diện tích và tiện ích. Hãy hỏi bất cứ điều gì!</p>' +
          '<div class="ai-quick-actions">' +
            '<button onclick="aiSendQuick(\'Có phòng trống nào không?\')">🔍 Phòng trống</button>' +
            '<button onclick="aiSendQuick(\'Phòng giá rẻ nhất?\')">💰 Giá rẻ nhất</button>' +
            '<button onclick="aiSendQuick(\'Phòng cho 2 người\')">👥 Phòng 2 người</button>' +
            '<button onclick="aiSendQuick(\'Phòng diện tích lớn nhất\')">📐 Phòng rộng</button>' +
          '</div>';
        area.appendChild(welcome);
        _aiWaiting = false;
        document.getElementById('aiSendBtn').disabled = false;
        document.getElementById('aiInput').value = '';
        document.getElementById('aiInput').focus();
      };

      // ── Send message ────────────────────────────────────────
      window.aiSend = async function(){
        const inp = document.getElementById('aiInput');
        const text = inp.value.trim();
        if(!text || _aiWaiting) return;

        // Ẩn welcome
        const w = document.getElementById('aiWelcome');
        if(w) w.remove();

        // Hiện tin user
        aiAppend('user', text);
        inp.value = '';
        inp.focus();

        // Hiện typing
        const typing = aiShowTyping();
        _aiWaiting = true;
        document.getElementById('aiSendBtn').disabled = true;

        try {
          const res = await fetch('/api/chat/ask', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text })
          });
          const data = await res.json();
          typing.remove();
          aiAppend('bot', data.success ? data.reply : (data.reply || 'Xin lỗi, có lỗi xảy ra.'));
        } catch(err) {
          typing.remove();
          aiAppend('bot', '⚠️ Không thể kết nối. Vui lòng thử lại.');
        } finally {
          _aiWaiting = false;
          document.getElementById('aiSendBtn').disabled = false;
        }
      };

      // ── Append bubble ───────────────────────────────────────
      function aiAppend(role, text) {
        const area = document.getElementById('aiMsgArea');
        const div = document.createElement('div');
        div.className = 'ai-msg ' + role;
        const icon = role === 'bot' ? 'bi-robot' : 'bi-person-fill';
        let html = esc(text)
          .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
          .replace(/^\s*[-•]\s+(.+)/gm, '&bull; $1')
          .replace(/\n/g, '<br>');
        div.innerHTML = '<div class="ai-icon"><i class="bi '+icon+'"></i></div><div class="ai-bubble">'+html+'</div>';
        area.appendChild(div);
        area.scrollTop = area.scrollHeight;
      }

      // ── Typing indicator ────────────────────────────────────
      function aiShowTyping() {
        const area = document.getElementById('aiMsgArea');
        const div = document.createElement('div');
        div.className = 'ai-msg bot';
        div.innerHTML = '<div class="ai-icon"><i class="bi bi-robot"></i></div><div class="ai-bubble"><div class="ai-typing"><span></span><span></span><span></span></div></div>';
        area.appendChild(div);
        area.scrollTop = area.scrollHeight;
        return div;
      }

      function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

      // ── Auto-show tooltip after 3s ──────────────────────────
      setTimeout(function(){
        const tip = document.getElementById('aiTooltip');
        if(tip) tip.style.display = 'flex';
      }, 3000);
    })();
  </script>

  </body>

  </html>
