    <!-- ── Auth Modal ─────────────────────────────────────────────── -->
    <div class="modal fade" id="authModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
            <div class="modal-content" style="border-radius:16px;border:none;box-shadow:0 20px 60px rgba(0,0,0,.25);">

                <div class="modal-header border-0 pb-1 px-4 pt-4">
                    <ul class="nav nav-pills gap-1 me-auto" id="authTabList">
                        <li class="nav-item">
                            <button class="nav-link active px-3 py-1" data-auth-tab="login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link px-3 py-1" data-auth-tab="register">
                                <i class="bi bi-person-plus me-1"></i>Đăng ký
                            </button>
                        </li>
                    </ul>
                    <button type="button" class="btn-close ms-2" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body px-4 pb-4 pt-2">
                    <div id="authAlert" class="d-none alert py-2 small mb-3"></div>

                    <!-- ── Login Form ── -->
                    <div id="loginPane">
                        <p class="text-muted small mb-3">
                            <i class="bi bi-info-circle me-1"></i>Hệ thống tự nhận dạng loại tài khoản của bạn.
                        </p>
                        <form id="loginForm" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" id="loginReturnUrl" value="" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Tên đăng nhập / Email</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input type="text" name="UsernameOrEmail" class="form-control"
                                           placeholder="Nhập tên đăng nhập hoặc email"
                                           autocomplete="username" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Mật khẩu</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input type="password" name="Password" class="form-control"
                                           placeholder="Nhập mật khẩu"
                                           autocomplete="current-password" required />
                                    <button type="button" class="btn btn-outline-secondary" onclick="authTogglePwd(this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="d-grid">
                                <button type="submit" id="loginSubmitBtn" class="btn btn-auth-modal btn-lg">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- ── Register Form ── -->
                    <div id="registerPane" class="d-none">
                        <p class="text-muted small mb-3">Đăng ký để xem phòng, gửi yêu cầu thuê</p>
                        <form id="registerForm" novalidate>
                            @Html.AntiForgeryToken()

                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Tên đăng nhập <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                                        <input type="text" name="Username" class="form-control"
                                               placeholder="Ví dụ: nguyen_van_a" autocomplete="username" required />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                        <input type="email" name="Email" class="form-control"
                                               placeholder="email@example.com" autocomplete="email" required />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Họ và tên</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                                        <input type="text" name="FullName" class="form-control" placeholder="Họ và tên đầy đủ" />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Số điện thoại</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                        <input type="tel" name="Phone" class="form-control" placeholder="0xxx xxx xxx" />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                        <input type="password" name="Password" class="form-control"
                                               placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" required />
                                        <button type="button" class="btn btn-outline-secondary" onclick="authTogglePwd(this)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                        <input type="password" name="ConfirmPassword" class="form-control"
                                               placeholder="Nhập lại mật khẩu" autocomplete="new-password" required />
                                        <button type="button" class="btn btn-outline-secondary" onclick="authTogglePwd(this)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="d-grid mt-1">
                                        <button type="submit" id="registerSubmitBtn" class="btn btn-auth-modal btn-lg">
                                            <i class="bi bi-person-plus me-1"></i>Đăng ký
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script>
        // ── Helpers ──────────────────────────────────────────────────────
        function authTogglePwd(btn) {
            var input = btn.previousElementSibling;
            var icon  = btn.querySelector('i');
            input.type = (input.type === 'password') ? 'text' : 'password';
            icon.className = (input.type === 'text') ? 'bi bi-eye-slash' : 'bi bi-eye';
        }

        function authShowAlert(type, msg) {
            var el = document.getElementById('authAlert');
            el.className = 'alert alert-' + type + ' py-2 small mb-3';
            el.textContent = msg;
        }

        function authClearAlert() {
            var el = document.getElementById('authAlert');
            el.className = 'd-none alert py-2 small mb-3';
            el.textContent = '';
        }

        function authSwitchTab(tab) {
            document.querySelectorAll('[data-auth-tab]').forEach(function(btn) {
                btn.classList.toggle('active', btn.dataset.authTab === tab);
            });
            document.getElementById('loginPane').classList.toggle('d-none', tab !== 'login');
            document.getElementById('registerPane').classList.toggle('d-none', tab !== 'register');
            authClearAlert();
        }

        // ── Tab switching ─────────────────────────────────────────────────
        document.querySelectorAll('[data-auth-tab]').forEach(function(btn) {
            btn.addEventListener('click', function() { authSwitchTab(this.dataset.authTab); });
        });

        // Mở đúng tab khi modal show
        document.getElementById('authModal').addEventListener('show.bs.modal', function(e) {
            var tab = e.relatedTarget && e.relatedTarget.dataset.openTab;
            authSwitchTab(tab === 'register' ? 'register' : 'login');
            document.getElementById('loginForm').reset();
            document.getElementById('registerForm').reset();
        });

        // ── Login submit ──────────────────────────────────────────────────
        document.getElementById('loginForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            authClearAlert();
            var btn = document.getElementById('loginSubmitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý…';

            try {
                var res  = await fetch('/Account/LoginModal', { method: 'POST', body: new FormData(this) });
                var data = await res.json();
                if (data.success) {
                    window.location.href = data.redirectUrl;
                } else {
                    authShowAlert('danger', data.message);
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập';
                }
            } catch {
                authShowAlert('danger', 'Có lỗi xảy ra, vui lòng thử lại.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập';
            }
        });

        // ── Register submit ───────────────────────────────────────────────
        document.getElementById('registerForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            authClearAlert();
            var btn = document.getElementById('registerSubmitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý…';

            try {
                var res  = await fetch('/Account/RegisterModal', { method: 'POST', body: new FormData(this) });
                var data = await res.json();
                if (data.success) {
                    authShowAlert('success', data.message);
                    setTimeout(function() { authSwitchTab('login'); }, 1500);
                } else {
                    authShowAlert('danger', data.message);
                }
            } catch {
                authShowAlert('danger', 'Có lỗi xảy ra, vui lòng thử lại.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-person-plus me-1"></i>Đăng ký';
            }
        });
    </script>

    @* ── Modal thông báo hóa đơn trễ hạn ── *@
    @{
        bool _isTenantLoggedIn = !string.IsNullOrEmpty(Context.Session.GetString("TenantUser"));
    }
    @if (_isTenantLoggedIn)
    {
        <div class="modal fade" id="overdueModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content" style="border:none;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.25);overflow:hidden;">
                    <div class="modal-header border-0" style="background:linear-gradient(135deg,#E74C3C,#C0392B);color:#fff;padding:1.25rem 1.5rem;">
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Thông báo hóa đơn chưa thanh toán
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-warning d-flex align-items-start gap-2 mb-3" style="border-radius:10px;">
                            <i class="bi bi-info-circle-fill fs-5 mt-1" style="color:#E67E22;"></i>
                            <div class="small">
                                Bạn có <strong id="overdueCount">0</strong> hóa đơn chưa thanh toán.
                                Vui lòng thanh toán trước hạn để tránh phí phạt trễ hạn.
                            </div>
                        </div>
                        <div class="table-responsive" style="max-height:320px;overflow-y:auto;">
                            <table class="table table-hover table-sm align-middle mb-0" style="font-size:.88rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Mã HĐ</th>
                                        <th>Phòng</th>
                                        <th>Kỳ</th>
                                        <th>Hạn thanh toán</th>
                                        <th class="text-end">Số tiền</th>
                                        <th class="text-center">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody id="overdueTableBody"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer border-0 bg-light" style="border-radius:0 0 16px 16px;">
                        <a href="/Account/Invoices" class="btn fw-semibold" style="background:#27AE60;color:#fff;border:none;">
                            <i class="bi bi-receipt me-1"></i>Xem hóa đơn & Thanh toán
                        </a>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Để sau</button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', async function () {
                // Chỉ hiện 1 lần mỗi phiên đăng nhập
                if (sessionStorage.getItem('overdueShown')) return;

                try {
                    const res = await fetch('/Account/GetOverdueInvoices');
                    const data = await res.json();
                    if (!data.invoices || data.invoices.length === 0) return;

                    // Đánh dấu đã hiện
                    sessionStorage.setItem('overdueShown', '1');

                    // Điền dữ liệu
                    document.getElementById('overdueCount').textContent = data.invoices.length;
                    const tbody = document.getElementById('overdueTableBody');
                    data.invoices.forEach(function (inv) {
                        const statusClass = inv.isOverdue ? 'bg-danger' : 'bg-warning text-dark';
                        const row = document.createElement('tr');
                        row.innerHTML =
                            '<td class="fw-semibold">' + inv.invoiceCode + '</td>' +
                            '<td>' + inv.roomName + '</td>' +
                            '<td>' + ('0' + inv.billingMonth).slice(-2) + '/' + inv.billingYear + '</td>' +
                            '<td>' + (inv.isOverdue ? '<span class="text-danger fw-bold">' + inv.dueDate + '</span>' : inv.dueDate) + '</td>' +
                            '<td class="text-end fw-bold" style="color:#E74C3C;">' + inv.totalAmount + ' ₫</td>' +
                            '<td class="text-center"><span class="badge ' + statusClass + ' rounded-pill">' + inv.status + '</span></td>';
                        tbody.appendChild(row);
                    });

                    // Hiện modal
                    var modal = new bootstrap.Modal(document.getElementById('overdueModal'));
                    modal.show();
                } catch (e) { /* im lặng nếu lỗi */ }
            });
        </script>
    }

