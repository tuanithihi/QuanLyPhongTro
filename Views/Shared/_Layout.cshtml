  @{
    bool _chatLoggedIn = !string.IsNullOrEmpty(Context.Session.GetString("TenantUser"))
                      || !string.IsNullOrEmpty(Context.Session.GetString("NormalUser"));
  }
  <script>
    (function(){
      const COOKIE    = 'chat_session';
      const _autoStart = @(_chatLoggedIn ? "true" : "false");
      let _sk='', _lastId=0, _timer=null;

      function getCookie(n){ const m=document.cookie.match('(^|;)\\s*'+n+'\\s*=\\s*([^;]+)'); return m?m.pop():''; }

      document.addEventListener('DOMContentLoaded', function(){
        _sk = getCookie(COOKIE);
        if(_sk) showWindow();
      });

      window.chatToggle = async function(){
        const p=document.getElementById('chatPanel');
        const opening=p.classList.contains('d-none');
        p.classList.toggle('d-none',!opening);
        document.getElementById('chatToggleIcon').className = opening?'bi bi-x-lg':'bi bi-chat-dots-fill';
        if(opening){
          document.getElementById('chatUnreadDot').classList.add('d-none');
          if(_sk){ if(!_timer) startPoll(); fetchMsgs(); }
          else if(_autoStart){ await _autoCreateSession(); }
        }
        // Không gọi stopPoll() khi đóng — poll tiếp tục chạy ngầm để phát hiện tin mới
      };

      async function _autoCreateSession(){
        // Người thuê / người dùng đã đăng nhập — tự tạo/tiếp nối phiên, không cần nhập tên/SĐT
        try{
          document.getElementById('chatIntro').classList.add('d-none');
          const r=await fetch('/Chat/Start',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({guestName:'',guestPhone:''})});
          const d=await r.json();
          if(d.success){ _sk=d.sessionKey; showWindow(); }
          else { document.getElementById('chatIntro').classList.remove('d-none'); }
        }catch{ document.getElementById('chatIntro').classList.remove('d-none'); }
      }

      window.chatStart = async function(){
        const name=document.getElementById('introName').value.trim();
        const phone=document.getElementById('introPhone').value.trim();
        const al=document.getElementById('chatIntroAlert');
        if(!name||!phone){ al.className='alert alert-danger py-2 small mx-3 mb-2'; al.textContent='Vui lòng nhập họ tên và số điện thoại.'; return; }
        al.className='d-none';
        try{
          const r=await fetch('/Chat/Start',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({guestName:name,guestPhone:phone})});
          const d=await r.json();
          if(d.success){ _sk=d.sessionKey; showWindow(); }
          else{ al.className='alert alert-danger py-2 small mx-3 mb-2'; al.textContent=d.message||'Có lỗi xảy ra.'; }
        }catch{ al.className='alert alert-danger py-2 small mx-3 mb-2'; al.textContent='Có lỗi xảy ra, vui lòng thử lại.'; }
      };

      function showWindow(){
        document.getElementById('chatIntro').classList.add('d-none');
        const w=document.getElementById('chatWindow');
        w.classList.remove('d-none'); w.style.display='flex';
        fetchMsgs(); startPoll();
      }

      window.chatSend = async function(){
        const inp=document.getElementById('chatInput');
        const txt=inp.value.trim();
        if(!txt||!_sk) return;
        inp.value='';
        appendBubble({content:txt,senderType:0,createdAt:new Date().toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'}),isSystem:false});
        scrollBot();
        try{ await fetch('/Chat/Send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({sessionKey:_sk,content:txt})}); }catch{}
      };

      async function fetchMsgs(){
        if(!_sk) return;
        try{
          const r=await fetch('/Chat/Poll?sessionKey='+encodeURIComponent(_sk)+'&after='+_lastId);
          const d=await r.json();
          if(d.messages&&d.messages.length){
            d.messages.forEach(m=>appendBubble(m));
            _lastId=d.messages[d.messages.length-1].id;
            scrollBot();
            // Hiện dot nếu panel đang đóng và có tin từ admin/hệ thống
            const panelOpen = !document.getElementById('chatPanel').classList.contains('d-none');
            if(panelOpen){
              document.getElementById('chatUnreadDot').classList.add('d-none');
            } else if(d.messages.some(m => m.senderType !== 0)){
              document.getElementById('chatUnreadDot').classList.remove('d-none');
            }
          }
        }catch{}
      }

      function appendBubble(m){
        const a=document.getElementById('chatMsgArea');
        if(!a) return;
        const w=document.createElement('div');
        if(m.isSystem){
          w.className='d-flex justify-content-center my-2';
          w.innerHTML='<div class="chat-system">'+esc(m.content)+'</div>';
        } else if(m.senderType===0){
          w.className='d-flex flex-column align-items-end mb-2';
          w.innerHTML='<div class="chat-bubble chat-guest">'+esc(m.content)+'</div><div class="chat-time pe-1">'+m.createdAt+'</div>';
        } else {
          w.className='d-flex flex-column align-items-start mb-2';
          w.innerHTML='<div class="chat-bubble chat-admin">'+esc(m.content)+'</div><div class="chat-time ps-1">'+m.createdAt+'</div>';
        }
        a.appendChild(w);
      }

      function scrollBot(){ const a=document.getElementById('chatMsgArea'); if(a) a.scrollTop=a.scrollHeight; }
      function startPoll(){ stopPoll(); _timer=setInterval(fetchMsgs,4000); }
      function stopPoll(){ if(_timer){clearInterval(_timer);_timer=null;} }
      function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    })();
  </script>

