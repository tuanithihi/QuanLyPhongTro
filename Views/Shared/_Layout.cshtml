<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <!-- SEO Meta Tags -->
    <title>@(ViewData["Title"] ?? "Phòng Trọ Mới - Nền tảng tìm kiếm và cho thuê phòng trọ uy tín")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Phòng Trọ Mới - Sàn giao dịch phòng trọ, căn hộ mini, nhà nguyên căn minh bạch, an toàn tại Việt Nam.")">
    <meta name="keywords" content="@(ViewData["Keywords"] ?? "thuê phòng trọ, tìm phòng trọ, phòng trọ giá rẻ, căn hộ mini, phòng trọ hà nội, phòng trọ tphcm")">
    <meta name="author" content="PhongTroMoi">

    <!-- Canonical & Open Graph -->
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")">
    <meta property="og:site_name" content="Phòng Trọ Mới">
    <meta property="og:url" content="@(ViewData["CanonicalUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")">
    <meta property="og:title" content="@(ViewData["Title"] ?? "Phòng Trọ Mới - Sàn phòng trọ uy tín")">
    <meta property="og:description" content="@(ViewData["Description"] ?? "Tìm phòng trọ nhanh chóng, an toàn, minh bạch.")">
    <meta property="og:image" content="@(ViewData["OgImage"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}/images/og-default.jpg")">

    @await RenderSectionAsync("SeoHead", required: false)

    <!-- Vendor CSS -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">

    <!-- Design System CSS (Tách biệt chuẩn chỉ) -->
    <link href="~/css/variables.css" rel="stylesheet">
    <link href="~/css/base.css" rel="stylesheet">
    <link href="~/css/components.css" rel="stylesheet">

    <!-- Chatbot CSS -->
    <link href="~/css/chatbot.css" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)

    <style>
        .btn-auth-modal {
            background-color: var(--brand-primary);
            border: 1px solid var(--brand-primary);
            color: #ffffff;
            font-weight: var(--font-semibold);
            border-radius: var(--radius-md);
            transition: all var(--transition-fast);
        }
        .btn-auth-modal:hover {
            background-color: var(--brand-primary-hover);
            border-color: var(--brand-primary-hover);
            color: #ffffff;
        }
        #authTabList .nav-link {
            font-size: var(--text-sm);
            color: var(--color-text-secondary);
            border-radius: var(--radius-md);
            padding: 6px 16px;
            font-weight: var(--font-medium);
        }
        #authTabList .nav-link.active {
            background-color: var(--brand-primary);
            color: #ffffff;
        }
    </style>
</head>

<body style="display:flex; flex-direction:column; min-height:100vh;">

    <!-- ── Site Header & Navigation ───────────────────────────────── -->
    @await Component.InvokeAsync("MenuView")

    <!-- ── Global Toast Notifications ────────────────────────────── -->
    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div style="position:fixed; top:80px; right:20px; z-index:9999; min-width:300px; max-width:400px;">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border" role="alert" style="border-radius:var(--radius-md);">
                    <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border" role="alert" style="border-radius:var(--radius-md);">
                    <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
    }

    <!-- ── Main Content Area ──────────────────────────────────────── -->
    <main id="main" style="flex:1;">
        @RenderBody()
    </main>

    <!-- ── Structured Site Footer ─────────────────────────────────── -->
    <footer class="site-footer">
        <div class="container-xl footer-top">
            <div class="row gy-4">
                <!-- Col 1: Brand Info -->
                <div class="col-lg-4 col-md-12">
                    <a href="/" class="d-flex align-items-center gap-2 mb-3 text-decoration-none">
                        <span class="brand-icon" style="width:30px; height:30px; font-size:0.95rem;">
                            <i class="bi bi-buildings"></i>
                        </span>
                        <span class="fw-bold" style="font-size:1.1rem; color:var(--gray-900); letter-spacing:-0.3px;">PHONGTRO<span style="color:var(--brand-primary);">MOI</span></span>
                    </a>
                    <p class="small text-muted mb-3" style="line-height:1.6;">
                        Nền tảng tìm kiếm và cho thuê phòng trọ hàng đầu Việt Nam. Kết nối trực tiếp khách thuê và chủ nhà với thông tin xác thực, bản đồ vị trí trực quan, hợp đồng minh bạch và thanh toán an toàn qua VietQR.
                    </p>
                    <div class="d-flex align-items-center gap-3 text-muted small">
                        <span><i class="bi bi-shield-check text-success me-1"></i>Tin thật - Phòng thật</span>
                        <span><i class="bi bi-check2-circle text-primary me-1"></i>Hỗ trợ 24/7</span>
                    </div>
                </div>

                <!-- Col 2: Popular Locations -->
                <div class="col-lg-2 col-6">
                    <h5 class="footer-col-title">Khu vực thuê</h5>
                    <ul class="footer-links-list">
                        <li><a href="/phong-tro/ha-noi">Phòng trọ Hà Nội</a></li>
                        <li><a href="/phong-tro/ho-chi-minh">Phòng trọ TP.HCM</a></li>
                        <li><a href="/phong-tro/da-nang">Phòng trọ Đà Nẵng</a></li>
                        <li><a href="/phong-tro/nghe-an">Phòng trọ Nghệ An</a></li>
                        <li><a href="/phong-tro/can-tho">Phòng trọ Cần Thơ</a></li>
                        <li><a href="/phong-tro">Tất cả khu vực</a></li>
                    </ul>
                </div>

                <!-- Col 3: Guidelines & Policies -->
                <div class="col-lg-3 col-6">
                    <h5 class="footer-col-title">Quy chế &amp; Hướng dẫn</h5>
                    <ul class="footer-links-list">
                        <li><a href="/Home/Privacy">Chính sách bảo mật</a></li>
                        <li><a href="/Blog">Kinh nghiệm thuê phòng</a></li>
                        <li><a href="/Contact">Quy chế hoạt động sàn</a></li>
                        <li><a href="/dang-tin">Đăng ký chủ trọ &amp; Đăng tin</a></li>
                        <li><a href="/Account/Invoices">Hướng dẫn thanh toán</a></li>
                        <li><a href="/Admin/Account/Login">Kênh Quản lý Chủ trọ / Admin</a></li>
                    </ul>
                </div>

                <!-- Col 4: Contact -->
                <div class="col-lg-3 col-md-12">
                    <h5 class="footer-col-title">Liên hệ &amp; Hỗ trợ</h5>
                    <p class="small text-muted mb-2">
                        <i class="bi bi-geo-alt me-2 text-danger"></i>Trụ sở: TP. Vinh, Tỉnh Nghệ An, Việt Nam
                    </p>
                    <p class="small text-muted mb-2">
                        <i class="bi bi-telephone me-2 text-primary"></i>Hotline: <strong>1900 8888</strong> (8h00 - 21h00)
                    </p>
                    <p class="small text-muted mb-3">
                        <i class="bi bi-envelope me-2 text-warning"></i>Email: <a href="mailto:support@phongtromoi.vn" class="text-decoration-none">support@phongtromoi.vn</a>
                    </p>
                    <div class="d-flex gap-2">
                        <a href="#" class="btn btn-neutral btn-sm" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-neutral btn-sm" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="btn btn-neutral btn-sm" aria-label="Zalo"><i class="bi bi-chat-dots"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="container-xl footer-bottom-content">
                <div>
                    &copy; @DateTime.Now.Year Phòng Trọ Mới. Giữ toàn quyền bản quyền nội dung và thiết kế.
                </div>
                <div class="d-flex gap-3">
                    <a href="/Home/Privacy" class="text-muted text-decoration-none">Bảo mật</a>
                    <a href="/Contact" class="text-muted text-decoration-none">Điều khoản</a>
                    <a href="/Contact" class="text-muted text-decoration-none">Trợ giúp</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- ── Scripts ────────────────────────────────────────────────── -->
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- ── Auth Modal (Đăng nhập / Đăng ký) ───────────────────────── -->
    <div class="modal fade" id="authModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
            <div class="modal-content" style="border-radius:var(--radius-lg); border:1px solid var(--border-color); box-shadow:var(--shadow-drawer);">
                <div class="modal-header border-0 pb-1 px-4 pt-4">
                    <ul class="nav nav-pills gap-1 me-auto" id="authTabList">
                        <li class="nav-item">
                            <button class="nav-link active" data-auth-tab="login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-auth-tab="register">
                                <i class="bi bi-person-plus me-1"></i>Đăng ký
                            </button>
                        </li>
                    </ul>
                    <button type="button" class="btn-close ms-2" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body px-4 pb-4 pt-2">
                    <div id="authAlert" class="d-none alert py-2 small mb-3"></div>

                    <!-- Login Form -->
                    <div id="loginPane">
                        <form id="loginForm" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" id="loginReturnUrl" value="" />

                            <div class="mb-3">
                                <label class="form-label">Tên đăng nhập hoặc Email</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input type="text" name="UsernameOrEmail" class="form-control"
                                           placeholder="Nhập tên đăng nhập hoặc email"
                                           autocomplete="username" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Mật khẩu</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input type="password" name="Password" class="form-control"
                                           placeholder="Nhập mật khẩu"
                                           autocomplete="current-password" required />
                                    <button type="button" class="btn btn-outline-secondary" onclick="authTogglePwd(this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" id="loginSubmitBtn" class="btn btn-brand">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Register Form -->
                    <div id="registerPane" class="d-none">
                        <p class="text-muted small mb-3">Tạo tài khoản để gửi yêu cầu thuê phòng và nhận thông báo</p>
                        <form id="registerForm" novalidate>
                            @Html.AntiForgeryToken()
                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="form-label">Tên đăng nhập <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                                        <input type="text" name="Username" class="form-control"
                                               placeholder="nguyen_van_a" autocomplete="username" required />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Email <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                        <input type="email" name="Email" class="form-control"
                                               placeholder="email@domain.com" autocomplete="email" required />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Họ và tên</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                                        <input type="text" name="FullName" class="form-control" placeholder="Họ và tên đầy đủ" />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Số điện thoại</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                        <input type="tel" name="Phone" class="form-control" placeholder="09xxxxxxxx" />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Mật khẩu <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                        <input type="password" name="Password" class="form-control"
                                               placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" required />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                        <input type="password" name="ConfirmPassword" class="form-control"
                                               placeholder="Nhập lại mật khẩu" autocomplete="new-password" required />
                                    </div>
                                </div>
                                <div class="col-12 mt-3">
                                    <button type="submit" id="registerSubmitBtn" class="btn btn-brand w-100">
                                        <i class="bi bi-person-plus me-1"></i>Đăng ký tài khoản
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- ── AI CHATBOT WIDGET (Sạch sẽ, chuẩn Brand, không emoji) ── -->
    <div id="aiChatWidget" style="position:fixed; bottom:24px; left:24px; z-index:9998;">
        <!-- Tooltip bubble -->
        <div id="aiTooltip" style="display:none; position:absolute; bottom:64px; left:0; background:#ffffff; color:var(--gray-800); padding:8px 14px; border-radius:var(--radius-md); border:1px solid var(--border-color); box-shadow:var(--shadow-hover); font-size:var(--text-xs); font-weight:var(--font-medium); white-space:nowrap;">
            <span><i class="bi bi-robot text-danger me-1"></i>Bạn cần tư vấn tìm phòng?</span>
            <button onclick="document.getElementById('aiTooltip').style.display='none'" style="background:none; border:none; color:var(--gray-400); cursor:pointer; padding:0 0 0 6px;">&times;</button>
        </div>
        <!-- Toggle button -->
        <button id="aiToggleBtn" onclick="aiChatToggle()" title="AI Tư vấn phòng trọ"
                style="width:52px; height:52px; border-radius:50%; border:none; background-color:var(--brand-primary); color:#ffffff; font-size:1.4rem; cursor:pointer; box-shadow:var(--shadow-hover); display:flex; align-items:center; justify-content:center; transition:all var(--transition-fast);">
            <i class="bi bi-robot" id="aiToggleIcon"></i>
        </button>
        <!-- Chat panel -->
        <div id="aiPanel" class="d-none" style="position:absolute; bottom:64px; left:0; width:380px; max-width:calc(100vw - 32px); height:500px; border-radius:var(--radius-xl); overflow:hidden; border:1px solid var(--border-color); box-shadow:var(--shadow-drawer); background:#ffffff; flex-direction:column;">
            <div id="aiHeader" style="background-color:var(--brand-primary); color:#ffffff; padding:12px 16px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0;">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); display:flex; align-items:center; justify-content:center; font-size:1rem;">
                        <i class="bi bi-robot"></i>
                    </div>
                    <div>
                        <div class="fw-bold" style="font-size:0.9rem;">AI Trợ Lý Tìm Phòng</div>
                        <div style="font-size:0.7rem; opacity:0.9;"><i class="bi bi-circle-fill text-success" style="font-size:0.4rem;"></i> Sẵn sàng hỗ trợ</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button onclick="aiNewChat()" title="Làm mới" style="background:rgba(255,255,255,0.15); border:none; color:#ffffff; font-size:0.75rem; cursor:pointer; border-radius:var(--radius-sm); padding:3px 8px;">
                        <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
                    </button>
                    <button onclick="aiChatToggle()" style="background:none; border:none; color:#ffffff; font-size:1.1rem; cursor:pointer; padding:2px 4px;">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <!-- Message area -->
            <div id="aiMsgArea" style="flex:1; overflow-y:auto; padding:14px; background-color:var(--color-bg-page); display:flex; flex-direction:column; gap:10px;">
                <div id="aiWelcome" class="text-center p-3 my-auto">
                    <div class="mb-2 text-danger fs-3"><i class="bi bi-buildings"></i></div>
                    <div class="fw-bold mb-1" style="font-size:0.95rem; color:var(--gray-900);">Xin chào! Tôi có thể giúp gì cho bạn?</div>
                    <p class="text-muted small mb-3">Tư vấn chọn khu vực, khoảng giá, tiện ích và giải đáp thắc mắc thuê phòng.</p>
                    <div class="d-flex flex-wrap gap-1 justify-content-center">
                        <button class="btn btn-neutral btn-sm" onclick="aiSendQuick('Có phòng trống nào tại Hà Nội không?')"><i class="bi bi-search me-1"></i>Phòng trống</button>
                        <button class="btn btn-neutral btn-sm" onclick="aiSendQuick('Tìm phòng giá rẻ dưới 3 triệu')"><i class="bi bi-cash me-1"></i>Dưới 3 triệu</button>
                        <button class="btn btn-neutral btn-sm" onclick="aiSendQuick('Phòng có ban công và máy lạnh')"><i class="bi bi-wind me-1"></i>Có máy lạnh</button>
                    </div>
                </div>
            </div>
            <!-- Input area -->
            <div id="aiInputArea" style="padding:10px 12px; background:#ffffff; border-top:1px solid var(--border-color); flex-shrink:0;">
                <div class="d-flex gap-2 align-items-center">
                    <input type="text" id="aiInput" class="form-control" placeholder="Nhập câu hỏi tìm phòng..." autocomplete="off"
                           style="border-radius:var(--radius-pill); font-size:0.85rem;"
                           onkeydown="if(event.key==='Enter'){event.preventDefault();aiSend();}">
                    <button id="aiSendBtn" onclick="aiSend()" class="btn btn-brand" style="border-radius:50%; width:36px; height:36px; padding:0; flex-shrink:0;">
                        <i class="bi bi-send-fill" style="font-size:0.85rem;"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ── JavaScript Helpers ────────────────────────────────────── -->
    <script>
        // ── Favorite Toggle & LocalStorage Sync ────────────────────────
        async function toggleFavorite(roomId, btn) {
            try {
                const res = await fetch('/api/favorites/toggle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ roomId: roomId })
                });
                const data = await res.json();
                const icon = btn.querySelector('i');

                if (data.requireLogin) {
                    // Xử lý tạm bằng localStorage cho khách vãng lai
                    let localFavs = JSON.parse(localStorage.getItem('saved_rooms') || '[]');
                    const idx = localFavs.indexOf(roomId);
                    let isNowFav = false;
                    if (idx >= 0) {
                        localFavs.splice(idx, 1);
                    } else {
                        localFavs.push(roomId);
                        isNowFav = true;
                    }
                    localStorage.setItem('saved_rooms', JSON.stringify(localFavs));

                    if (isNowFav) {
                        icon.className = 'bi bi-heart-fill text-danger';
                        btn.classList.add('active');
                        alertToast('Đã lưu phòng vào thiết bị này! Đăng nhập để đồng bộ vĩnh viễn.');
                    } else {
                        icon.className = 'bi bi-heart';
                        btn.classList.remove('active');
                        alertToast('Đã bỏ lưu phòng trên thiết bị.');
                    }
                    return;
                }

                if (data.success) {
                    if (data.isFavorite) {
                        icon.className = 'bi bi-heart-fill text-danger';
                        btn.classList.add('active');
                    } else {
                        icon.className = 'bi bi-heart';
                        btn.classList.remove('active');
                    }
                    alertToast(data.message);
                }
            } catch (err) {
                console.error(err);
            }
        }

        function alertToast(msg) {
            let container = document.getElementById('toast-container-global');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-container-global';
                container.style.cssText = 'position:fixed; bottom:24px; left:50%; transform:translateX(-50%); z-index:9999; display:flex; flex-direction:column; gap:8px; pointer-events:none;';
                document.body.appendChild(container);
            }
            const toast = document.createElement('div');
            toast.className = 'shadow border rounded-pill px-3 py-2 text-white bg-dark small';
            toast.style.cssText = 'pointer-events:auto; transition:opacity 200ms ease; opacity:0;';
            toast.textContent = msg;
            container.appendChild(toast);
            requestAnimationFrame(() => toast.style.opacity = '1');
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 200);
            }, 2500);
        }

        // Tự động kiểm tra localStorage để hiển thị trạng thái tim cho khách
        document.addEventListener('DOMContentLoaded', function() {
            try {
                const localFavs = JSON.parse(localStorage.getItem('saved_rooms') || '[]');
                if (localFavs.length > 0) {
                    localFavs.forEach(function(rId) {
                        const card = document.querySelector('.room-card[data-room-id="' + rId + '"]');
                        if (card) {
                            const btn = card.querySelector('.room-card-favorite-btn');
                            if (btn && !btn.classList.contains('active')) {
                                btn.classList.add('active');
                                const i = btn.querySelector('i');
                                if (i) i.className = 'bi bi-heart-fill text-danger';
                            }
                        }
                    });
                }
            } catch(e) {}
        });

        function authTogglePwd(btn) {
            var input = btn.previousElementSibling;
            var icon  = btn.querySelector('i');
            input.type = (input.type === 'password') ? 'text' : 'password';
            icon.className = (input.type === 'text') ? 'bi bi-eye-slash' : 'bi bi-eye';
        }

        function authShowAlert(type, msg) {
            var el = document.getElementById('authAlert');
            el.className = 'alert alert-' + type + ' py-2 small mb-3';
            el.textContent = msg;
        }

        function authClearAlert() {
            var el = document.getElementById('authAlert');
            el.className = 'd-none alert py-2 small mb-3';
            el.textContent = '';
        }

        function authSwitchTab(tab) {
            document.querySelectorAll('[data-auth-tab]').forEach(function(btn) {
                btn.classList.toggle('active', btn.dataset.authTab === tab);
            });
            document.getElementById('loginPane').classList.toggle('d-none', tab !== 'login');
            document.getElementById('registerPane').classList.toggle('d-none', tab !== 'register');
            authClearAlert();
        }

        document.querySelectorAll('[data-auth-tab]').forEach(function(btn) {
            btn.addEventListener('click', function() { authSwitchTab(this.dataset.authTab); });
        });

        document.getElementById('authModal').addEventListener('show.bs.modal', function(e) {
            var tab = e.relatedTarget && e.relatedTarget.dataset.openTab;
            authSwitchTab(tab === 'register' ? 'register' : 'login');
            document.getElementById('loginForm').reset();
            document.getElementById('registerForm').reset();
        });

        document.getElementById('loginForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            authClearAlert();
            var btn = document.getElementById('loginSubmitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý...';

            try {
                var res = await fetch('/Account/LoginModal', { method: 'POST', body: new FormData(this) });
                var data = await res.json();
                if (data.success) {
                    window.location.href = data.redirectUrl || window.location.href;
                } else {
                    authShowAlert('danger', data.message || 'Đăng nhập không thành công.');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập';
                }
            } catch {
                authShowAlert('danger', 'Đã xảy ra lỗi kết nối.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập';
            }
        });

        document.getElementById('registerForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            authClearAlert();
            var btn = document.getElementById('registerSubmitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý...';

            try {
                var res = await fetch('/Account/RegisterModal', { method: 'POST', body: new FormData(this) });
                var data = await res.json();
                if (data.success) {
                    authShowAlert('success', data.message || 'Đăng ký thành công!');
                    setTimeout(function() { authSwitchTab('login'); }, 1200);
                } else {
                    authShowAlert('danger', data.message || 'Đăng ký không thành công.');
                }
            } catch {
                authShowAlert('danger', 'Đã xảy ra lỗi kết nối.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-person-plus me-1"></i>Đăng ký tài khoản';
            }
        });

        // ── AI Chat Script ──────────────────────────────────────────
        (function(){
            let _aiOpen = false, _aiWaiting = false;

            window.aiChatToggle = function(){
                const panel = document.getElementById('aiPanel');
                _aiOpen = !_aiOpen;
                panel.classList.toggle('d-none', !_aiOpen);
                panel.style.display = _aiOpen ? 'flex' : 'none';
                document.getElementById('aiToggleIcon').className = _aiOpen ? 'bi bi-x-lg' : 'bi bi-robot';
                document.getElementById('aiTooltip').style.display = 'none';
                if(_aiOpen) document.getElementById('aiInput').focus();
            };

            window.aiSendQuick = function(text){
                document.getElementById('aiInput').value = text;
                aiSend();
            };

            window.aiNewChat = function(){
                const area = document.getElementById('aiMsgArea');
                area.innerHTML = '';
                const welcome = document.createElement('div');
                welcome.id = 'aiWelcome';
                welcome.className = 'text-center p-3 my-auto';
                welcome.innerHTML =
                    '<div class="mb-2 text-danger fs-3"><i class="bi bi-buildings"></i></div>' +
                    '<div class="fw-bold mb-1" style="font-size:0.95rem; color:var(--gray-900);">Xin chào! Tôi có thể giúp gì cho bạn?</div>' +
                    '<p class="text-muted small mb-3">Tư vấn chọn khu vực, khoảng giá, tiện ích và giải đáp thắc mắc thuê phòng.</p>' +
                    '<div class="d-flex flex-wrap gap-1 justify-content-center">' +
                        '<button class="btn btn-neutral btn-sm" onclick="aiSendQuick(\'Có phòng trống nào tại Hà Nội không?\')"><i class="bi bi-search me-1"></i>Phòng trống</button>' +
                        '<button class="btn btn-neutral btn-sm" onclick="aiSendQuick(\'Tìm phòng giá rẻ dưới 3 triệu\')"><i class="bi bi-cash me-1"></i>Dưới 3 triệu</button>' +
                        '<button class="btn btn-neutral btn-sm" onclick="aiSendQuick(\'Phòng có ban công và máy lạnh\')"><i class="bi bi-wind me-1"></i>Có máy lạnh</button>' +
                    '</div>';
                area.appendChild(welcome);
                _aiWaiting = false;
                document.getElementById('aiSendBtn').disabled = false;
                document.getElementById('aiInput').value = '';
                document.getElementById('aiInput').focus();
            };

            window.aiSend = async function(){
                const inp = document.getElementById('aiInput');
                const text = inp.value.trim();
                if(!text || _aiWaiting) return;

                const w = document.getElementById('aiWelcome');
                if(w) w.remove();

                aiAppend('user', text);
                inp.value = '';
                inp.focus();

                const typing = aiShowTyping();
                _aiWaiting = true;
                document.getElementById('aiSendBtn').disabled = true;

                // Lấy ngữ cảnh phòng nếu khách đang xem chi tiết phòng
                const roomCtx = document.getElementById('room-detail-context');
                const currentRoomId = roomCtx && roomCtx.dataset.roomId ? parseInt(roomCtx.dataset.roomId) : null;

                try {
                    const res = await fetch('/api/chat/ask', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: text, currentRoomId: currentRoomId })
                    });
                    const data = await res.json();
                    typing.remove();
                    aiAppend('bot', data.success ? data.reply : (data.reply || 'Xin lỗi, tôi chưa hiểu yêu cầu của bạn.'));
                } catch(err) {
                    typing.remove();
                    aiAppend('bot', 'Không thể kết nối tới máy chủ AI. Vui lòng thử lại sau.');
                } finally {
                    _aiWaiting = false;
                    document.getElementById('aiSendBtn').disabled = false;
                }
            };

            function aiAppend(role, text) {
                const area = document.getElementById('aiMsgArea');
                const div = document.createElement('div');
                div.className = 'd-flex gap-2 ' + (role === 'user' ? 'justify-content-end' : 'justify-content-start');
                const bubbleStyle = role === 'user' 
                    ? 'background-color:var(--brand-primary); color:#ffffff; border-radius:14px 14px 2px 14px;' 
                    : 'background-color:#ffffff; color:var(--gray-900); border:1px solid var(--border-color); border-radius:14px 14px 14px 2px;';
                
                // Parse markdown link [text](url) -> <a href="url">text</a>
                let formatted = escapeHtml(text).replace(/\n/g, '<br>');
                if (role !== 'user') {
                    formatted = formatted.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" class="fw-semibold text-decoration-underline" style="color:var(--brand-primary);">$1</a>');
                }

                div.innerHTML = '<div style="max-width:85%; padding:8px 12px; font-size:0.85rem; line-height:1.5; ' + bubbleStyle + '">' +
                                    formatted +
                                '</div>';
                area.appendChild(div);
                area.scrollTop = area.scrollHeight;
            }

            function aiShowTyping() {
                const area = document.getElementById('aiMsgArea');
                const div = document.createElement('div');
                div.className = 'd-flex justify-content-start';
                div.innerHTML = '<div style="background:#ffffff; border:1px solid var(--border-color); padding:6px 12px; border-radius:12px; font-size:0.75rem; color:var(--gray-500);">' +
                                    '<i class="bi bi-three-dots"></i> Đang tìm câu trả lời...' +
                                '</div>';
                area.appendChild(div);
                area.scrollTop = area.scrollHeight;
                return div;
            }

            function escapeHtml(s) {
                return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
            }

            setTimeout(function(){
                const tip = document.getElementById('aiTooltip');
                if(tip && !_aiOpen) tip.style.display = 'block';
            }, 3000);
        })();
    </script>
</body>
</html>
