    <style>
        .btn-auth-modal { background: linear-gradient(135deg,#27AE60,#2ECC71); border: none; color: #fff; }
        .btn-auth-modal:hover { background: linear-gradient(135deg,#1E8449,#27AE60); color: #fff; }
