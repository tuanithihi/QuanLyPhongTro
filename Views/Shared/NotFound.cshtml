@{
    ViewData["Title"] = "Không tìm thấy trang (404)";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/pages/error.css" />

<div class="error-page-container">
    <div class="error-card">
        <div class="error-code">404</div>
        <h1 class="error-heading">Không tìm thấy nội dung yêu cầu</h1>
        <p class="error-description">
            Phòng trọ hoặc trang bạn đang tìm kiếm có thể đã bị gỡ bỏ, đổi đường dẫn hoặc tạm thời không khả dụng.
        </p>
        <div class="error-actions">
            <a href="/" class="btn btn-brand">
                <i class="bi bi-house me-1"></i>Về trang chủ
            </a>
            <a href="/phong-tro" class="btn btn-neutral">
                <i class="bi bi-search me-1"></i>Tìm phòng trọ khác
            </a>
        </div>
    </div>
</div>
