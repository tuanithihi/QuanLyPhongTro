@model List<QuanLyPhongTro.Models.tblPost>
@using QuanLyPhongTro.Models
@{
    ViewData["Title"] = "Tin tức & Thông báo";
    string? category  = ViewBag.Category;
    int page          = ViewBag.Page ?? 1;
    int totalPages    = ViewBag.TotalPages ?? 1;
    int total         = ViewBag.TotalItems ?? 0;
    List<string> cats = ViewBag.Categories ?? new List<string>();
}

<section class="py-5" style="min-height:calc(100vh - 120px);">
<div class="container">

    <div class="row g-4">

        @* Cột trái: bài viết *@
        <div class="col-lg-9">
            <div class="d-flex align-items-baseline justify-content-between mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Tin tức &amp; Thông báo</h2>
                    <p class="text-secondary small mb-0">
                        @if (!string.IsNullOrEmpty(category))
                        {
                            <span>Danh mục: <strong>@category</strong> — </span>
                        }
                        Tìm thấy <strong>@total</strong> bài viết
                    </p>
                </div>
                @if (!string.IsNullOrEmpty(category))
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-x me-1"></i>Xóa lọc
                    </a>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-newspaper fs-1 d-block mb-3"></i>
                    <p>Chưa có bài viết nào.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                    @foreach (var post in Model)
                    {
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm post-card">
                                @if (!string.IsNullOrEmpty(post.ThumbnailImage))
                                {
                                    <div class="post-card-img-wrap overflow-hidden">
                                        <img src="@post.ThumbnailImage" alt="@post.Title"
                                             class="card-img-top post-card-img"
                                             style="height:180px;object-fit:cover;" />
                                    </div>
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center"
                                         style="height:180px;">
                                        <i class="bi bi-newspaper text-secondary fs-1"></i>
                                    </div>
                                }
                                <div class="card-body d-flex flex-column p-3">
                                    @if (!string.IsNullOrEmpty(post.Category))
                                    {
                                        <a asp-action="Index" asp-route-category="@post.Category"
                                           class="badge bg-primary text-decoration-none mb-2 align-self-start">
                                            @post.Category
                                        </a>
                                    }
                                    @if (post.IsPinned)
                                    {
                                        <span class="badge bg-warning text-dark mb-2 align-self-start">
                                            <i class="bi bi-pin-fill me-1"></i>Ghim
                                        </span>
                                    }
                                    <h6 class="fw-bold mb-2 lh-sm">
                                        <a asp-action="Detail" asp-route-slug="@post.Slug"
                                           class="text-dark text-decoration-none stretched-link">
                                            @post.Title
                                        </a>
                                    </h6>
                                    @if (!string.IsNullOrEmpty(post.Summary))
                                    {
                                        <p class="card-text text-secondary small flex-fill mb-2">@post.Summary</p>
                                    }
                                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                        <small class="text-muted">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            @(post.PublishedAt?.ToString("dd/MM/yyyy") ?? post.CreatedAt.ToString("dd/MM/yyyy"))
                                        </small>
                                        <small class="text-muted">
                                            <i class="bi bi-eye me-1"></i>@post.ViewCount
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* Phân trang *@
                @if (totalPages > 1)
                {
                    <nav class="d-flex justify-content-center mt-5">
                        <ul class="pagination">
                            @for (int p = 1; p <= totalPages; p++)
                            {
                                <li class="page-item @(p == page ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-page="@p" asp-route-category="@category">@p</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>

        @* Cột phải: sidebar *@
        <div class="col-lg-3">
            @if (cats.Any())
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white fw-semibold py-3">Lọc danh mục</div>
                    <div class="card-body py-3">
                        <select id="catSelect" class="form-select"
                                onchange="if(this.value) window.location='/Blog?category='+encodeURIComponent(this.value); else window.location='/Blog';">
                            <option value="">-- Tất cả danh mục --</option>
                            @foreach (var cat in cats)
                            {
                                if (category == cat)
                                {
                                    <option value="@cat" selected>@cat</option>
                                }
                                else
                                {
                                    <option value="@cat">@cat</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            }
        </div>

    </div>
</div>
</section>

@section Scripts {
<style>
    .post-card { border-radius:.75rem; overflow:hidden; transition:transform .2s,box-shadow .2s; }
    .post-card:hover { transform:translateY(-4px); box-shadow:0 8px 24px rgba(0,0,0,.12)!important; }
    .post-card-img { transition:transform .4s; }
    .post-card-img-wrap:hover .post-card-img { transform:scale(1.05); }
</style>
}
