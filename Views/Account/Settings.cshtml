@model QuanLyThuVien.Models.tblUser

@{
    ViewData["Title"] = "Cài đặt tài khoản";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h4 class="mb-0"><i class="fas fa-user"></i> Cài đặt tài khoản</h4>
    </div>

    <div class="container shadow p-5">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form asp-action="Settings" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="row mb-4">
                <div class="col-md-3 text-center">
                    @if (!string.IsNullOrEmpty(Model.Avatar))
                    {
                        <img id="avatarPreview" src="@Model.Avatar" alt="Avatar" class="rounded-circle border mb-3" style="width: 150px; height: 150px; object-fit: cover;">
                    }
                    else
                    {
                        <div id="avatarPreview" class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 150px; height: 150px;">
                            <i class="fas fa-user text-white" style="font-size: 60px;"></i>
                        </div>
                    }
                    <div class="mt-2">
                        <label for="AvatarFile" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-camera"></i> Chọn ảnh đại diện
                        </label>
                        <input type="file" id="AvatarFile" name="AvatarFile" class="d-none" accept="image/*" onchange="previewAvatar()">
                    </div>
                </div>

                <div class="col-md-9">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th style="width:200px;">Tên đăng nhập</th>
                                <td class="disabled-field">
                                    <input asp-for="UserName" class="form-control" readonly style="background-color: #f8f9fa; opacity: 0.6;">
                                </td>
                            </tr>
                            <tr>
                                <th>Họ và tên <span class="text-danger">*</span></th>
                                <td>
                                    <input asp-for="FullName" class="form-control" required>
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </td>
                            </tr>
                            <tr>
                                <th>Email <span class="text-danger">*</span></th>
                                <td>
                                    <input asp-for="Email" type="email" class="form-control" required>
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </td>
                            </tr>
                            <tr>
                                <th>Số điện thoại</th>
                                <td>
                                    <input asp-for="Phone" type="tel" class="form-control" placeholder="0xxxxxxxxx hoặc +84xxxxxxxxx">
                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                </td>
                            </tr>
                            <tr>
                                <th>Ngày sinh</th>
                                <td>
                                    <input asp-for="DateOfBirth" type="date" class="form-control">
                                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                                </td>
                            </tr>
                            <tr>
                                <th>Vai trò</th>
                                <td class="disabled-field">
                                    <input type="text" class="form-control" value="@Model.Role" readonly style="background-color: #f8f9fa; opacity: 0.6;">
                                </td>
                            </tr>
                            <tr>
                                <th>Trạng thái</th>
                                <td class="disabled-field">
                                    <input type="text" class="form-control" value="@(Model.IsActive == true ? "Hoạt động" : "Bị khóa")" readonly style="background-color: #f8f9fa; opacity: 0.6;">
                                </td>
                            </tr>
                            <tr>
                                <th>Ngày tạo tài khoản</th>
                                <td class="disabled-field">
                                    <input type="text" class="form-control" value="@(Model.CreatedDate.HasValue ? Model.CreatedDate.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")" readonly style="background-color: #f8f9fa; opacity: 0.6;">
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="text-end mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Lưu thay đổi
                </button>
                <a href="@Url.Action("Info", "Account")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    <script>
        function previewAvatar() {
            const file = document.getElementById('AvatarFile').files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('avatarPreview').src = e.target.result;
                    document.getElementById('avatarPreview').className = 'rounded-circle border mb-3';
                    document.getElementById('avatarPreview').style.width = '150px';
                    document.getElementById('avatarPreview').style.height = '150px';
                    document.getElementById('avatarPreview').style.objectFit = 'cover';
                }
                reader.readAsDataURL(file);
            }
        }
    </script>
}

<style>
    .disabled-field {
        background-color: rgba(0, 0, 0, 0.05);
        position: relative;
    }
    .disabled-field::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.1);
        pointer-events: none;
    }
</style>