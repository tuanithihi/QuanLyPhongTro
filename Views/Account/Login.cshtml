@model QuanLyThuVien.Models.tblUser
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["Description"] = "Đăng nhập vào hệ thống thư viện số LibraHub";
}

<main class="main">
    <div class="container">
        <section class="section register min-vh-100 d-flex flex-column align-items-center justify-content-center py-4">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-4 col-md-6 d-flex flex-column align-items-center justify-content-center">

                        <div class="d-flex justify-content-center py-4">
                            <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center w-auto">
                                <img src="~/assets/img/logo.webp" alt="LibraHub Logo" style="height: 40px;" class="me-2">
                                <span class="d-none d-lg-block sitename">LibraHub</span>
                            </a>
                        </div>

                        <div class="card mb-3 w-100">
                            <div class="card-body">
                                <div class="pt-4 pb-2">
                                    <h5 class="card-title text-center pb-0 fs-4">Đăng nhập</h5>
                                    <p class="text-center small">Nhập thông tin đăng nhập của bạn</p>
                                </div>

                                @if (TempData["SuccessMessage"] != null)
                                {
                                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                                        @TempData["SuccessMessage"]
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                    </div>
                                }

                                @if (TempData["ErrorMessage"] != null)
                                {
                                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                        @TempData["ErrorMessage"]
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                    </div>
                                }

                                <form class="row g-3 needs-validation" novalidate asp-controller="Account" asp-action="Login" method="post">
                                    @Html.AntiForgeryToken()

                                    <div class="col-12">
                                        <label for="UserName" class="form-label">Tên đăng nhập</label>
                                        <div class="input-group has-validation">
                                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                                            <input type="text" name="UserName" class="form-control" id="UserName" required asp-for="UserName" placeholder="Nhập tên đăng nhập">
                                            <div class="invalid-feedback">Vui lòng nhập tên đăng nhập.</div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <label for="Password" class="form-label">Mật khẩu</label>
                                        <div class="input-group has-validation">
                                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                            <input type="password" name="Password" class="form-control" id="Password" required asp-for="Password" placeholder="Nhập mật khẩu">
                                            <div class="invalid-feedback">Vui lòng nhập mật khẩu!</div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="remember" value="true" id="rememberMe">
                                            <label class="form-check-label" for="rememberMe">Ghi nhớ đăng nhập</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <button class="btn btn-primary w-100" type="submit">
                                            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                                        </button>
                                    </div>

                                    <div class="col-12">
                                        <p class="text-center small mb-0">
                                            <a asp-controller="Account" asp-action="ForgotPassword" class="fw-bold text-primary">Quên mật khẩu?</a>
                                        </p>
                                    </div>

                                    <div class="col-12">
                                        <p class="text-center small mb-0">
                                            Chưa có tài khoản? 
                                            <a asp-controller="Account" asp-action="Register" class="fw-bold">Đăng ký ngay</a>
                                        </p>
                                    </div>

                                    <div class="col-12">
                                        <hr class="my-3">
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="credits text-center">
                            <p class="small text-muted">
                                Quay lại <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                            </p>
                        </div>

                    </div>
                </div>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


