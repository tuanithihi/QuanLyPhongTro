@model QuanLyThuVien.Models.tblCategory
@{
    ViewData["Title"] = "Xác nhận xóa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Xác nhận xóa danh mục</h2>
        <h3 class="text-danger">Bạn có chắc chắn muốn xóa danh mục này?</h3>
    </div>
    
    <section class="section dashboard">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Thông tin danh mục: @Model.CategoryName</h5>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label fw-bold">Tên danh mục:</label>
                            <div class="col-sm-10">
                                @Html.DisplayFor(model => model.CategoryName)
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label fw-bold">Mô tả:</label>
                            <div class="col-sm-10">
                                @Html.DisplayFor(model => model.Description)
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label fw-bold">Ngày tạo:</label>
                            <div class="col-sm-10">
                                @Html.DisplayFor(model => model.CreatedAt)
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label fw-bold">Hoạt động:</label>
                            <div class="col-sm-10">
                                @Html.DisplayFor(model => model.IsActive)
                            </div>
                        </div>

                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="CategoryID" />

                            <div class="row mb-3">
                                <div class="col-sm-10 offset-sm-2">
                                    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
                                    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                                </div>
                            </div>
                        </form>
                        </div>
                </div>
            </div>
        </div>
    </section>
</main>