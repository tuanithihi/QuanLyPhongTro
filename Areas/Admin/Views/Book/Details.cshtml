@model QuanLyThuVien.Models.tblBook
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Chi tiết sách";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2><i class="bi bi-book me-2"></i>Chi tiết sách</h2>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Book" asp-action="Index">Quản lý sách</a></li>
                <li class="breadcrumb-item active">Chi tiết</li>
            </ol>
        </nav>
    </div>

    <section class="section dashboard">
        <div class="row">
            <div class="col-lg-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-info-circle me-2"></i>Thông tin sách
                        </h5>
                        <div class="btn-group">
                            <a asp-area="Admin" asp-controller="Book" asp-action="Edit" asp-route-id="@Model.BookID" 
                               class="btn btn-light btn-sm">
                                <i class="bi bi-pencil me-1"></i>Chỉnh sửa
                            </a>
                            <a asp-area="Admin" asp-controller="Book" asp-action="Index" 
                               class="btn btn-light btn-sm">
                                <i class="bi bi-arrow-left-circle me-1"></i>Quay lại
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 text-center mb-4">
                                @if (!string.IsNullOrEmpty(Model.CoverImage))
                                {
                                    <img src="@Model.CoverImage" alt="@Model.Title" 
                                         class="img-fluid shadow rounded" 
                                         style="max-width: 100%; max-height: 450px; object-fit: cover; border: 3px solid #dee2e6;" />
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center shadow rounded" 
                                         style="width: 100%; height: 450px; border: 3px solid #dee2e6;">
                                        <div class="text-center">
                                            <i class="bi bi-image text-muted" style="font-size: 5rem;"></i>
                                            <p class="text-muted mt-3 fs-5">Chưa có ảnh bìa</p>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="col-md-8">
                                <div class="table-responsive">
                                    <table class="table table-borderless">
                                        <tbody>
                                            <tr>
                                                <th class="text-muted" style="width: 180px; vertical-align: middle;">
                                                    <i class="bi bi-bookmark me-2"></i>Tên sách:
                                                </th>
                                                <td>
                                                    <h4 class="mb-0 fw-bold text-primary">@Model.Title</h4>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted" style="vertical-align: middle;">
                                                    <i class="bi bi-tags me-2"></i>Danh mục:
                                                </th>
                                                <td>
                                                    <span class="badge bg-info fs-6 px-3 py-2">@(Model.Category?.CategoryName ?? "N/A")</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted" style="vertical-align: middle;">
                                                    <i class="bi bi-building me-2"></i>Nhà xuất bản:
                                                </th>
                                                <td>
                                                    <span class="fs-6 fw-semibold">@(Model.Publisher?.PublisherName ?? "N/A")</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted" style="vertical-align: middle;">
                                                    <i class="bi bi-calendar-event me-2"></i>Năm xuất bản:
                                                </th>
                                                <td>
                                                    <span class="badge bg-primary fs-6 px-3 py-2">@Model.PublishedYear</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted" style="vertical-align: middle;">
                                                    <i class="bi bi-stack me-2"></i>Số lượng:
                                                </th>
                                                <td>
                                                    @if (Model.Quantity > 0)
                                                    {
                                                        <span class="badge bg-success fs-6 px-3 py-2">@Model.Quantity cuốn</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger fs-6 px-3 py-2">Hết sách</span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted" style="vertical-align: middle;">
                                                    <i class="bi bi-toggle-on me-2"></i>Trạng thái:
                                                </th>
                                                <td>
                                                    @if (Model.IsActive == true)
                                                    {
                                                        <span class="badge bg-success fs-6 px-3 py-2">
                                                            <i class="bi bi-check-circle me-1"></i>Hoạt động
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary fs-6 px-3 py-2">
                                                            <i class="bi bi-x-circle me-1"></i>Ngừng
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted" style="vertical-align: top;">
                                                    <i class="bi bi-people me-2"></i>Tác giả:
                                                </th>
                                                <td>
                                                    @if (Model.BookAuthors != null && Model.BookAuthors.Any())
                                                    {
                                                        <div class="d-flex flex-wrap gap-2">
                                                            @foreach (var bookAuthor in Model.BookAuthors)
                                                            {
                                                                <span class="badge bg-secondary fs-6 px-3 py-2">
                                                                    <i class="bi bi-person me-1"></i>@(bookAuthor.Author?.AuthorName ?? "N/A")
                                                                </span>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Chưa có tác giả</span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted" style="vertical-align: middle;">
                                                    <i class="bi bi-clock me-2"></i>Ngày tạo:
                                                </th>
                                                <td>
                                                    <span class="text-muted fs-6">
                                                        <i class="bi bi-calendar3 me-1"></i>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                                    </span>
                                                </td>
                                            </tr>
                                            @if (!string.IsNullOrEmpty(Model.Description))
                                            {
                                                <tr>
                                                    <th class="text-muted" style="vertical-align: top;">
                                                        <i class="bi bi-file-text me-2"></i>Mô tả:
                                                    </th>
                                                    <td>
                                                        <div class="p-3 bg-light rounded border">
                                                            <p class="mb-0 text-justify">@Model.Description</p>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            @if (!string.IsNullOrEmpty(Model.BookFile))
                                            {
                                                <tr>
                                                    <th class="text-muted" style="vertical-align: top;">
                                                        <i class="bi bi-file-pdf me-2"></i>File PDF:
                                                    </th>
                                                    <td>
                                                        <div class="d-flex gap-2 mb-2">
                                                            <a href="@Model.BookFile" target="_blank" class="btn btn-danger btn-sm">
                                                                <i class="bi bi-download me-1"></i>Tải xuống PDF
                                                            </a>
                                                            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#pdfViewerModal">
                                                                <i class="bi bi-eye me-1"></i>Xem trước
                                                            </button>
                                                        </div>
                                                        <small class="text-muted">
                                                            <i class="bi bi-info-circle me-1"></i>
                                                            @System.IO.Path.GetFileName(Model.BookFile)
                                                        </small>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<!-- PDF Viewer Modal -->
@if (!string.IsNullOrEmpty(Model.BookFile))
{
    <div class="modal fade" id="pdfViewerModal" tabindex="-1" aria-labelledby="pdfViewerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="pdfViewerModalLabel">
                        <i class="bi bi-file-pdf me-2"></i>Xem trước: @Model.Title
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <iframe src="@Model.BookFile" 
                            style="width: 100%; height: 100%; min-height: 80vh; border: none;" 
                            frameborder="0">
                    </iframe>
                </div>
                <div class="modal-footer bg-light">
                    <a href="@Model.BookFile" target="_blank" class="btn btn-danger">
                        <i class="bi bi-download me-1"></i>Tải xuống
                    </a>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
}
