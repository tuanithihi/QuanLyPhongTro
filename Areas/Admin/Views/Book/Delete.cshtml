@model QuanLyThuVien.Models.tblBook
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Xóa sách";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2><i class="bi bi-exclamation-triangle me-2 text-danger"></i>Xóa sách</h2>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Book" asp-action="Index">Quản lý sách</a></li>
                <li class="breadcrumb-item active">Xóa</li>
            </ol>
        </nav>
    </div>

    <section class="section dashboard">
        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <div class="card border-danger">
                    <div class="card-body">
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Bạn có chắc chắn muốn xóa sách này?</strong> Hành động này không thể hoàn tác.
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-4 text-center">
                                @if (!string.IsNullOrEmpty(Model.CoverImage))
                                {
                                    <img src="@Model.CoverImage" alt="@Model.Title" 
                                         class="img-thumbnail" style="max-width: 200px; max-height: 300px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center" 
                                         style="width: 200px; height: 300px; margin: 0 auto;">
                                        <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                                    </div>
                                }
                            </div>
                            <div class="col-md-8">
                                <dl class="row">
                                    <dt class="col-sm-4">Tên sách:</dt>
                                    <dd class="col-sm-8"><strong>@Model.Title</strong></dd>

                                    <dt class="col-sm-4">Danh mục:</dt>
                                    <dd class="col-sm-8">
                                        <span class="badge bg-info">@(Model.Category?.CategoryName ?? "N/A")</span>
                                    </dd>

                                    <dt class="col-sm-4">Nhà xuất bản:</dt>
                                    <dd class="col-sm-8">@(Model.Publisher?.PublisherName ?? "N/A")</dd>

                                    <dt class="col-sm-4">Tác giả:</dt>
                                    <dd class="col-sm-8">
                                        @if (Model.BookAuthors != null && Model.BookAuthors.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var bookAuthor in Model.BookAuthors)
                                                {
                                                    <span class="badge bg-secondary">@(bookAuthor.Author?.AuthorName ?? "N/A")</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa có tác giả</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-4">Năm xuất bản:</dt>
                                    <dd class="col-sm-8">@Model.PublishedYear</dd>

                                    <dt class="col-sm-4">Số lượng:</dt>
                                    <dd class="col-sm-8">
                                        @if (Model.Quantity > 0)
                                        {
                                            <span class="badge bg-success">@Model.Quantity</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Hết sách</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-4">Trạng thái:</dt>
                                    <dd class="col-sm-8">
                                        @if (Model.IsActive == true)
                                        {
                                            <span class="badge bg-success">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Ngừng</span>
                                        }
                                    </dd>

                                    @if (!string.IsNullOrEmpty(Model.Description))
                                    {
                                        <dt class="col-sm-4">Mô tả:</dt>
                                        <dd class="col-sm-8">@Model.Description</dd>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.BookFile))
                                    {
                                        <dt class="col-sm-4">File PDF:</dt>
                                        <dd class="col-sm-8">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-file-pdf text-danger fs-5"></i>
                                                <a href="@Model.BookFile" target="_blank" class="text-decoration-none">
                                                    <strong>@System.IO.Path.GetFileName(Model.BookFile)</strong>
                                                </a>
                                            </div>
                                        </dd>
                                    }
                                </dl>
                            </div>
                        </div>

                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="BookID" />
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-area="Admin" asp-controller="Book" asp-action="Index" 
                                   class="btn btn-secondary">
                                    <i class="bi bi-arrow-left-circle me-1"></i>Hủy bỏ
                                </a>
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash me-1"></i>Xác nhận xóa
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

