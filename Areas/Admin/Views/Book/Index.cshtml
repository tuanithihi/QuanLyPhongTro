@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<QuanLyThuVien.Models.tblBook>

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Kho sách";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2><i class="bi bi-book-half me-2"></i>Kho sách</h2>
        <nav>
            <ol class="breadcrumb">
               <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a>
                </li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Book" asp-action="Index">Quản lý
                        sách</a></li>
                <li class="breadcrumb-item active">Kho sách</li>
            </ol>
        </nav>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <section class="section dashboard">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-list-ul me-2"></i>Kho sách
                            </h5>
                            <a class="btn btn-primary" asp-area="Admin" asp-controller="Book" asp-action="Create">
                                <i class="bi bi-plus-circle me-1"></i>Thêm sách mới
                            </a>
                        </div>

                        <!-- Bộ lọc và tìm kiếm -->
                        <form method="get" asp-action="Index" class="row g-3 mb-4">
                            <div class="col-md-3">
                                <label class="form-label">Tìm kiếm theo tên sách</label>
                                <input type="text" name="searchString" class="form-control" value="@ViewBag.SearchString" placeholder="Nhập tên sách...">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Danh mục</label>
                                <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                                    <option value="">Tất cả danh mục</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Nhà xuất bản</label>
                                <select name="publisherId" class="form-select" asp-items="ViewBag.Publishers">
                                    <option value="">Tất cả nhà xuất bản</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Tác giả</label>
                                <select name="authorId" class="form-select" asp-items="ViewBag.Authors">
                                    <option value="">Tất cả tác giả</option>
                                </select>
                            </div>
                            <div class="col-md-3 d-flex align-items-end gap-2">
                                <button type="submit" class="btn btn-primary flex-fill">
                                    <i class="bi bi-search me-1"></i>Tìm kiếm
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                                    <i class="bi bi-x-circle"></i>
                                </a>
                            </div>
                        </form>

                        <!-- Bảng danh sách -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 80px;">Ảnh bìa</th>
                                        <th>Tên sách</th>
                                        <th>Tác giả</th>
                                        <th>Danh mục</th>
                                        <th>Nhà xuất bản</th>
                                        <th class="text-center">Năm XB</th>
                                        <th class="text-center">Số lượng</th>
                                        <th class="text-center">Trạng thái</th>
                                        <th class="text-center" style="width: 150px;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Count > 0)
                                    {
                                        int stt = (Model.PageNumber - 1) * Model.PageSize + 1;
                                        foreach (var book in Model)
                                        {
                                            <tr>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(book.CoverImage))
                                                    {
                                                        <img src="@book.CoverImage" alt="@book.Title" class="img-thumbnail" style="width: 60px; height: 80px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light d-flex align-items-center justify-content-center" style="width: 60px; height: 80px;">
                                                            <i class="bi bi-image text-muted"></i>
                                                        </div>
                                                    }
                                                </td>
                                                <td>
                                                    <strong>@book.Title</strong>
                                                    @if (!string.IsNullOrEmpty(book.Description))
                                                    {
                                                        <br>
                                                        <small class="text-muted text-truncate d-block" style="max-width: 300px;" title="@book.Description">
                                                            @(book.Description.Length > 50 ? book.Description.Substring(0, 50) + "..." : book.Description)
                                                        </small>
                                                    }
                                                </td>
                                                <td>
                                                    @if (book.BookAuthors != null && book.BookAuthors.Any())
                                                    {
                                                        <div class="d-flex flex-wrap gap-1">
                                                            @foreach (var bookAuthor in book.BookAuthors.Take(2))
                                                            {
                                                                <span class="badge bg-secondary small">@(bookAuthor.Author?.AuthorName ?? "N/A")</span>
                                                            }
                                                            @if (book.BookAuthors.Count() > 2)
                                                            {
                                                                <span class="badge bg-light text-dark small" title="@string.Join(", ", book.BookAuthors.Skip(2).Select(ba => ba.Author?.AuthorName))">
                                                                    +@(book.BookAuthors.Count() - 2)
                                                                </span>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Chưa có tác giả</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-info">@(book.Category?.CategoryName ?? "N/A")</span>
                                                </td>
                                                <td>@(book.Publisher?.PublisherName ?? "N/A")</td>
                                                <td class="text-center">@book.PublishedYear</td>
                                                <td class="text-center">
                                                    @if (book.Quantity > 0)
                                                    {
                                                        <span class="badge bg-success">@book.Quantity</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Hết sách</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (book.IsActive == true)
                                                    {
                                                        <span class="badge bg-success">Hoạt động</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Ngừng</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group" role="group">
                                                        <a asp-area="Admin" asp-controller="Book" asp-action="Details" asp-route-id="@book.BookID"
                                                           class="btn btn-sm btn-info" title="Chi tiết">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <a asp-area="Admin" asp-controller="Book" asp-action="Edit" asp-route-id="@book.BookID"
                                                           class="btn btn-sm btn-primary" title="Sửa">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <a asp-area="Admin" asp-controller="Book" asp-action="Delete" asp-route-id="@book.BookID"
                                                           class="btn btn-sm btn-danger" title="Xóa">
                                                            <i class="bi bi-trash"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                            stt++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center text-muted py-4">
                                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                                Không có sách nào.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Phân trang -->
                        @if (Model != null && Model.PageCount > 1)
                        {
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="text-muted">
                                    Hiển thị @((Model.PageNumber - 1) * Model.PageSize + 1) - @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItemCount)) 
                                    trong tổng số @Model.TotalItemCount sách
                                </div>
                                <ul class="pagination mb-0">
                                    <pager class="pager-container"
                                           list="@Model"
                                           options="@PagedListRenderOptions.Bootstrap4PageNumbersOnly"
                                           asp-area="Admin"
                                           asp-controller="Book"
                                           asp-action="Index"
                                           asp-route-searchString="@ViewBag.SearchString"
                                           asp-route-categoryId="@ViewBag.CategoryId"
                                           asp-route-publisherId="@ViewBag.PublisherId"
                                           asp-route-authorId="@ViewBag.AuthorId">
                                    </pager>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script>
        // Auto dismiss alert after 5 seconds
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
}

