@model QuanLyThuVien.Models.tblUser
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Chỉnh sửa người dùng</h2>
    </div>

    <div class="container shadow p-5">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UserID" />

            <div class="form-row needs-validation">
                <div class="form-group col-md-6 mb-3">
                    <label class="fw-bold">Tên đăng nhập</label>
                    <input asp-for="UserName" class="form-control" readonly />
                </div>
                <div class="form-group col-md-6 mb-3">
                    <label class="fw-bold">Email</label>
                    <input asp-for="Email" class="form-control" type="email" required />
                    <div class="invalid-feedback">Vui lòng nhập email hợp lệ.</div>
                    <span class="text-danger" asp-validation-for="Email"></span>
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label class="fw-bold">Họ và tên</label>
                    <input asp-for="FullName" class="form-control" required />
                    <div class="invalid-feedback">Không được để trống họ và tên.</div>
                    <span class="text-danger" asp-validation-for="FullName"></span>
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label class="fw-bold">Số điện thoại</label>
                    <input asp-for="Phone" class="form-control" required />
                    <div class="invalid-feedback">Vui lòng nhập số điện thoại.</div>
                    <span class="text-danger" asp-validation-for="Phone"></span>
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label class="fw-bold">Ngày sinh</label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" required 
                           max="@DateTime.Today.ToString("yyyy-MM-dd")" 
                           min="@DateTime.Today.AddYears(-100).ToString("yyyy-MM-dd")" />
                    <div class="invalid-feedback">Vui lòng chọn ngày sinh hợp lệ (không quá 100 tuổi).</div>
                    <span class="text-danger" asp-validation-for="DateOfBirth"></span>
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label class="fw-bold">Quyền hạn</label>
                    <select asp-for="Role" asp-items="ViewBag.RoleList" class="form-control" required></select>
                    <div class="invalid-feedback">Vui lòng chọn quyền hạn.</div>
                    <span class="text-danger" asp-validation-for="Role"></span>
                </div>

                <!-- Ảnh đại diện hiện tại -->
                <div class="form-group col-md-6 mb-3">
                    <label class="fw-bold">Ảnh đại diện hiện tại</label>
                    <div class="mt-2">
                        @if (!string.IsNullOrEmpty(Model.Avatar))
                        {
                            <img id="currentAvatarImg" src="@Model.Avatar" alt="Avatar" class="rounded-circle border" width="80" height="80" />
                            <span id="noAvatarText" class="text-muted" style="display:none;">Chưa có ảnh</span>
                        }
                        else
                        {
                            <img id="currentAvatarImg" src="" alt="Avatar" class="rounded-circle border" width="80" height="80" style="display:none;" />
                            <span id="noAvatarText" class="text-muted">Chưa có ảnh</span>
                        }
                    </div>
                    
                </div>

                <!-- Chọn ảnh mới -->
                <div class="form-group col-md-6 mb-3">
                    <label class="fw-bold">Chọn ảnh mới</label>
                    <div class="d-flex gap-2 mb-2">
                        <input type="hidden" id="AvatarPath" name="AvatarPath" value="@Model.Avatar" />
                        <button type="button" class="btn btn-info btn-sm" onclick="openFileManager('AvatarPath')">
                            <i class="bi bi-folder2-open"></i> Chọn ảnh
                        </button>
                        <button type="button" class="btn btn-danger btn-sm" onclick="removeCurrentAvatar()">
                            <i class="bi bi-trash"></i> Xóa ảnh
                        </button>
                    </div>
                    <small class="text-muted">Có thể upload trực tiếp từ máy hoặc chọn từ File Manager</small>
                </div>

                <!-- Trạng thái -->
                <div class="form-group col-md-6 mb-3">
                    <div class="form-check form-switch">
                        <input type="checkbox" name="IsActive" value="true" class="form-check-input" role="switch"
                            @(Model.IsActive == true ? "checked" : "") />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label fw-bold">Kích hoạt tài khoản</label>
                    </div>
                </div>
            </div>

            <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-lg btn-warning p-2 me-3">
                <i class="bi bi-arrow-left-circle"></i> Quay lại
            </a>

            <button type="submit" class="btn btn-lg btn-primary p-2">
                <i class="bi bi-save"></i> Lưu thay đổi
            </button>
        </form>
    </div>
</main>

<link href="~/admin/lib/jqueryui/themes/themes/base/theme.css" rel="stylesheet" />
<link href="~/admin/lib/jqueryui/themes/themes/base/jquery-ui.css" rel="stylesheet" />
<link href="~/admin/lib/elFinder/css/elfinder.full.css" rel="stylesheet" />
<link href="~/admin/lib/elFinder/css/theme.css" rel="stylesheet" />
<script src="~/admin/lib/snote/jquery.min.js"></script>
<script src="~/admin/lib/jqueryui/jquery-ui.js"></script>
<script src="~/admin/lib/elFinder/js/elfinder.min.js"></script>

<script type="text/javascript">
    function openFileManager(inputId, previewDivId) {
        var myCommands = elFinder.prototype._options.commands;
        var disabled = ['callback', 'chmod', 'editor', 'netmount', 'ping', 'search', 'zipdl', 'help'];
        
        $.each(disabled, function (i, cmd) {
            (idx = $.inArray(cmd, myCommands)) !== -1 && myCommands.splice(idx, 1);
        });

        var options = {
            baseUrl: "@Url.Content("~/admin/lib/elFinder/")",
            url: "@Url.Action("Connector", "FileManager")",
            rememberLastDir: false,
            commands: myCommands,
            onlyMimes: ["image"],
            lang: 'vi',
            getFileCallback: function (file) {
                var filePath = file.url;
                $("#" + inputId).val(filePath);

                // Hiển thị preview và cập nhật avatar hiện tại ngay lập tức
                if (previewDivId) {
                    $("#" + previewDivId + "Img").attr('src', filePath).show();
                }
                if ($('#currentAvatarImg').length) {
                    $('#currentAvatarImg').attr('src', filePath).show();
                    $('#noAvatarText').hide();
                }
                // Nếu trước đó đã đánh dấu xóa, thì bỏ đánh dấu
                $('#RemoveAvatarHidden').remove();

                // Đóng dialog
                $("#elfinderDialog").dialog('close');
            }
        };

        // Tạo dialog nếu chưa tồn tại
        if ($('#elfinderDialog').length == 0) {
            $('body').append('<div id="elfinderDialog"><div id="elfinderPopup"></div></div>');
        }

        // Khởi tạo elFinder trong dialog (re-init an toàn)
        try {
            $('#elfinderPopup').elfinder('destroy');
        } catch (e) { }
        $('#elfinderPopup').html('');
        $('#elfinderPopup').elfinder(options).elfinder('instance');

        // Mở dialog
        $("#elfinderDialog").dialog({
            modal: true,
            width: 900,
            height: 600,
            title: "Chọn ảnh",
            resizable: true
        });
    }

    function clearAvatar() {
        $('#AvatarPath').val('');
        if ($('#avatarFileUpload').length) { $('#avatarFileUpload').val(''); }
    }

    function removeCurrentAvatar() {
        if ($('#RemoveAvatarHidden').length === 0) {
            $('form').append('<input type="hidden" id="RemoveAvatarHidden" name="RemoveAvatar" value="true" />');
        } else {
            $('#RemoveAvatarHidden').val('true');
        }

        if ($('#currentAvatarImg').length) {
        $('#currentAvatarImg').hide().attr('src', '');
        $('#noAvatarText').show();
        }
        $('#AvatarPath').val('');
        if ($('#avatarFileUpload').length) { $('#avatarFileUpload').val(''); }

        $('button[onclick="removeCurrentAvatar()"]').html('<i class="bi bi-check-circle"></i> Đã xóa').prop('disabled', true);
    }

    // Kiểm tra không để trống
    (function () {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms)
            .forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
    })();
    // Hiển thị preview nếu đã có ảnh sẵn
    $(function(){
        var current = $('#AvatarPath').val();
        if(current){
            if ($('#currentAvatarImg').length) {
                $('#currentAvatarImg').attr('src', current).show();
                $('#noAvatarText').hide();
            }
        }
    });
</script>

<style>
    /* Bảo đảm elFinder hiển thị đúng dạng modal 900x600 */
    .ui-widget-overlay { z-index: 19999 !important; }
    .ui-dialog { z-index: 20000 !important; }
    .ui-dialog .ui-dialog-content { padding: 0; }
    #elfinderPopup { height: 100%; }
 </style>

@{ await Html.RenderPartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml"); }

