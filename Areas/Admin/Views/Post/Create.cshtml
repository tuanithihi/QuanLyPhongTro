@model QuanLyPhongTro.Models.tblPost
@{
    ViewData["Title"] = "Thêm bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
<div class="pagetitle">
    <h1>Bài viết</h1>
    <nav><ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Post" asp-action="Index">Bài viết</a></li>
        <li class="breadcrumb-item active">Thêm mới</li>
    </ol></nav>
</div>

<section class="section">
<form asp-area="Admin" asp-controller="Post" asp-action="Create"
      method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="row g-3">

        @* Cột trái: nội dung *@
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header py-3"><h6 class="mb-0 fw-semibold">Nội dung bài viết</h6></div>
                <div class="card-body pt-3">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control"
                               placeholder="Nhập tiêu đề bài viết..." id="titleInput" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label fw-semibold">
                            Tóm tắt <span class="text-muted fw-normal small">(tuỳ chọn)</span>
                        </label>
                        <textarea asp-for="Summary" class="form-control" rows="2"
                                  placeholder="Mô tả ngắn hiển thị trên trang danh sách..."></textarea>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Content" class="form-label fw-semibold">Nội dung</label>
                        <textarea asp-for="Content" class="form-control" rows="16"
                                  placeholder="Nhập nội dung bài viết..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        @* Cột phải: thiết lập *@
        <div class="col-lg-4">

            @* Xuất bản *@
            <div class="card mb-3">
                <div class="card-header py-3"><h6 class="mb-0 fw-semibold">Xuất bản</h6></div>
                <div class="card-body pt-3">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsPublished" class="form-check-input" type="checkbox" role="switch">
                        <label asp-for="IsPublished" class="form-check-label fw-semibold"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsPinned" class="form-check-input" type="checkbox" role="switch">
                        <label asp-for="IsPinned" class="form-check-label fw-semibold">Ghim lên đầu</label>
                    </div>
                </div>
            </div>

            @* Danh mục *@
            <div class="card mb-3">
                <div class="card-header py-3"><h6 class="mb-0 fw-semibold">Phân loại</h6></div>
                <div class="card-body pt-3">
                    <div class="mb-0">
                        <label asp-for="Category" class="form-label fw-semibold">
                            Danh mục <span class="text-muted fw-normal small">(tuỳ chọn)</span>
                        </label>
                        <input asp-for="Category" class="form-control"
                               placeholder="VD: Thông báo, Tin tức..." list="catList" />
                        <datalist id="catList">
                            <option value="Thông báo"></option>
                            <option value="Tin tức"></option>
                            <option value="Hướng dẫn"></option>
                            <option value="Khuyến mãi"></option>
                        </datalist>
                    </div>
                </div>
            </div>

            @* Ảnh đại diện *@
            <div class="card mb-3">
                <div class="card-header py-3"><h6 class="mb-0 fw-semibold">Ảnh đại diện</h6></div>
                <div class="card-body pt-3">
                    <input type="file" name="thumbnailFile" class="form-control"
                           accept="image/*" onchange="previewThumb(this)">
                    <div id="thumbWrap" class="mt-3" style="display:none">
                        <img id="thumbPreview" src="" alt="preview" class="img-fluid rounded"
                             style="max-height:200px;width:100%;object-fit:cover;">
                    </div>
                    <div id="thumbPlaceholder" class="text-center text-muted py-4 border rounded mt-3"
                         style="border-style:dashed!important;font-size:.85rem;">
                        <i class="bi bi-image fs-2 d-block mb-1"></i>Chưa chọn ảnh
                    </div>
                </div>
            </div>

            @* Nút lưu *@
            <div class="card">
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Lưu bài viết
                        </button>
                        <a asp-area="Admin" asp-controller="Post" asp-action="Index"
                           class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>
</section>
</main>

@section Scripts {
<partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
<script>
function previewThumb(input) {
    const wrap = document.getElementById('thumbWrap');
    const placeholder = document.getElementById('thumbPlaceholder');
    const img = document.getElementById('thumbPreview');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { img.src = e.target.result; wrap.style.display=''; placeholder.style.display='none'; };
        reader.readAsDataURL(input.files[0]);
    } else { wrap.style.display='none'; placeholder.style.display=''; }
}
</script>
}
