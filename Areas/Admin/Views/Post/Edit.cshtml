@model QuanLyPhongTro.Models.tblPost
@{
    ViewData["Title"] = "Sửa bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
<div class="pagetitle">
    <h1>Bài viết</h1>
    <nav><ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Post" asp-action="Index">Bài viết</a></li>
        <li class="breadcrumb-item active">Sửa</li>
    </ol></nav>
</div>

<section class="section">
<form asp-area="Admin" asp-controller="Post" asp-action="Edit"
      asp-route-id="@Model.PostId" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PostId" />
    <div class="row g-3">

        @* Cột trái: nội dung *@
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header py-3"><h6 class="mb-0 fw-semibold">Nội dung bài viết</h6></div>
                <div class="card-body pt-3">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label fw-semibold">
                            Tóm tắt <span class="text-muted fw-normal small">(tuỳ chọn)</span>
                        </label>
                        <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Content" class="form-label fw-semibold">Nội dung</label>
                        <textarea asp-for="Content" class="form-control" rows="16"></textarea>
                    </div>
                </div>
            </div>

            @* SEO (tuỳ chọn) *@
            <div class="card mb-3">
                <div class="card-header py-3">
                    <a class="text-decoration-none text-dark fw-semibold small" data-bs-toggle="collapse" href="#seoPanel">
                        SEO <span class="text-muted fw-normal">(tuỳ chọn — click để mở)</span>
                    </a>
                </div>
                <div id="seoPanel" class="collapse">
                    <div class="card-body pt-3">
                        <div class="mb-3">
                            <label asp-for="MetaTitle" class="form-label fw-semibold small"></label>
                            <input asp-for="MetaTitle" class="form-control form-control-sm" />
                        </div>
                        <div class="mb-0">
                            <label asp-for="MetaDescription" class="form-label fw-semibold small"></label>
                            <textarea asp-for="MetaDescription" class="form-control form-control-sm" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Cột phải: thiết lập *@
        <div class="col-lg-4">

            <div class="card mb-3">
                <div class="card-header py-3"><h6 class="mb-0 fw-semibold">Xuất bản</h6></div>
                <div class="card-body pt-3">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsPublished" class="form-check-input" type="checkbox" role="switch">
                        <label asp-for="IsPublished" class="form-check-label fw-semibold"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsPinned" class="form-check-input" type="checkbox" role="switch">
                        <label asp-for="IsPinned" class="form-check-label fw-semibold">Ghim lên đầu</label>
                    </div>
                    @if (Model.PublishedAt.HasValue)
                    {
                        <hr class="my-2" />
                        <div class="small text-muted">
                            <i class="bi bi-calendar-check me-1"></i>
                            Đăng lúc: @Model.PublishedAt.Value.ToString("HH:mm dd/MM/yyyy")
                        </div>
                    }
                    <div class="small text-muted mt-1">
                        <i class="bi bi-eye me-1"></i> @Model.ViewCount lượt xem
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header py-3"><h6 class="mb-0 fw-semibold">Phân loại</h6></div>
                <div class="card-body pt-3">
                    <label asp-for="Category" class="form-label fw-semibold">
                        Danh mục <span class="text-muted fw-normal small">(tuỳ chọn)</span>
                    </label>
                    <input asp-for="Category" class="form-control"
                           placeholder="VD: Thông báo, Tin tức..." list="catList" />
                    <datalist id="catList">
                        <option value="Thông báo"></option>
                        <option value="Tin tức"></option>
                        <option value="Hướng dẫn"></option>
                        <option value="Khuyến mãi"></option>
                    </datalist>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header py-3"><h6 class="mb-0 fw-semibold">Ảnh đại diện</h6></div>
                <div class="card-body pt-3">
                    @if (!string.IsNullOrEmpty(Model.ThumbnailImage))
                    {
                        <p class="text-muted small mb-1">Ảnh hiện tại:</p>
                        <img id="currentThumb" src="@Model.ThumbnailImage" alt="thumb" class="img-fluid rounded mb-3"
                             style="max-height:180px;width:100%;object-fit:cover;">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="removeThumb" value="true" id="chkRemove">
                            <label class="form-check-label text-danger small" for="chkRemove">Xóa ảnh này</label>
                        </div>
                    }
                    <label class="form-label fw-semibold small">Thay ảnh mới (tuỳ chọn)</label>
                    <input type="file" name="thumbnailFile" class="form-control"
                           accept="image/*" onchange="previewThumb(this)">
                    <div id="thumbWrap" class="mt-3" style="display:none">
                        <img id="thumbPreview" src="" alt="preview" class="img-fluid rounded"
                             style="max-height:180px;width:100%;object-fit:cover;">
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Lưu thay đổi
                        </button>
                        <a asp-area="Admin" asp-controller="Post" asp-action="Index"
                           class="btn btn-outline-secondary">Quay lại</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>
</section>
</main>

@section Scripts {
<partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
<script>
function previewThumb(input) {
    const wrap = document.getElementById('thumbWrap');
    const img = document.getElementById('thumbPreview');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { img.src = e.target.result; wrap.style.display = ''; };
        reader.readAsDataURL(input.files[0]);
    } else { wrap.style.display = 'none'; }
}
</script>
}
