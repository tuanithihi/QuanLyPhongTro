@model QuanLyThuVien.Models.tblBorrow

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Chi tiết phiếu mượn";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2><i class="bi bi-receipt me-2"></i>Chi tiết phiếu mượn</h2>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Borrow" asp-action="Index">Quản lý mượn trả</a></li>
                <li class="breadcrumb-item active">Chi tiết</li>
            </ol>
        </nav>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@Html.Raw(TempData["ErrorMessage"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <section class="section dashboard">
        <div class="row">
            <div class="col-lg-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-info-circle me-2"></i>Thông tin phiếu mượn #@Model.BorrowID
                        </h5>
                        <a asp-area="Admin" asp-controller="Borrow" asp-action="Index" class="btn btn-light btn-sm">
                            <i class="bi bi-arrow-left-circle me-1"></i>Quay lại
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <table class="table table-borderless">
                                    <tr>
                                        <th style="width: 150px;">Người mượn:</th>
                                        <td><strong>@Model.User?.FullName</strong></td>
                                    </tr>
                                    <tr>
                                        <th>Email:</th>
                                        <td>@Model.User?.Email</td>
                                    </tr>
                                    <tr>
                                        <th>Ngày mượn:</th>
                                        <td>@Model.BorrowDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                    <tr>
                                        <th>Hạn trả:</th>
                                        <td>
                                            <span class="@(DateTime.Now > Model.DueDate && Model.Status != "Returned" ? "text-danger fw-bold" : "")">
                                                @Model.DueDate.ToString("dd/MM/yyyy")
                                            </span>
                                            @if (Model.Status == "Returned")
                                            {
                                                var lastReturnDate = Model.BorrowDetails?.Where(bd => bd.ReturnDate.HasValue).Max(bd => bd.ReturnDate);
                                                if (lastReturnDate.HasValue)
                                                {
                                                    <br>
                                                    <strong class="text-success">Ngày trả:</strong>
                                                    <span class="text-success">
                                                        @lastReturnDate.Value.ToString("dd/MM/yyyy HH:mm")
                                                    </span>
                                                }
                                            }
                                            @{
                                                var daysRemaining = 0;
                                                var isOverdue = false;
                                                if (Model.Status != "Returned")
                                                {
                                                    var timeSpan = Model.DueDate - DateTime.Now;
                                                    daysRemaining = (int)timeSpan.TotalDays;
                                                    isOverdue = daysRemaining < 0;
                                                }
                                            }
                                            @if (Model.Status != "Returned")
                                            {
                                                <br>
                                                @if (isOverdue)
                                                {
                                                    <span class="badge bg-danger mt-1">
                                                        <i class="bi bi-exclamation-triangle me-1"></i>Quá hạn @Math.Abs(daysRemaining) ngày
                                                    </span>
                                                }
                                                else if (daysRemaining <= 3)
                                                {
                                                    <span class="badge bg-warning mt-1">
                                                        <i class="bi bi-clock me-1"></i>Còn @daysRemaining ngày
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success mt-1">
                                                        <i class="bi bi-check-circle me-1"></i>Còn @daysRemaining ngày
                                                    </span>
                                                }
                                            }
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <table class="table table-borderless">
                                    <tr>
                                        <th style="width: 150px;">Trạng thái:</th>
                                        <td>
                                            @if (Model.Status == "Returned")
                                            {
                                                <span class="badge bg-success fs-6">Đã trả</span>
                                            }
                                            else if (Model.Status == "Overdue")
                                            {
                                                <span class="badge bg-danger fs-6">Quá hạn</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning fs-6">Đang mượn</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Tổng số sách:</th>
                                        <td><strong>@(Model.BorrowDetails?.Count ?? 0) cuốn</strong></td>
                                    </tr>
                                    <tr>
                                        <th>Đã trả:</th>
                                        <td>
                                            <span class="badge bg-success">
                                                @(Model.BorrowDetails?.Count(bd => bd.BorrowStatus == "Returned") ?? 0) cuốn
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Chưa trả:</th>
                                        <td>
                                            <span class="badge bg-warning">
                                                @(Model.BorrowDetails?.Count(bd => bd.BorrowStatus != "Returned") ?? 0) cuốn
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <hr>

                        <h5 class="mb-3"><i class="bi bi-book me-2"></i>Danh sách sách trong phiếu</h5>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>STT</th>
                                        <th>Ảnh bìa</th>
                                        <th>Tên sách</th>
                                        <th>Danh mục</th>
                                        <th>Nhà xuất bản</th>
                                        <th class="text-center">Trạng thái</th>
                                        <th>Ngày trả</th>
                                        <th class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.BorrowDetails != null && Model.BorrowDetails.Any())
                                    {
                                        int stt = 1;
                                        @foreach (var detail in Model.BorrowDetails)
                                        {
                                            <tr>
                                                <td>@stt</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(detail.Book?.CoverImage))
                                                    {
                                                        <img src="@detail.Book.CoverImage" alt="@detail.Book.Title" 
                                                             class="img-thumbnail" style="width: 60px; height: 80px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light d-flex align-items-center justify-content-center" 
                                                             style="width: 60px; height: 80px;">
                                                            <i class="bi bi-image text-muted"></i>
                                                        </div>
                                                    }
                                                </td>
                                                <td>
                                                    <strong>@detail.Book?.Title</strong>
                                                </td>
                                                <td>
                                                    <span class="badge bg-info">@detail.Book?.Category?.CategoryName</span>
                                                </td>
                                                <td>@detail.Book?.Publisher?.PublisherName</td>
                                                <td class="text-center">
                                                    @if (detail.BorrowStatus == "Returned")
                                                    {
                                                        <span class="badge bg-success">Đã trả</span>
                                                    }
                                                    else if (DateTime.Now > Model.DueDate)
                                                    {
                                                        <span class="badge bg-danger">Quá hạn</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning">Đang mượn</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (detail.BorrowStatus == "Returned" && detail.ReturnDate.HasValue)
                                                    {
                                                        <span class="text-success">
                                                            <i class="bi bi-check-circle me-1"></i>
                                                            @detail.ReturnDate.Value.ToString("dd/MM/yyyy HH:mm")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Chưa trả</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (detail.BorrowStatus != "Returned")
                                                    {
                                                        <button type="button" class="btn btn-sm btn-success" 
                                                                data-bs-toggle="modal" 
                                                                data-bs-target="#confirmReturnModal_@detail.BorrowDetailID">
                                                            <i class="bi bi-check-circle me-1"></i>Trả sách
                                                        </button>
                                                        
                                                        <!-- Modal xác nhận trả từng sách -->
                                                        <div class="modal fade" id="confirmReturnModal_@detail.BorrowDetailID" tabindex="-1" aria-labelledby="confirmReturnModalLabel_@detail.BorrowDetailID" aria-hidden="true">
                                                            <div class="modal-dialog modal-dialog-centered">
                                                                <div class="modal-content">
                                                                    <div class="modal-header bg-success text-white">
                                                                        <h5 class="modal-title" id="confirmReturnModalLabel_@detail.BorrowDetailID">
                                                                            <i class="bi bi-check-circle me-2"></i>Xác nhận trả sách
                                                                        </h5>
                                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <div class="d-flex align-items-start mb-3">
                                                                            <div class="flex-shrink-0">
                                                                                <i class="bi bi-question-circle text-warning fs-1"></i>
                                                                            </div>
                                                                            <div class="flex-grow-1 ms-3">
                                                                                <h6 class="mb-2">Bạn có chắc chắn xác nhận người mượn trả sách này?</h6>
                                                                                <div class="card bg-light">
                                                                                    <div class="card-body p-3">
                                                                                        <p class="mb-1"><strong>Tên sách:</strong> @detail.Book?.Title</p>
                                                                                        <p class="mb-1"><strong>Danh mục:</strong> @detail.Book?.Category?.CategoryName</p>
                                                                                        <p class="mb-0"><strong>Nhà xuất bản:</strong> @detail.Book?.Publisher?.PublisherName</p>
                                                                                    </div>
                                                                                </div>
                                                                                <p class="text-muted small mt-2 mb-0">
                                                                                    <i class="bi bi-info-circle me-1"></i>
                                                                                    Số lượng sách sẽ được cộng lại vào kho sau khi xác nhận.
                                                                                </p>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                                            <i class="bi bi-x-circle me-1"></i>Hủy
                                                                        </button>
                                                                        <form method="post" asp-action="MarkReturned" style="display: inline;">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="borrowId" value="@Model.BorrowID" />
                                                                            <input type="hidden" name="borrowDetailId" value="@detail.BorrowDetailID" />
                                                                            <button type="submit" class="btn btn-success">
                                                                                <i class="bi bi-check-circle me-1"></i>Xác nhận trả sách
                                                                            </button>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Đã trả</span>
                                                    }
                                                </td>
                                            </tr>
                                            stt++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (Model.BorrowDetails != null && Model.BorrowDetails.Any(bd => bd.BorrowStatus != "Returned"))
                        {
                            <div class="mt-4 text-end">
                                <button type="button" class="btn btn-primary" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#confirmReturnAllModal">
                                    <i class="bi bi-check-all me-1"></i>Trả tất cả
                                </button>
                                
                                <!-- Modal xác nhận trả tất cả -->
                                <div class="modal fade" id="confirmReturnAllModal" tabindex="-1" aria-labelledby="confirmReturnAllModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header bg-primary text-white">
                                                <h5 class="modal-title" id="confirmReturnAllModalLabel">
                                                    <i class="bi bi-check-all me-2"></i>Xác nhận trả tất cả sách
                                                </h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="d-flex align-items-start mb-3">
                                                    <div class="flex-shrink-0">
                                                        <i class="bi bi-question-circle text-warning fs-1"></i>
                                                    </div>
                                                    <div class="flex-grow-1 ms-3">
                                                        <h6 class="mb-2">Bạn có chắc chắn muốn trả tất cả sách trong phiếu này?</h6>
                                                        <div class="card bg-light">
                                                            <div class="card-body p-3">
                                                                <p class="mb-1"><strong>Mã phiếu:</strong> #@Model.BorrowID</p>
                                                                <p class="mb-1"><strong>Người mượn:</strong> @Model.User?.FullName</p>
                                                                <p class="mb-1"><strong>Số sách chưa trả:</strong> 
                                                                    <span class="badge bg-warning">
                                                                        @(Model.BorrowDetails?.Count(bd => bd.BorrowStatus != "Returned") ?? 0) cuốn
                                                                    </span>
                                                                </p>
                                                                <p class="mb-0"><strong>Danh sách sách:</strong></p>
                                                                <ul class="mb-0 mt-2">
                                                                    @foreach (var detail in Model.BorrowDetails.Where(bd => bd.BorrowStatus != "Returned"))
                                                                    {
                                                                        <li>@detail.Book?.Title</li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        </div>
                                                        <p class="text-muted small mt-2 mb-0">
                                                            <i class="bi bi-info-circle me-1"></i>
                                                            Tất cả số lượng sách sẽ được cộng lại vào kho sau khi xác nhận.
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    <i class="bi bi-x-circle me-1"></i>Hủy
                                                </button>
                                                <form method="post" asp-action="MarkReturned" style="display: inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="borrowId" value="@Model.BorrowID" />
                                                    <input type="hidden" name="returnAll" value="true" />
                                                    <button type="submit" class="btn btn-primary">
                                                        <i class="bi bi-check-all me-1"></i>Xác nhận trả tất cả
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script>
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
}

