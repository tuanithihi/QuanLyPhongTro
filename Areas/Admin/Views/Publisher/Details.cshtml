@model QuanLyThuVien.Models.tblPublisher
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Chi tiết nhà xuất bản</h2>
    </div>

    <div class="container shadow p-5">

        <div class="row mb-4">
            <div class="col-md-3 text-center">
                @if (!string.IsNullOrEmpty(Model.Avatar))
                {
                    <img src="@Model.Avatar" alt="@Model.PublisherName" class="rounded-circle border mb-3" width="150" height="150" />
                }
                else
                {
                    <img src="/uploads/avatars/default.png" class="rounded-circle border mb-3" width="150" height="150" />
                }
                <h5 class="fw-bold">@Model.PublisherName</h5>

                @if (Model.IsActive== true)
                {
                    <span class="badge bg-success">Đang hoạt động</span>
                }
                else
                {
                    <span class="badge bg-danger">Ngừng hoạt động</span>
                }
            </div>

            <div class="col-md-9">
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th style="width:200px;">Tên nhà xuất bản</th>
                            <td>@Model.PublisherName</td>
                        </tr>
                        <tr>
                            <th>Địa chỉ</th>
                            <td>@Model.Address</td>
                        </tr>
                        <tr>
                            <th>Điện thoại</th>
                            <td>@Model.Phone</td>
                        </tr>
                        <tr>
                            <th>Email</th>
                            <td>@Model.Email</td>
                        </tr>
                        <tr>
                            <th>Trạng thái</th>
                            <td>
                                @if (Model.IsActive == true)
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Ngừng hoạt động</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Ngày tạo</th>
                            <td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="text-end mt-4">
            <a asp-area="Admin" asp-controller="Publisher" asp-action="Index" class="btn btn-warning me-2">
                <i class="bi bi-arrow-left-circle"></i> Quay lại
            </a>
            <a asp-area="Admin" asp-controller="Publisher" asp-action="Edit" asp-route-id="@Model.PublisherID"
               class="btn btn-primary me-2">
                <i class="bi bi-pencil-square"></i> Chỉnh sửa
            </a>
            <a asp-area="Admin" asp-controller="Publisher" asp-action="Delete" asp-route-id="@Model.PublisherID"
               class="btn btn-danger">
                <i class="bi bi-trash"></i> Xóa
            </a>
        </div>

    </div>
</main>
