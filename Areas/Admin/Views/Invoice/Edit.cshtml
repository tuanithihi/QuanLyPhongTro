@model QuanLyPhongTro.Models.tblInvoice
@using QuanLyPhongTro.Models
@{
    ViewData["Title"] = "Cập nhật hóa đơn";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
<div class="pagetitle">
    <h1>Cập nhật hóa đơn</h1>
    <nav><ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Invoice" asp-action="Index">Hóa đơn</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Invoice" asp-action="Details" asp-route-id="@Model.InvoiceId">@Model.InvoiceCode</a></li>
        <li class="breadcrumb-item active">Sửa</li>
    </ol></nav>
</div>

<section class="section">
<div class="row justify-content-center">
<div class="col-lg-6">
<div class="card">
<div class="card-header fw-semibold py-3">
    <i class="bi bi-pencil me-2"></i>Cập nhật trạng thái & thanh toán
</div>
<div class="card-body pt-3">

<form asp-area="Admin" asp-controller="Invoice" asp-action="Edit" asp-route-id="@Model.InvoiceId"
      method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="InvoiceId" />

    <div class="alert alert-info py-2 small mb-3">
        <i class="bi bi-info-circle me-1"></i>
        Hóa đơn <strong>@Model.InvoiceCode</strong> —
        Tháng @Model.BillingMonth/@Model.BillingYear —
        Tổng: <strong>@Model.TotalAmount.ToString("N0") ₫</strong>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label fw-semibold"></label>
        <select asp-for="Status" class="form-select" asp-items="@((SelectList)ViewBag.StatusList)"
                onchange="togglePaidFields(this.value)"></select>
    </div>

    <div id="paidFields" class="@(Model.Status == InvoiceStatus.Paid ? "" : "d-none")">
        <div class="mb-3">
            <label asp-for="PaidDate" class="form-label fw-semibold"></label>
            <input asp-for="PaidDate" type="date" class="form-control" />
            <span asp-validation-for="PaidDate" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PaymentMethod" class="form-label fw-semibold"></label>
            <input asp-for="PaymentMethod" class="form-control" placeholder="Tiền mặt / Chuyển khoản..." />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="DueDate" class="form-label fw-semibold"></label>
        <input asp-for="DueDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Discount" class="form-label fw-semibold"></label>
        <div class="input-group">
            <input asp-for="Discount" type="number" class="form-control" min="0" step="1000" />
            <span class="input-group-text">₫</span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label fw-semibold"></label>
        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-floppy me-1"></i>Lưu</button>
        <a asp-area="Admin" asp-controller="Invoice" asp-action="Details"
           asp-route-id="@Model.InvoiceId" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

</div>
</div>
</div>
</div>
</section>
</main>

@section Scripts {
<script>
function togglePaidFields(val) {
    const pf = document.getElementById('paidFields');
    if (val === '1') pf.classList.remove('d-none');
    else pf.classList.add('d-none');
}
</script>
}
