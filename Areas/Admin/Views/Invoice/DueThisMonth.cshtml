@model List<QuanLyPhongTro.Models.tblContract>
@using QuanLyPhongTro.Models
@{
    ViewData["Title"] = "Phòng cần lập hóa đơn";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    DateTime today    = ViewBag.Today;
    int needCount     = ViewBag.NeedCount;
    int doneCount     = Model.Count - needCount;
}

<main id="main" class="main">
<div class="pagetitle">
    <h1>Hóa đơn tháng @today.Month/@today.Year</h1>
    <nav><ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Invoice" asp-action="Index">Hóa đơn</a></li>
        <li class="breadcrumb-item active">Cần lập tháng này</li>
    </ol></nav>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="section">

    @* Thống kê nhanh *@
    <div class="row g-3 mb-3">
        <div class="col-sm-4">
        <div class="card border-0 bg-danger-subtle h-100">
            <div class="card-body text-center py-3">
                <div class="fs-1 fw-bold text-danger">@needCount</div>
                <div class="text-danger small fw-semibold">Chưa lập hóa đơn</div>
            </div>
        </div>
        </div>
        <div class="col-sm-4">
        <div class="card border-0 bg-success-subtle h-100">
            <div class="card-body text-center py-3">
                <div class="fs-1 fw-bold text-success">@doneCount</div>
                <div class="text-success small fw-semibold">Đã lập hóa đơn</div>
            </div>
        </div>
        </div>
        <div class="col-sm-4">
        <div class="card border-0 bg-secondary-subtle h-100">
            <div class="card-body text-center py-3">
                <div class="fs-1 fw-bold text-secondary">@Model.Count</div>
                <div class="text-secondary small fw-semibold">Tổng phòng đang thuê</div>
            </div>
        </div>
        </div>
    </div>

    @* Bảng danh sách *@
    <div class="card">
    <div class="card-header py-3">
        <h5 class="mb-0"><i class="bi bi-calendar-check me-2"></i>Danh sách phòng — Tháng @today.Month/@today.Year</h5>
    </div>
    <div class="card-body p-0">
    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-house-check fs-1 d-block mb-2"></i>Không có phòng nào đang cho thuê.
        </div>
    }
    else
    {
        <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Phòng</th>
                    <th>Người thuê</th>
                    <th class="text-end">Tiền thuê</th>
                    <th class="text-center">Ngày TT</th>
                    <th class="text-center">Tình trạng</th>
                    <th class="text-center" style="width:140px;">Hóa đơn tháng này</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    bool hasInvoice     = c.Invoices.Any();
                    bool isOverdue      = !hasInvoice && today.Day > c.PaymentDayOfMonth;
                    bool isDueToday     = !hasInvoice && today.Day == c.PaymentDayOfMonth;
                    bool isUpcoming     = !hasInvoice && today.Day < c.PaymentDayOfMonth;
                    int  daysOverdue    = isOverdue ? today.Day - c.PaymentDayOfMonth : 0;
                    int  daysUntilDue   = isUpcoming ? c.PaymentDayOfMonth - today.Day : 0;
                    var  invoice        = c.Invoices.FirstOrDefault();

                    <tr>
                        <td>
                            <div class="fw-semibold">@c.Room?.RoomCode</div>
                            <div class="text-muted small">@c.Room?.RoomType?.RoomTypeName</div>
                        </td>
                        <td>
                            <div>@c.Tenant?.FullName</div>
                            <div class="text-muted small">@c.Tenant?.Phone</div>
                        </td>
                        <td class="text-end fw-semibold">@c.MonthlyRent.ToString("N0") đ</td>
                        <td class="text-center">
                            <span class="badge bg-light text-dark border">Ngày @c.PaymentDayOfMonth</span>
                        </td>
                        <td class="text-center">
                            @if (hasInvoice)
                            {
                                <span class="badge bg-success">Đã lập</span>
                            }
                            else if (isDueToday)
                            {
                                <span class="badge bg-warning text-dark">Đến hạn hôm nay</span>
                            }
                            else if (isOverdue)
                            {
                                <span class="badge bg-danger">Quá hạn @daysOverdue ngày</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Còn @daysUntilDue ngày</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (hasInvoice && invoice != null)
                            {
                                <a asp-area="Admin" asp-controller="Invoice" asp-action="Details"
                                   asp-route-id="@invoice.InvoiceId"
                                   class="btn btn-sm btn-outline-success px-2" title="Xem hóa đơn">
                                    <i class="bi bi-eye me-1"></i>Xem
                                </a>
                            }
                            else
                            {
                                <a asp-area="Admin" asp-controller="Invoice" asp-action="Generate"
                                   asp-route-contractId="@c.ContractId"
                                   class="btn btn-sm @(isOverdue || isDueToday ? "btn-danger" : "btn-primary") px-2">
                                    <i class="bi bi-file-earmark-plus me-1"></i>Lập HĐ
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    </div>
    </div>

</section>
</main>
