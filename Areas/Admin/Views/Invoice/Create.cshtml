@model QuanLyPhongTro.Models.tblInvoice
@using QuanLyPhongTro.Models
@{
    ViewData["Title"] = "Lập hóa đơn";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var contract = (tblContract)ViewBag.Contract;
    var services = (List<tblService>)ViewBag.Services;
}

<main id="main" class="main">
<div class="pagetitle">
    <h1>Lập hóa đơn</h1>
    <nav><ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Contract" asp-action="Details" asp-route-id="@contract.ContractId">Hợp đồng @contract.ContractCode</a></li>
        <li class="breadcrumb-item active">Lập hóa đơn</li>
    </ol></nav>
</div>

<section class="section">
<form asp-area="Admin" asp-controller="Invoice" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ContractId" />
    <input type="hidden" asp-for="RoomId" />
    <input type="hidden" asp-for="InvoiceCode" />

<div class="row">
<div class="col-lg-8">

    @* ── Thông tin hợp đồng (readonly) ── *@
    <div class="card mb-3">
        <div class="card-header fw-semibold"><i class="bi bi-file-earmark-text me-2"></i>Thông tin hợp đồng</div>
        <div class="card-body py-2">
            <div class="row g-2">
                <div class="col-md-4">
                    <span class="text-muted small">Hợp đồng</span>
                    <div class="fw-semibold">@contract.ContractCode</div>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small">Phòng</span>
                    <div class="fw-semibold">@contract.Room?.RoomCode — @contract.Room?.RoomName</div>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small">Người thuê</span>
                    <div class="fw-semibold">@contract.Tenant?.FullName</div>
                </div>
            </div>
        </div>
    </div>

    @* ── Kỳ thanh toán ── *@
    <div class="card mb-3">
        <div class="card-header fw-semibold"><i class="bi bi-calendar3 me-2"></i>Kỳ thanh toán</div>
        <div class="card-body pt-3">
            <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3"></div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="BillingMonth" class="form-label fw-semibold"></label>
                    <select asp-for="BillingMonth" class="form-select" onchange="updateDueDate()">
                        @for (int m = 1; m <= 12; m++)
                        {
                            if (Model.BillingMonth == m)
                            { <option value="@m" selected>Tháng @m</option> }
                            else
                            { <option value="@m">Tháng @m</option> }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="BillingYear" class="form-label fw-semibold"></label>
                    <input asp-for="BillingYear" type="number" class="form-control"
                           min="2000" max="2100" onchange="updateDueDate()" />
                </div>
                <div class="col-md-3">
                    <label asp-for="DueDate" class="form-label fw-semibold"></label>
                    <input asp-for="DueDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="RoomRentAmount" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <input asp-for="RoomRentAmount" type="number" id="RoomRentAmount"
                               class="form-control" min="0" step="1000"
                               onchange="recalcTotal()" />
                        <span class="input-group-text">₫</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Chỉ số điện nước ── *@
    <div class="card mb-3">
        <div class="card-header fw-semibold"><i class="bi bi-lightning-charge me-2"></i>Chỉ số điện — nước</div>
        <div class="card-body pt-3">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Điện đầu kỳ (kWh)</label>
                    <input asp-for="ElectricIndexStart" type="number" id="ElectricIndexStart"
                           class="form-control font-monospace" min="0" step="0.1"
                           onchange="syncElectricQty()" />
                </div>
                <div class="col-md-3" style="position:relative;">
                    <label class="form-label fw-semibold">Điện cuối kỳ (kWh)</label>
                    <input asp-for="ElectricIndexEnd" type="number" id="ElectricIndexEnd"
                           class="form-control font-monospace" min="0" step="0.1"
                           onchange="syncElectricQty()" />
                    <div class="invalid-tooltip" id="elecEndTooltip"></div>
                    <div class="form-text" id="elecDiff"></div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Nước đầu kỳ (m³)</label>
                    <input asp-for="WaterIndexStart" type="number" id="WaterIndexStart"
                           class="form-control font-monospace" min="0" step="0.1"
                           onchange="syncWaterQty()" />
                </div>
                <div class="col-md-3" style="position:relative;">
                    <label class="form-label fw-semibold">Nước cuối kỳ (m³)</label>
                    <input asp-for="WaterIndexEnd" type="number" id="WaterIndexEnd"
                           class="form-control font-monospace" min="0" step="0.1"
                           onchange="syncWaterQty()" />
                    <div class="invalid-tooltip" id="waterEndTooltip"></div>
                    <div class="form-text" id="waterDiff"></div>
                </div>
            </div>
        </div>
    </div>

    @* ── Bảng dịch vụ ── *@
    <div class="card mb-3">
        <div class="card-header fw-semibold"><i class="bi bi-list-ul me-2"></i>Dịch vụ phát sinh</div>
        <div class="card-body p-0">
            @if (!services.Any())
            {
                <div class="p-3 text-muted small">Chưa có dịch vụ nào. <a asp-area="Admin" asp-controller="Service" asp-action="Create">Thêm dịch vụ</a></div>
            }
            else
            {
                <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" id="serviceTable">
                    <thead class="table-light">
                        <tr>
                            <th>Dịch vụ</th>
                            <th style="width:110px;">Số lượng</th>
                            <th style="width:130px;">Đơn giá (₫)</th>
                            <th class="text-end" style="width:120px;">Thành tiền</th>
                            <th style="width:150px;">Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < services.Count; i++)
                        {
                            var svc = services[i];
                            bool isElectric = svc.ServiceType == ServiceType.Electric && svc.PricingMethod == PricingMethod.PerUnit;
                            bool isWater    = svc.ServiceType == ServiceType.Water    && svc.PricingMethod == PricingMethod.PerUnit;
                            double defaultQty = svc.PricingMethod == PricingMethod.FixedMonthly ? 1.0 : 0.0;
                            <tr data-svctype="@((int)svc.ServiceType)">
                                <input type="hidden" name="serviceIds" value="@svc.ServiceId" />
                                <td>
                                    <div class="fw-semibold small">@svc.ServiceName</div>
                                    <div class="text-muted" style="font-size:.75rem;">
                                        @(svc.PricingMethod == PricingMethod.PerUnit ? "Theo đơn vị" : "Cố định/tháng")
                                        @if (!string.IsNullOrEmpty(svc.Unit)) { <span>— @svc.Unit</span> }
                                    </div>
                                </td>
                                <td>
                                    <input type="number" name="quantities"
                                           class="form-control form-control-sm qty-input
                                                  @(isElectric ? "electric-qty" : "")
                                                  @(isWater    ? "water-qty"    : "")"
                                           value="@defaultQty.ToString("0.##")"
                                           min="0" step="@(svc.PricingMethod == PricingMethod.PerUnit ? "0.01" : "1")"
                                           @(isElectric || isWater ? "readonly" : "")
                                           onchange="recalcRow(this.closest('tr'))" />
                                </td>
                                <td>
                                    <input type="number" name="unitPrices"
                                           class="form-control form-control-sm price-input"
                                           value="@svc.UnitPrice.ToString("0.##")"
                                           min="0" step="100"
                                           onchange="recalcRow(this.closest('tr'))" />
                                </td>
                                <td class="text-end">
                                    <span class="fw-semibold amount-cell">0 ₫</span>
                                    <input type="hidden" name="unused_amount" class="amount-hidden" value="0" />
                                </td>
                                <td>
                                    <input type="text" name="descriptions"
                                           class="form-control form-control-sm"
                                           placeholder="Tùy chọn" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>
    </div>

</div>

@* ── Cột phải: Tổng kết ── *@
<div class="col-lg-4">
    <div class="card mb-3 sticky-top" style="top:80px;">
        <div class="card-header fw-semibold"><i class="bi bi-calculator me-2"></i>Tổng kết</div>
        <div class="card-body">
            <table class="table table-borderless table-sm mb-3">
                <tr>
                    <td class="text-muted">Tiền thuê phòng</td>
                    <td class="text-end fw-semibold" id="rentDisplay">0 ₫</td>
                </tr>
                <tr>
                    <td class="text-muted">Tổng dịch vụ</td>
                    <td class="text-end" id="svcTotalDisplay">0 ₫</td>
                </tr>
                <tr>
                    <td class="text-muted">
                        <label asp-for="Discount" class="mb-0">Giảm giá</label>
                    </td>
                    <td class="text-end">
                        <input asp-for="Discount" type="number" id="Discount"
                               class="form-control form-control-sm text-end"
                               style="width:110px;display:inline-block;"
                               min="0" step="1000" onchange="recalcTotal()" />
                    </td>
                </tr>
                <tr class="border-top">
                    <td class="fw-bold fs-5">Tổng cộng</td>
                    <td class="text-end fw-bold fs-5 text-primary" id="totalDisplay">0 ₫</td>
                </tr>
            </table>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label fw-semibold"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"
                          placeholder="Ghi chú nội bộ..."></textarea>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy me-1"></i>Lưu hóa đơn
                </button>
                <a asp-area="Admin" asp-controller="Contract" asp-action="Details"
                   asp-route-id="@contract.ContractId" class="btn btn-outline-secondary">
                    Hủy
                </a>
            </div>
        </div>
    </div>
</div>

</div>
</form>
</section>
</main>

@section Scripts {
<script>
const payDay = @contract.PaymentDayOfMonth;

// ── Tính hạn thanh toán ───────────────────────────────────────
function updateDueDate() {
    const m = parseInt(document.querySelector('[name="BillingMonth"]').value);
    const y = parseInt(document.querySelector('[name="BillingYear"]').value);
    if (!m || !y) return;
    const daysInMonth = new Date(y, m, 0).getDate();
    const day = Math.min(payDay, daysInMonth);
    const d = new Date(y, m - 1, day);
    document.querySelector('[name="DueDate"]').value = d.toISOString().split('T')[0];
}

// ── Kiểm tra chỉ số hợp lệ ────────────────────────────────────
function validateIndices() {
    const startEl = document.getElementById('ElectricIndexStart');
    const endEl = document.getElementById('ElectricIndexEnd');
    const wStartEl = document.getElementById('WaterIndexStart');
    const wEndEl = document.getElementById('WaterIndexEnd');
    const submitBtn = document.querySelector('button[type="submit"]');

    const start = parseFloat(startEl.value) || 0;
    const end = parseFloat(endEl.value) || 0;
    const wStart = parseFloat(wStartEl.value) || 0;
    const wEnd = parseFloat(wEndEl.value) || 0;

    let isValid = true;

    // Điện
    if (endEl) {
        const elecTooltip = document.getElementById('elecEndTooltip');
        if (endEl.value !== "") {
            if (end < start) {
                endEl.classList.add('is-invalid');
                if (elecTooltip) elecTooltip.textContent = "Chỉ số cuối kỳ phải ≥ chỉ số đầu kỳ (" + start + " kWh)";
                isValid = false;
            } else {
                endEl.classList.remove('is-invalid');
                if (elecTooltip) elecTooltip.textContent = "";
            }
        } else {
            endEl.classList.remove('is-invalid');
            if (elecTooltip) elecTooltip.textContent = "";
        }
    }

    // Nước
    if (wEndEl) {
        const waterTooltip = document.getElementById('waterEndTooltip');
        if (wEndEl.value !== "") {
            if (wEnd < wStart) {
                wEndEl.classList.add('is-invalid');
                if (waterTooltip) waterTooltip.textContent = "Chỉ số cuối kỳ phải ≥ chỉ số đầu kỳ (" + wStart + " m³)";
                isValid = false;
            } else {
                wEndEl.classList.remove('is-invalid');
                if (waterTooltip) waterTooltip.textContent = "";
            }
        } else {
            wEndEl.classList.remove('is-invalid');
            if (waterTooltip) waterTooltip.textContent = "";
        }
    }

    if (submitBtn) {
        submitBtn.disabled = !isValid;
    }
    return isValid;
}

// ── Đồng bộ chỉ số điện → số lượng ──────────────────────────
function syncElectricQty() {
    const start = parseFloat(document.getElementById('ElectricIndexStart').value) || 0;
    const end   = parseFloat(document.getElementById('ElectricIndexEnd').value)   || 0;
    const diff  = Math.max(0, end - start);
    document.getElementById('elecDiff').textContent = `Tiêu thụ: ${diff.toFixed(2)} kWh`;
    document.querySelectorAll('.electric-qty').forEach(el => {
        el.value = diff.toFixed(2);
        recalcRow(el.closest('tr'));
    });
    validateIndices();
}

function syncWaterQty() {
    const start = parseFloat(document.getElementById('WaterIndexStart').value) || 0;
    const end   = parseFloat(document.getElementById('WaterIndexEnd').value)   || 0;
    const diff  = Math.max(0, end - start);
    document.getElementById('waterDiff').textContent = `Tiêu thụ: ${diff.toFixed(2)} m³`;
    document.querySelectorAll('.water-qty').forEach(el => {
        el.value = diff.toFixed(2);
        recalcRow(el.closest('tr'));
    });
    validateIndices();
}

// ── Tính lại 1 dòng dịch vụ ──────────────────────────────────
function recalcRow(tr) {
    const qty   = parseFloat(tr.querySelector('.qty-input').value)   || 0;
    const price = parseFloat(tr.querySelector('.price-input').value) || 0;
    const amt   = qty * price;
    tr.querySelector('.amount-cell').textContent   = Math.round(amt).toLocaleString('vi-VN') + ' ₫';
    tr.querySelector('.amount-hidden').value = Math.round(amt);
    recalcTotal();
}

// ── Tính lại tổng ────────────────────────────────────────────
function recalcTotal() {
    let svcTotal = 0;
    document.querySelectorAll('.amount-hidden').forEach(inp => {
        svcTotal += parseFloat(inp.value) || 0;
    });
    const rent     = parseFloat(document.getElementById('RoomRentAmount').value) || 0;
    const discount = parseFloat(document.getElementById('Discount').value) || 0;
    const total    = rent + svcTotal - discount;

    document.getElementById('rentDisplay').textContent     = Math.round(rent).toLocaleString('vi-VN') + ' ₫';
    document.getElementById('svcTotalDisplay').textContent = Math.round(svcTotal).toLocaleString('vi-VN') + ' ₫';
    document.getElementById('totalDisplay').textContent    = Math.round(total).toLocaleString('vi-VN') + ' ₫';
}

// ── Khởi tạo khi load ─────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
    syncElectricQty();
    syncWaterQty();
    document.querySelectorAll('#serviceTable tbody tr').forEach(tr => recalcRow(tr));
    recalcTotal();
});
</script>
}
