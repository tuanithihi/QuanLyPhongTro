@model QuanLyPhongTro.Models.tblContract
@{
    ViewData["Title"] = "Thêm hợp đồng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
<div class="pagetitle">
    <h1>Hợp đồng</h1>
    <nav><ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Contract" asp-action="Index">Danh sách</a></li>
        <li class="breadcrumb-item active">Thêm mới</li>
    </ol></nav>
</div>

<section class="section">
<form asp-area="Admin" asp-controller="Contract" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

    <div class="row g-3">

        @* ── Cột trái: nội dung hợp đồng ── *@
        <div class="col-lg-8">

            @* Card 1: Thông tin cơ bản *@
            <div class="card mb-3">
                <div class="card-header py-3">
                    <h6 class="mb-0 fw-semibold">Thông tin cơ bản</h6>
                </div>
                <div class="card-body pt-3">

                    <div class="row mb-3">
                        <div class="col-md-5">
                            <label asp-for="ContractCode" class="form-label fw-semibold"></label>
                            <input asp-for="ContractCode" class="form-control font-monospace"
                                   placeholder="VD: HD-2026-001" />
                            <span asp-validation-for="ContractCode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="RoomId" class="form-label fw-semibold"></label>
                            <select asp-for="RoomId" class="form-select"
                                    asp-items="@((SelectList)ViewBag.RoomList)" id="roomSelect">
                                <option value="">-- Chọn phòng --</option>
                            </select>
                            <span asp-validation-for="RoomId" class="text-danger small"></span>
                            <div class="form-text">Chỉ hiển thị phòng đang trống.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TenantId" class="form-label fw-semibold"></label>
                            <select asp-for="TenantId" class="form-select"
                                    asp-items="@((SelectList)ViewBag.TenantList)">
                                <option value="">-- Chọn người thuê --</option>
                            </select>
                            <span asp-validation-for="TenantId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-semibold"></label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-semibold"></label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <div class="form-text">Để trống nếu không xác định.</div>
                        </div>
                    </div>

                </div>
            </div>

            @* Card 2: Tài chính *@
            <div class="card mb-3">
                <div class="card-header py-3">
                    <h6 class="mb-0 fw-semibold">Tài chính</h6>
                </div>
                <div class="card-body pt-3">

                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label asp-for="MonthlyRent" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="MonthlyRent" type="number" min="0" step="50000"
                                       class="form-control" id="rentInput" />
                                <span class="input-group-text">đ/tháng</span>
                            </div>
                            <span asp-validation-for="MonthlyRent" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="Deposit" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Deposit" type="number" min="0" step="50000"
                                       class="form-control" id="depositInput" />
                                <span class="input-group-text">đ</span>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="PaymentDayOfMonth" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="PaymentDayOfMonth" type="number" min="1" max="28"
                                       class="form-control" />
                                <span class="input-group-text">/tháng</span>
                            </div>
                            <span asp-validation-for="PaymentDayOfMonth" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-5">
                            <label asp-for="InitialElectricIndex" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="InitialElectricIndex" type="number" min="0" step="0.1"
                                       class="form-control" />
                                <span class="input-group-text">kWh</span>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="InitialWaterIndex" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="InitialWaterIndex" type="number" min="0" step="0.1"
                                       class="form-control" />
                                <span class="input-group-text">m³</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            @* Card 3: Điều khoản & Ghi chú *@
            <div class="card">
                <div class="card-header py-3">
                    <h6 class="mb-0 fw-semibold">Điều khoản &amp; Ghi chú</h6>
                </div>
                <div class="card-body pt-3">
                    <div class="mb-3">
                        <label asp-for="Terms" class="form-label fw-semibold"></label>
                        <textarea asp-for="Terms" class="form-control" rows="5"
                                  placeholder="Ghi các điều khoản hợp đồng..."></textarea>
                    </div>
                    <div class="mb-0">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control" rows="2"
                                  placeholder="Ghi chú thêm (tuỳ chọn)"></textarea>
                    </div>
                </div>
            </div>

        </div>

        @* ── Cột phải: tóm tắt + actions ── *@
        <div class="col-lg-4">

            <div class="card mb-3">
                <div class="card-header py-3">
                    <h6 class="mb-0 fw-semibold">Tổng quan</h6>
                </div>
                <div class="card-body pt-2 pb-2">
                    <table class="table table-borderless table-sm mb-0">
                        <tr>
                            <td class="text-muted small fw-semibold">Tiền thuê</td>
                            <td class="text-end fw-bold text-primary" id="sum-rent">—</td>
                        </tr>
                        <tr>
                            <td class="text-muted small fw-semibold">Đặt cọc</td>
                            <td class="text-end" id="sum-deposit">—</td>
                        </tr>
                        <tr>
                            <td class="text-muted small fw-semibold">Ngày TT</td>
                            <td class="text-end" id="sum-day">—</td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Lưu hợp đồng
                        </button>
                        <a asp-area="Admin" asp-controller="Contract" asp-action="Index"
                           class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </div>
            </div>

        </div>

    </div>
</form>
</section>
</main>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    const fmt = n => n ? Number(n).toLocaleString('vi-VN') + ' đ' : '—';

    function updateSummary() {
        document.getElementById('sum-rent').textContent    = fmt(document.getElementById('rentInput').value);
        document.getElementById('sum-deposit').textContent = fmt(document.getElementById('depositInput').value);
        const day = document.querySelector('[name="PaymentDayOfMonth"]').value;
        document.getElementById('sum-day').textContent = day ? 'Ngày ' + day + ' hàng tháng' : '—';
    }

    document.getElementById('rentInput').addEventListener('input', updateSummary);
    document.getElementById('depositInput').addEventListener('input', updateSummary);
    document.querySelector('[name="PaymentDayOfMonth"]').addEventListener('input', updateSummary);

    document.getElementById('roomSelect').addEventListener('change', async function () {
        const roomId = this.value;
        if (!roomId) return;
        try {
            const res  = await fetch('/Admin/Contract/GetRoomPrice?roomId=' + roomId);
            if (!res.ok) return;
            const data = await res.json();
            document.getElementById('rentInput').value    = data.price;
            document.getElementById('depositInput').value = data.deposit;
            updateSummary();
        } catch {}
    });
</script>
}
