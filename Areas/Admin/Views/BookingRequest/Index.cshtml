@model List<QuanLyPhongTro.Models.tblBookingRequest>
@using QuanLyPhongTro.Models
@{
    ViewData["Title"] = "Yêu cầu đặt lịch xem";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    int    currentPage  = ViewBag.Page;
    int    totalPages   = ViewBag.TotalPages;
    int    totalItems   = ViewBag.TotalItems;
    int    pendingCount = ViewBag.PendingCount;
    string filterStatus = ViewBag.Status ?? "";
}

<main id="main" class="main">

    <div class="pagetitle">
        <h1>Yêu cầu đặt lịch xem</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a>
                </li>
                <li class="breadcrumb-item active">Yêu cầu đặt lịch xem</li>
            </ol>
        </nav>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <section class="section">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex flex-wrap align-items-center gap-3 py-3">

                        @* ── Bộ lọc: Trạng thái ── *@
                        <div class="d-flex gap-1 flex-wrap">

                        @* ── Bộ lọc: Trạng thái ── *@
                        <div class="d-flex gap-1 flex-wrap">
                            <a asp-action="Index" asp-route-status=""
                               class="btn btn-sm @(filterStatus == "" ? "btn-secondary" : "btn-outline-secondary") rounded-pill">
                                Mọi trạng thái
                            </a>
                            <a asp-action="Index" asp-route-status="pending"
                               class="btn btn-sm @(filterStatus == "pending" ? "btn-warning text-dark" : "btn-outline-warning") rounded-pill">
                                Chờ xử lý
                                @if (pendingCount > 0 && filterStatus != "pending")
                                {
                                    <span class="badge bg-danger ms-1">@pendingCount</span>
                                }
                            </a>
                            <a asp-action="Index" asp-route-status="accepted"
                               class="btn btn-sm @(filterStatus == "accepted" ? "btn-success" : "btn-outline-success") rounded-pill">
                                Đã chấp nhận
                            </a>
                            <a asp-action="Index" asp-route-status="rejected"
                               class="btn btn-sm @(filterStatus == "rejected" ? "btn-danger" : "btn-outline-danger") rounded-pill">
                                Đã từ chối
                            </a>
                        </div>

                        <span class="ms-auto text-muted small">@totalItems kết quả</span>
                    </div>

                    <div class="card-body p-0">
                        @if (!Model.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không có yêu cầu nào.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3" style="width:40px;">#</th>
                                            <th>Phòng</th>
                                            <th>Người liên hệ</th>
                                            <th>Nội dung</th>
                                            <th>Loại</th>
                                            <th>Trạng thái</th>
                                            <th>Thời gian</th>
                                            <th class="text-center pe-3">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var req in Model)
                                        {
                                            <tr class="@(req.Status == BookingRequestStatus.Pending ? "table-warning-subtle" : "")">
                                                <td class="ps-3 text-muted small">@req.RequestId</td>

                                                <td>
                                                    <span class="fw-semibold">@(req.Room?.RoomName ?? "—")</span>
                                                    <div class="text-muted small">@(req.Room?.RoomCode ?? "")</div>
                                                </td>

                                                <td>
                                                    <div class="fw-semibold">@req.FullName</div>
                                                    <div class="text-muted small">
                                                        <i class="bi bi-telephone me-1"></i>@req.Phone
                                                    </div>
                                                </td>

                                                <td style="max-width:220px;">
                                                    @if (req.RequestType == BookingRequestType.ViewingRequest && !string.IsNullOrEmpty(req.PreferredDate))
                                                    {
                                                        <div class="small">
                                                            <i class="bi bi-calendar me-1 text-primary"></i>
                                                            Ngày xem: <strong>@req.PreferredDate</strong>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(req.Message))
                                                    {
                                                        <div class="text-muted small text-truncate" style="max-width:200px;"
                                                             title="@req.Message">
                                                            @req.Message
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(req.AdminNote))
                                                    {
                                                        <div class="text-info small mt-1">
                                                            <i class="bi bi-pencil me-1"></i>Ghi chú: @req.AdminNote
                                                        </div>
                                                    }
                                                </td>

                                                <td>
                                                    @if (req.RequestType == BookingRequestType.ViewingRequest)
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2">
                                                            <i class="bi bi-calendar-check me-1"></i>Đặt lịch xem
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-info-subtle text-info rounded-pill px-2">
                                                            <i class="bi bi-chat-dots me-1"></i>Tin nhắn
                                                        </span>
                                                    }
                                                </td>

                                                <td>
                                                    @switch (req.Status)
                                                    {
                                                        case BookingRequestStatus.Pending:
                                                            <span class="badge bg-warning text-dark rounded-pill px-2">Chờ xử lý</span>
                                                            break;
                                                        case BookingRequestStatus.Accepted:
                                                            <span class="badge bg-success rounded-pill px-2">Đã chấp nhận</span>
                                                            break;
                                                        case BookingRequestStatus.Rejected:
                                                            <span class="badge bg-danger rounded-pill px-2">Đã từ chối</span>
                                                            break;
                                                    }
                                                </td>

                                                <td class="small text-muted text-nowrap">
                                                    @req.CreatedAt.ToString("dd/MM/yyyy")
                                                    <div>@req.CreatedAt.ToString("HH:mm")</div>
                                                </td>

                                                <td class="text-center pe-3">
                                                    @if (req.Status == BookingRequestStatus.Pending)
                                                    {
                                                        @* Nút chấp nhận nhanh *@
                                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@req.RequestId" />
                                                            <input type="hidden" name="action" value="accept" />
                                                            <input type="hidden" name="returnStatus" value="@filterStatus" />
                                                            <input type="hidden" name="returnPage" value="@currentPage" />
                                                            <button type="submit" class="btn btn-sm btn-success rounded-pill"
                                                                    title="Chấp nhận">
                                                                <i class="bi bi-check-lg"></i>
                                                            </button>
                                                        </form>

                                                        @* Nút từ chối (mở modal ghi chú) *@
                                                        <button type="button"
                                                                class="btn btn-sm btn-danger rounded-pill ms-1"
                                                                title="Từ chối"
                                                                onclick="openRejectModal(@req.RequestId, '@Html.Raw(req.FullName.Replace("'","\\'"  ))')">
                                                            <i class="bi bi-x-lg"></i>
                                                        </button>
                                                    }

                                                    @* Nút xóa *@
                                                    <form asp-action="Delete" method="post" class="d-inline ms-1"
                                                          onsubmit="return confirm('Xóa yêu cầu này?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@req.RequestId" />
                                                        <input type="hidden" name="returnStatus" value="@filterStatus" />
                                                        <input type="hidden" name="returnPage" value="@currentPage" />
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill"
                                                                title="Xóa">
                                                            <i class="bi bi-trash3"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @* ── Phân trang ── *@
                            @if (totalPages > 1)
                            {
                                <div class="d-flex justify-content-center py-3">
                                    <nav>
                                        <ul class="pagination pagination-sm mb-0">
                                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                                <a class="page-link" asp-action="Index"
                                                   asp-route-page="@(currentPage-1)"
                                                   asp-route-status="@filterStatus">«</a>
                                            </li>
                                            @for (int p = Math.Max(1, currentPage-2); p <= Math.Min(totalPages, currentPage+2); p++)
                                            {
                                                <li class="page-item @(p == currentPage ? "active" : "")">
                                                    <a class="page-link" asp-action="Index"
                                                       asp-route-page="@p"
                                                       asp-route-status="@filterStatus">@p</a>
                                                </li>
                                            }
                                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                                <a class="page-link" asp-action="Index"
                                                   asp-route-page="@(currentPage+1)"
                                                   asp-route-status="@filterStatus">»</a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>

@* ── Modal Từ chối (có ghi chú) ── *@
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="bi bi-x-circle me-2"></i>Từ chối yêu cầu
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Từ chối yêu cầu của <strong id="rejectName"></strong></p>
                <form id="rejectForm" asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="rejectId" value="" />
                    <input type="hidden" name="action" value="reject" />
                    <input type="hidden" name="returnStatus" value="@filterStatus" />
                    <input type="hidden" name="returnPage" value="@currentPage" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lý do từ chối (tùy chọn)</label>
                        <textarea name="adminNote" class="form-control" rows="2"
                                  placeholder="Ví dụ: Phòng đã được đặt, vui lòng liên hệ lại sau..."></textarea>
                    </div>
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Huỷ</button>
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="bi bi-x-lg me-1"></i>Xác nhận từ chối
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openRejectModal(id, name) {
        document.getElementById('rejectId').value = id;
        document.getElementById('rejectName').textContent = name;
        new bootstrap.Modal(document.getElementById('rejectModal')).show();
    }
</script>
}
