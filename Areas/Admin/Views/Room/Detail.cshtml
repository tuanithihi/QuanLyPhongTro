@model QuanLyPhongTro.Models.tblRoom
@using QuanLyPhongTro.Models
@{
    ViewData["Title"] = $"Chi tiết: {Model.RoomName}";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var galleryImages = (Model.GalleryImages ?? "")
        .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
    var amenityItems = (Model.IncludedAmenities ?? "")
        .Split(new[] { "\r\n", "\n", ",", ";" }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
}

<main id="main" class="main">

    <div class="pagetitle">
        <h1>Chi tiết phòng: @Model.RoomCode</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Room" asp-action="Index">Danh sách phòng</a></li>
                <li class="breadcrumb-item active">@Model.RoomCode</li>
            </ol>
        </nav>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <section class="section">
        <div class="row">

            <!-- ── THÔNG TIN PHÒNG ──────────────────── -->
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-body text-center pt-4">
                        @if (!string.IsNullOrEmpty(Model.ThumbnailImage))
                        {
                            <img src="@Model.ThumbnailImage" alt="@Model.RoomName"
                                 class="img-fluid rounded mb-3"
                                 style="max-height:220px;object-fit:cover;width:100%;">
                        }
                        else
                        {
                            <div class="bg-light rounded d-flex align-items-center justify-content-center mb-3"
                                 style="height:180px;">
                                <i class="bi bi-building text-muted" style="font-size:3rem;"></i>
                            </div>
                        }

                        <h4 class="mb-0">@Model.RoomName</h4>
                        <p><code class="fs-6">@Model.RoomCode</code></p>

                        @switch (Model.Status)
                        {
                            case RoomStatus.Available:
                                <span class="badge bg-success fs-6 px-3 py-2">Phòng trống</span>
                                break;
                            case RoomStatus.Occupied:
                                <span class="badge bg-primary fs-6 px-3 py-2">Đang thuê</span>
                                break;
                            case RoomStatus.Maintenance:
                                <span class="badge bg-warning text-dark fs-6 px-3 py-2">Bảo trì</span>
                                break;
                        }

                        <div class="mt-3 d-grid gap-2">
                            <a asp-area="Admin" asp-controller="Room" asp-action="Edit"
                               asp-route-id="@Model.RoomId" class="btn btn-primary">
                                <i class="bi bi-pencil me-1"></i> Chỉnh sửa
                            </a>
                            <a asp-area="Admin" asp-controller="Room" asp-action="Index"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── CHI TIẾT & HỢP ĐỒNG ─────────────── -->
            <div class="col-lg-8">

                <!-- Thông tin cơ bản -->
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Thông tin cơ bản</h5>
                        <div class="row">
                            <div class="col-6 col-md-3 mb-3">
                                <small class="text-muted d-block">Khu trọ</small>
                                <strong>@(Model.Property?.Name ?? "—")</strong>
                            </div>
                            <div class="col-6 col-md-3 mb-3">
                                <small class="text-muted d-block">Loại phòng</small>
                                <strong>@(Model.RoomType?.RoomTypeName ?? "—")</strong>
                            </div>
                            <div class="col-6 col-md-3 mb-3">
                                <small class="text-muted d-block">Tầng</small>
                                <strong>Tầng @Model.Floor</strong>
                            </div>
                            <div class="col-6 col-md-3 mb-3">
                                <small class="text-muted d-block">Diện tích</small>
                                <strong>@Model.Area m²</strong>
                            </div>
                            <div class="col-6 col-md-3 mb-3">
                                <small class="text-muted d-block">Số người tối đa</small>
                                <strong>@Model.MaxOccupants người</strong>
                            </div>
                            <div class="col-6 col-md-3 mb-3">
                                <small class="text-muted d-block">Giá thuê</small>
                                <strong class="text-primary">@Model.RoomPrice.ToString("N0") đ/tháng</strong>
                            </div>
                            <div class="col-6 col-md-3 mb-3">
                                <small class="text-muted d-block">Tiền đặt cọc</small>
                                <strong>@Model.DefaultDeposit.ToString("N0") đ</strong>
                            </div>
                            <div class="col-6 col-md-3 mb-3">
                                <small class="text-muted d-block">Hiển thị web</small>
                                @if (Model.IsPublished)
                                {
                                    <span class="badge bg-success">Công khai</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Ẩn</span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <hr>
                            <small class="text-muted d-block mb-1">Mô tả</small>
                            <p class="mb-0">@Model.Description</p>
                        }

                        @if (Model.RoomAmenities.Any())
                        {
                            <hr>
                            <small class="text-muted d-block mb-2">Tiện ích phòng</small>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var ra in Model.RoomAmenities)
                                {
                                    <span class="badge bg-light text-dark border">
                                        @if (!string.IsNullOrEmpty(ra.Amenity?.Icon))
                                        {
                                            <i class="@ra.Amenity.Icon text-primary me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check2 text-success me-1"></i>
                                        }
                                        @ra.Amenity?.Name
                                    </span>
                                }
                            </div>
                        }
                        else if (amenityItems.Any())
                        {
                            <hr>
                            <small class="text-muted d-block mb-2">Vật dụng / đồ dùng có sẵn</small>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var item in amenityItems)
                                {
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-check2 text-success me-1"></i>@item
                                    </span>
                                }
                            </div>
                        }

                        @if (Model.RoomImages.Any())
                        {
                            <hr>
                            <small class="text-muted d-block mb-2">Thư viện ảnh phòng (@Model.RoomImages.Count ảnh)</small>
                            <div class="row g-2">
                                @foreach (var img in Model.RoomImages)
                                {
                                    <div class="col-6 col-md-3 position-relative">
                                        <img src="@img.Url" alt="@Model.RoomName" class="img-fluid rounded border"
                                             style="height:100px;width:100%;object-fit:cover;">
                                        @if (img.IsPrimary)
                                        {
                                            <span class="badge bg-primary position-absolute top-0 start-0 m-1">Đại diện</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (galleryImages.Any())
                        {
                            <hr>
                            <small class="text-muted d-block mb-2">Ảnh mô tả thêm</small>
                            <div class="row g-2">
                                @foreach (var image in galleryImages)
                                {
                                    <div class="col-6 col-md-4">
                                        <img src="@image" alt="@Model.RoomName" class="img-fluid rounded border"
                                             style="height:110px;width:100%;object-fit:cover;">
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Lịch sử hợp đồng -->
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">
                            Hợp đồng
                            <span class="badge bg-secondary ms-1">@Model.Contracts.Count</span>
                        </h5>

                        @if (!Model.Contracts.Any())
                        {
                            <p class="text-muted fst-italic">Chưa có hợp đồng nào.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Mã HĐ</th>
                                            <th>Người thuê</th>
                                            <th>Ngày bắt đầu</th>
                                            <th>Ngày kết thúc</th>
                                            <th>Giá thuê</th>
                                            <th>Trạng thái</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in Model.Contracts)
                                        {
                                            <tr>
                                                <td>
                                                    <a asp-area="Admin" asp-controller="Contract"
                                                       asp-action="Details" asp-route-id="@c.ContractId">
                                                        @c.ContractCode
                                                    </a>
                                                </td>
                                                <td>@(c.Tenant?.FullName ?? "—")</td>
                                                <td>@c.StartDate.ToString("dd/MM/yyyy")</td>
                                                <td>@(c.EndDate.HasValue ? c.EndDate.Value.ToString("dd/MM/yyyy") : "—")</td>
                                                <td>@c.MonthlyRent.ToString("N0") đ</td>
                                                <td>
                                                    @switch (c.Status)
                                                    {
                                                        case ContractStatus.Active:
                                                            <span class="badge bg-success">Đang hiệu lực</span>
                                                            break;
                                                        case ContractStatus.Expired:
                                                            <span class="badge bg-secondary">Hết hạn</span>
                                                            break;
                                                        case ContractStatus.Terminated:
                                                            <span class="badge bg-danger">Chấm dứt</span>
                                                            break;
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </section>

</main>
