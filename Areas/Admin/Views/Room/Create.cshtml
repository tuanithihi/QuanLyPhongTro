@model QuanLyPhongTro.Models.ViewModels.RoomCreateEditViewModel
@{
    ViewData["Title"] = "Thêm phòng mới";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var amenities = ViewBag.Amenities as List<QuanLyPhongTro.Models.tblAmenity> ?? new();
}

@section Styles {
<style>
  .photo-dropzone {
    border: 2px dashed #0d6efd;
    background-color: #f8faff;
    border-radius: 8px;
    padding: 30px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .photo-dropzone:hover {
    background-color: #eef4ff;
    border-color: #0b5ed7;
  }
  .preview-thumb {
    width: 100px;
    height: 75px;
    object-fit: cover;
    border-radius: 6px;
  }
</style>
}

<main id="main" class="main">

  <div class="pagetitle">
    <h1>Thêm phòng trọ mới</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Phòng trọ</a></li>
        <li class="breadcrumb-item active">Thêm mới</li>
      </ol>
    </nav>
  </div>

  <section class="section">
    <div class="card shadow-sm border-0">
      <div class="card-body pt-3">

        <form asp-action="Create" method="post" enctype="multipart/form-data">
          @Html.AntiForgeryToken()
          <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

          <div class="row g-4">
            <!-- Cột trái: Thông tin cơ bản -->
            <div class="col-lg-7">
              <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-info-circle me-1"></i>Thông tin phòng trọ</h5>

              <div class="row g-3">
                <div class="col-md-6">
                  <label asp-for="PropertyId" class="form-label fw-bold">Khu trọ / Tòa nhà <span class="text-danger">*</span></label>
                  <select asp-for="PropertyId" class="form-select" asp-items="ViewBag.PropertyList">
                    <option value="">-- Chọn khu trọ --</option>
                  </select>
                  <span asp-validation-for="PropertyId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                  <label asp-for="RoomTypeId" class="form-label fw-bold">Loại phòng <span class="text-danger">*</span></label>
                  <select asp-for="RoomTypeId" class="form-select" asp-items="ViewBag.RoomTypeList">
                    <option value="">-- Chọn loại phòng --</option>
                  </select>
                  <span asp-validation-for="RoomTypeId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                  <label asp-for="RoomCode" class="form-label fw-bold">Mã phòng <span class="text-danger">*</span></label>
                  <input asp-for="RoomCode" class="form-control" placeholder="P101, P202..." />
                  <span asp-validation-for="RoomCode" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                  <label asp-for="RoomName" class="form-label fw-bold">Tên phòng <span class="text-danger">*</span></label>
                  <input asp-for="RoomName" class="form-control" placeholder="Phòng 101 - Ban công thoáng..." />
                  <span asp-validation-for="RoomName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                  <label asp-for="RoomPrice" class="form-label fw-bold">Giá thuê (VNĐ/tháng) <span class="text-danger">*</span></label>
                  <input asp-for="RoomPrice" type="number" step="10000" class="form-control" placeholder="3000000" />
                  <span asp-validation-for="RoomPrice" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                  <label asp-for="DefaultDeposit" class="form-label fw-bold">Tiền cọc mặc định (VNĐ)</label>
                  <input asp-for="DefaultDeposit" type="number" step="10000" class="form-control" placeholder="3000000" />
                  <span asp-validation-for="DefaultDeposit" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                  <label asp-for="Area" class="form-label fw-bold">Diện tích (m²) <span class="text-danger">*</span></label>
                  <input asp-for="Area" type="number" step="0.5" class="form-control" />
                  <span asp-validation-for="Area" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                  <label asp-for="Floor" class="form-label fw-bold">Tầng</label>
                  <input asp-for="Floor" type="number" class="form-control" />
                </div>

                <div class="col-md-4">
                  <label asp-for="MaxOccupants" class="form-label fw-bold">Số người tối đa</label>
                  <input asp-for="MaxOccupants" type="number" class="form-control" />
                </div>

                <div class="col-12">
                  <label asp-for="Description" class="form-label fw-bold">Mô tả chi tiết phòng</label>
                  <textarea asp-for="Description" class="form-control" rows="4" placeholder="Mô tả không gian, cửa sổ, điều hòa, ban công, nội thất..."></textarea>
                </div>

                <!-- Tiện ích phòng -->
                <div class="col-12">
                  <label class="form-label fw-bold d-block"><i class="bi bi-stars me-1 text-warning"></i>Tiện ích có sẵn trong phòng</label>
                  <div class="row g-2">
                    @foreach (var amenity in amenities)
                    {
                        <div class="col-md-4 col-sm-6">
                          <div class="form-check p-2 border rounded bg-light">
                            <input class="form-check-input" type="checkbox" name="SelectedAmenityIds" value="@amenity.AmenityId" id="amenity-@amenity.AmenityId">
                            <label class="form-check-label fw-semibold" for="amenity-@amenity.AmenityId">
                              @if (!string.IsNullOrEmpty(amenity.Icon))
                              {
                                  <i class="@amenity.Icon me-1 text-primary"></i>
                              }
                              @amenity.Name
                            </label>
                          </div>
                        </div>
                    }
                  </div>
                </div>

              </div>
            </div>

            <!-- Cột phải: Upload nhiều ảnh & Cài đặt hiển thị -->
            <div class="col-lg-5">
              <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-images me-1"></i>Hình ảnh phòng trọ</h5>

              <div class="mb-3">
                <div class="photo-dropzone" onclick="document.getElementById('fileInput').click()">
                  <i class="bi bi-cloud-arrow-up fs-1 text-primary d-block mb-2"></i>
                  <span class="fw-bold d-block">Chọn hoặc kéo thả nhiều ảnh vào đây</span>
                  <span class="text-muted small">Hỗ trợ JPG, PNG, WEBP (Tự động nén và tạo Thumbnail)</span>
                  <input type="file" id="fileInput" name="NewPhotos" multiple accept="image/*" class="d-none" onchange="handleFileSelect(this)" />
                </div>

                <div id="previewContainer" class="d-flex flex-wrap gap-2 mt-3"></div>
              </div>

              <div class="card bg-light border-0 p-3 mt-3">
                <h6 class="fw-bold mb-2">Cài đặt tin đăng</h6>
                <div class="form-check form-switch mb-2">
                  <input class="form-check-input" type="checkbox" asp-for="IsPublished" id="switchPublished">
                  <label class="form-check-label fw-semibold" for="switchPublished">Cho phép hiển thị tin trên Website</label>
                </div>
                <div class="form-check form-switch mb-2">
                  <input class="form-check-input" type="checkbox" asp-for="IsFeatured" id="switchFeatured">
                  <label class="form-check-label fw-semibold" for="switchFeatured">Đánh dấu là Tin Nổi Bật (Featured)</label>
                </div>
                <div class="small text-muted mt-1">
                  <i class="bi bi-info-circle me-1"></i> Tin đăng mới sẽ ở trạng thái Chờ duyệt (Pending) nếu chế độ tự động duyệt chưa được bật.
                </div>
              </div>
            </div>

          </div>

          <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-secondary px-3">Hủy</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
              <i class="bi bi-save me-1"></i> Lưu phòng trọ
            </button>
          </div>
        </form>

      </div>
    </div>
  </section>

</main>

@section Scripts {
<script>
function handleFileSelect(input) {
    const container = document.getElementById('previewContainer');
    container.innerHTML = '';
    if (input.files) {
        Array.from(input.files).forEach((file, index) => {
            const reader = new FileReader();
            reader.onload = function(e) {
                const div = document.createElement('div');
                div.className = 'position-relative border rounded p-1 bg-white shadow-xs';
                div.innerHTML = `
                  <img src="${e.target.result}" class="preview-thumb" />
                  <span class="badge ${index === 0 ? 'bg-primary' : 'bg-secondary'} position-absolute top-0 start-0 m-1">
                    ${index === 0 ? 'Đại diện' : '#' + (index + 1)}
                  </span>
                `;
                container.appendChild(div);
            };
            reader.readAsDataURL(file);
        });
    }
}
</script>
}
