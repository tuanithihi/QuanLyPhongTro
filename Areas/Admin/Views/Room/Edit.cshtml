@model QuanLyPhongTro.Areas.Admin.Models.RoomCreateViewModel
@{
    ViewData["Title"] = "Chỉnh sửa phòng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h1>Chỉnh sửa phòng</h1>
        <nav><ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Room" asp-action="Index">Danh sách phòng</a></li>
            <li class="breadcrumb-item active">Chỉnh sửa — @Model.RoomCode</li>
        </ol></nav>
    </div>

    <section class="section">
        <form asp-area="Admin" asp-controller="Room" asp-action="Edit"
              asp-route-id="@Model.RoomId" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="RoomId">
            <input type="hidden" asp-for="CurrentThumbnail">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none mb-3" id="val-summary"></div>

            <div class="row g-3">

                @* ── Cột trái: thông tin phòng ── *@
                <div class="col-lg-8">
                    <div class="card h-100">
                        <div class="card-header py-3">
                            <h6 class="mb-0 fw-semibold">Thông tin phòng</h6>
                        </div>
                        <div class="card-body pt-3">

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label asp-for="RoomCode" class="form-label fw-semibold"></label>
                                    <input asp-for="RoomCode" class="form-control">
                                    <span asp-validation-for="RoomCode" class="text-danger small"></span>
                                </div>
                                <div class="col-md-8">
                                    <label asp-for="RoomName" class="form-label fw-semibold"></label>
                                    <input asp-for="RoomName" class="form-control">
                                    <span asp-validation-for="RoomName" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="RoomTypeId" class="form-label fw-semibold"></label>
                                    <select asp-for="RoomTypeId" asp-items="Model.RoomTypeSelectList" class="form-select">
                                        <option value="">-- Chọn loại phòng --</option>
                                    </select>
                                    <span asp-validation-for="RoomTypeId" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Floor" class="form-label fw-semibold"></label>
                                    <input asp-for="Floor" class="form-control" type="number" min="1">
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="MaxOccupants" class="form-label fw-semibold"></label>
                                    <input asp-for="MaxOccupants" class="form-control" type="number" min="1">
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label asp-for="RoomPrice" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <input asp-for="RoomPrice" class="form-control" type="number" min="0" step="100000">
                                        <span class="input-group-text">đ/tháng</span>
                                    </div>
                                    <span asp-validation-for="RoomPrice" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="DefaultDeposit" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <input asp-for="DefaultDeposit" class="form-control" type="number" min="0" step="100000">
                                        <span class="input-group-text">đ</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Area" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <input asp-for="Area" class="form-control" type="number" min="0" step="0.5">
                                        <span class="input-group-text">m²</span>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-5">
                                    <label asp-for="Status" class="form-label fw-semibold"></label>
                                    <select asp-for="Status" class="form-select">
                                        <option value="0">Phòng trống</option>
                                        <option value="1">Đang thuê</option>
                                        <option value="2">Bảo trì</option>
                                    </select>
                                </div>
                                <div class="col-md-4 d-flex align-items-end pb-1">
                                    <div class="form-check form-switch">
                                        <input asp-for="IsPublished" class="form-check-input" type="checkbox" role="switch">
                                        <label asp-for="IsPublished" class="form-check-label fw-semibold"></label>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-semibold"></label>
                                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                            </div>

                            @* ── Vị trí phòng ── *@
                            <div class="card border-success border-opacity-25 mt-3">
                                <div class="card-header py-2" style="background:#E8F8F5">
                                    <h6 class="mb-0 fw-semibold text-success">
                                        <i class="bi bi-geo-alt-fill me-1"></i>Vị trí phòng
                                    </h6>
                                </div>
                                <div class="card-body pt-3">
                                    <div class="row mb-2">
                                        <div class="col-md-9">
                                            <label asp-for="Address" class="form-label fw-semibold"></label>
                                            <input asp-for="Address" class="form-control" id="addressInput"
                                                   placeholder="VD: 123 Lê Lợi, TP. Vinh, Nghệ An" />
                                        </div>
                                        <div class="col-md-3 d-flex align-items-end">
                                            <button type="button" id="btnGeocode" class="btn btn-outline-success w-100">
                                                <i class="bi bi-crosshair me-1"></i>Lấy tọa độ
                                            </button>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label asp-for="Latitude" class="form-label fw-semibold"></label>
                                            <input asp-for="Latitude" class="form-control" id="latInput"
                                                   type="number" step="any" placeholder="VD: 18.6796" />
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Longitude" class="form-label fw-semibold"></label>
                                            <input asp-for="Longitude" class="form-control" id="lngInput"
                                                   type="number" step="any" placeholder="VD: 105.6813" />
                                        </div>
                                    </div>
                                    <small class="text-muted mt-1 d-block">
                                        <i class="bi bi-info-circle me-1"></i>Nhập địa chỉ rồi bấm "Lấy tọa độ" để tự động điền vĩ độ & kinh độ.
                                    </small>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                @* ── Cột phải: ảnh + nút lưu ── *@
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-header py-3">
                            <h6 class="mb-0 fw-semibold">Ảnh đại diện</h6>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(Model.CurrentThumbnail))
                            {
                                <p class="text-muted small mb-1">Ảnh hiện tại:</p>
                                <img id="img-current" src="@Model.CurrentThumbnail" alt="current"
                                     class="img-fluid rounded mb-3"
                                     style="max-height:200px;width:100%;object-fit:cover;border:1px solid #dee2e6;">
                            }
                            <label class="form-label fw-semibold small">Thay ảnh mới (tuỳ chọn)</label>
                            <input asp-for="ThumbnailFile" class="form-control" type="file"
                                   accept="image/*" onchange="previewNew(this)">
                            <div class="mt-3" id="img-new-wrap" style="display:none">
                                <p class="text-muted small mb-1">Ảnh mới:</p>
                                <img id="img-new" src="" alt="new" class="img-fluid rounded"
                                     style="max-height:200px;width:100%;object-fit:cover;border:1px solid #dee2e6;">
                            </div>
                            @if (string.IsNullOrEmpty(Model.CurrentThumbnail))
                            {
                                <div id="img-placeholder" class="text-center text-muted py-5 border rounded mt-2"
                                     style="border-style:dashed!important;font-size:.85rem;">
                                    <i class="bi bi-image fs-2 d-block mb-1"></i>Chưa có ảnh
                                </div>
                            }
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg me-1"></i> Lưu thay đổi
                                </button>
                                <a asp-area="Admin" asp-controller="Room" asp-action="Detail"
                                   asp-route-id="@Model.RoomId" class="btn btn-outline-secondary">
                                    Xem chi tiết
                                </a>
                                <a asp-area="Admin" asp-controller="Room" asp-action="Index"
                                   class="btn btn-outline-secondary">Quay lại</a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </form>
    </section>
</main>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        function previewNew(input) {
            const wrap = document.getElementById('img-new-wrap');
            const img  = document.getElementById('img-new');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => { img.src = e.target.result; wrap.style.display = ''; };
                reader.readAsDataURL(input.files[0]);
            } else {
                wrap.style.display = 'none';
            }
        }
        const vs = document.getElementById('val-summary');
        if (vs && vs.querySelectorAll('li').length) vs.classList.remove('d-none');

        // ── GEOCODING ──────────────────────────────────────────────────
        document.getElementById('btnGeocode')?.addEventListener('click', async function () {
            const addr = document.getElementById('addressInput').value.trim();
            if (!addr) { alert('Vui lòng nhập địa chỉ trước.'); return; }

            const btn = this;
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Đang tìm...';

            try {
                const resp = await fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&q=' + encodeURIComponent(addr));
                const data = await resp.json();
                if (data.length > 0) {
                    document.getElementById('latInput').value = parseFloat(data[0].lat).toFixed(7);
                    document.getElementById('lngInput').value = parseFloat(data[0].lon).toFixed(7);
                } else {
                    alert('Không tìm thấy tọa độ cho địa chỉ này. Vui lòng nhập chính xác hơn.');
                }
            } catch {
                alert('Lỗi khi gọi API geocoding. Vui lòng thử lại.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        });
    </script>
}
