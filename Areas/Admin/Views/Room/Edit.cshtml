@model QuanLyPhongTro.Models.ViewModels.RoomCreateEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa phòng trọ";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var amenities = ViewBag.Amenities as List<QuanLyPhongTro.Models.tblAmenity> ?? new();
}

@section Styles {
<style>
  .photo-dropzone {
    border: 2px dashed #0d6efd;
    background-color: #f8faff;
    border-radius: 8px;
    padding: 20px;
    text-align: center;
    cursor: pointer;
  }
  .image-item-card {
    position: relative;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
    width: 140px;
  }
  .image-item-card img {
    width: 100%;
    height: 100px;
    object-fit: cover;
  }
  .primary-badge {
    position: absolute;
    top: 5px;
    left: 5px;
  }
</style>
}

<main id="main" class="main">

  <div class="pagetitle">
    <h1>Chỉnh sửa phòng: @Model.RoomCode</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Phòng trọ</a></li>
        <li class="breadcrumb-item active">Chỉnh sửa</li>
      </ol>
    </nav>
  </div>

  <section class="section">
    <div class="card shadow-sm border-0">
      <div class="card-body pt-3">

        <form asp-action="Edit" asp-route-id="@Model.RoomId" method="post" enctype="multipart/form-data">
          @Html.AntiForgeryToken()
          <input type="hidden" asp-for="RoomId" />
          <input type="hidden" asp-for="Slug" />
          <input type="hidden" asp-for="ApprovalStatus" />
          <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

          <div class="row g-4">
            <!-- Cột trái: Thông tin phòng -->
            <div class="col-lg-7">
              <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-info-circle me-1"></i>Thông tin phòng</h5>

              <div class="row g-3">
                <div class="col-md-6">
                  <label asp-for="PropertyId" class="form-label fw-bold">Khu trọ / Tòa nhà <span class="text-danger">*</span></label>
                  <select asp-for="PropertyId" class="form-select" asp-items="ViewBag.PropertyList">
                    <option value="">-- Chọn khu trọ --</option>
                  </select>
                  <span asp-validation-for="PropertyId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                  <label asp-for="RoomTypeId" class="form-label fw-bold">Loại phòng <span class="text-danger">*</span></label>
                  <select asp-for="RoomTypeId" class="form-select" asp-items="ViewBag.RoomTypeList">
                    <option value="">-- Chọn loại phòng --</option>
                  </select>
                  <span asp-validation-for="RoomTypeId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                  <label asp-for="RoomCode" class="form-label fw-bold">Mã phòng <span class="text-danger">*</span></label>
                  <input asp-for="RoomCode" class="form-control" />
                  <span asp-validation-for="RoomCode" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                  <label asp-for="RoomName" class="form-label fw-bold">Tên phòng <span class="text-danger">*</span></label>
                  <input asp-for="RoomName" class="form-control" />
                  <span asp-validation-for="RoomName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                  <label asp-for="RoomPrice" class="form-label fw-bold">Giá thuê (VNĐ/tháng) <span class="text-danger">*</span></label>
                  <input asp-for="RoomPrice" type="number" step="10000" class="form-control" />
                  <span asp-validation-for="RoomPrice" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                  <label asp-for="DefaultDeposit" class="form-label fw-bold">Tiền cọc mặc định (VNĐ)</label>
                  <input asp-for="DefaultDeposit" type="number" step="10000" class="form-control" />
                  <span asp-validation-for="DefaultDeposit" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                  <label asp-for="Area" class="form-label fw-bold">Diện tích (m²)</label>
                  <input asp-for="Area" type="number" step="0.5" class="form-control" />
                </div>

                <div class="col-md-4">
                  <label asp-for="Floor" class="form-label fw-bold">Tầng</label>
                  <input asp-for="Floor" type="number" class="form-control" />
                </div>

                <div class="col-md-4">
                  <label asp-for="Status" class="form-label fw-bold">Tình trạng</label>
                  <select asp-for="Status" class="form-select">
                    <option value="0">Phòng trống</option>
                    <option value="1">Đang thuê</option>
                    <option value="2">Bảo trì</option>
                  </select>
                </div>

                <div class="col-12">
                  <label asp-for="Description" class="form-label fw-bold">Mô tả chi tiết phòng</label>
                  <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <!-- Tiện ích phòng -->
                <div class="col-12">
                  <label class="form-label fw-bold d-block"><i class="bi bi-stars me-1 text-warning"></i>Tiện ích phòng</label>
                  <div class="row g-2">
                    @foreach (var amenity in amenities)
                    {
                        bool isChecked = Model.SelectedAmenityIds.Contains(amenity.AmenityId);
                        <div class="col-md-4 col-sm-6">
                          <div class="form-check p-2 border rounded bg-light">
                            <input class="form-check-input" type="checkbox" name="SelectedAmenityIds" value="@amenity.AmenityId"
                                   id="amenity-@amenity.AmenityId" checked="@isChecked">
                            <label class="form-check-label fw-semibold" for="amenity-@amenity.AmenityId">
                              @if (!string.IsNullOrEmpty(amenity.Icon))
                              {
                                  <i class="@amenity.Icon me-1 text-primary"></i>
                              }
                              @amenity.Name
                            </label>
                          </div>
                        </div>
                    }
                  </div>
                </div>

              </div>
            </div>

            <!-- Cột phải: Quản lý ảnh & Tải thêm ảnh -->
            <div class="col-lg-5">
              <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-images me-1"></i>Quản lý ảnh phòng</h5>

              <!-- Danh sách ảnh đã có -->
              <div class="mb-3">
                <label class="form-label fw-bold small text-muted">Ảnh hiện có (@Model.ExistingImages.Count)</label>
                <div class="d-flex flex-wrap gap-2" id="existingImagesList">
                  @foreach (var img in Model.ExistingImages)
                  {
                      <div class="image-item-card shadow-xs" id="img-card-@img.ImageId">
                        <img src="@img.Url" alt="Ảnh phòng" />
                        @if (img.IsPrimary)
                        {
                            <span class="badge bg-primary primary-badge" id="badge-@img.ImageId">Đại diện</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary primary-badge d-none" id="badge-@img.ImageId">Đại diện</span>
                        }
                        <div class="p-1 d-flex justify-content-between align-items-center bg-light">
                          <button type="button" class="btn btn-xs btn-outline-primary py-0 px-1" title="Đặt làm ảnh đại diện"
                                  onclick="setPrimaryImage(@Model.RoomId, @img.ImageId)">
                            <i class="bi bi-star"></i>
                          </button>
                          <button type="button" class="btn btn-xs btn-outline-danger py-0 px-1" title="Xóa ảnh"
                                  onclick="deleteImage(@Model.RoomId, @img.ImageId)">
                            <i class="bi bi-trash"></i>
                          </button>
                        </div>
                      </div>
                  }
                </div>
              </div>

              <!-- Upload thêm ảnh -->
              <div class="mb-3">
                <label class="form-label fw-bold small text-muted">Tải thêm ảnh mới</label>
                <div class="photo-dropzone" onclick="document.getElementById('fileInput').click()">
                  <i class="bi bi-cloud-arrow-up fs-2 text-primary d-block mb-1"></i>
                  <span class="small fw-bold d-block">Chọn hoặc kéo thả ảnh thêm vào đây</span>
                  <input type="file" id="fileInput" name="NewPhotos" multiple accept="image/*" class="d-none" />
                </div>
              </div>

              <div class="card bg-light border-0 p-3 mt-3">
                <h6 class="fw-bold mb-2">Cài đặt hiển thị</h6>
                <div class="form-check form-switch mb-2">
                  <input class="form-check-input" type="checkbox" asp-for="IsPublished" id="switchPublished">
                  <label class="form-check-label fw-semibold" for="switchPublished">Hiển thị tin trên Website</label>
                </div>
                <div class="form-check form-switch mb-2">
                  <input class="form-check-input" type="checkbox" asp-for="IsFeatured" id="switchFeatured">
                  <label class="form-check-label fw-semibold" for="switchFeatured">Đánh dấu Tin Nổi Bật</label>
                </div>
              </div>
            </div>

          </div>

          <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-secondary px-3">Quay lại</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
              <i class="bi bi-save me-1"></i> Cập nhật phòng
            </button>
          </div>
        </form>

      </div>
    </div>
  </section>

</main>

@section Scripts {
<script>
async function setPrimaryImage(roomId, imageId) {
    const res = await fetch(`/Admin/Room/SetPrimaryImage?roomId=${roomId}&imageId=${imageId}`, {
        method: 'POST'
    });
    const data = await res.json();
    if (data.success) {
        // Cập nhật lại giao diện badge
        document.querySelectorAll('.primary-badge').forEach(b => b.classList.add('d-none'));
        const targetBadge = document.getElementById(`badge-${imageId}`);
        if (targetBadge) {
            targetBadge.classList.remove('d-none');
            targetBadge.className = 'badge bg-primary primary-badge';
        }
    } else {
        alert(data.message || 'Không thể đổi ảnh đại diện');
    }
}

async function deleteImage(roomId, imageId) {
    if (!confirm('Bạn có chắc chắn muốn xóa ảnh này không?')) return;
    const res = await fetch(`/Admin/Room/DeleteImage?roomId=${roomId}&imageId=${imageId}`, {
        method: 'POST'
    });
    const data = await res.json();
    if (data.success) {
        const card = document.getElementById(`img-card-${imageId}`);
        if (card) card.remove();
    } else {
        alert(data.message || 'Không thể xóa ảnh');
    }
}
</script>
}
