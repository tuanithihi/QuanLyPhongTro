@model QuanLyPhongTro.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">

    <div class="pagetitle">
        <h1>Tổng quan</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active">Tổng quan</li>
            </ol>
        </nav>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <section class="section dashboard">
        <div class="row">

            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <h5 class="card-title mb-0">Bộ lọc thống kê <span>| @Model.PeriodLabel</span></h5>
                            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-arrow-clockwise me-1"></i>Tháng hiện tại
                            </a>
                        </div>

                        <form method="get" asp-area="Admin" asp-controller="Home" asp-action="Index" class="row g-3 align-items-end" id="dashboardFilterForm">
                            <div class="col-lg-2 col-md-4">
                                <label class="form-label small fw-semibold">Kiểu thống kê</label>
                                <select name="period" id="periodType" class="form-select">
                                    <option value="month" selected="@(Model.PeriodType == "month")">Theo tháng</option>
                                    <option value="quarter" selected="@(Model.PeriodType == "quarter")">Theo quý</option>
                                    <option value="year" selected="@(Model.PeriodType == "year")">Theo năm</option>
                                    <option value="custom" selected="@(Model.PeriodType == "custom")">Tùy chỉnh</option>
                                </select>
                            </div>

                            <div class="col-lg-2 col-md-4 filter-month">
                                <label class="form-label small fw-semibold">Tháng</label>
                                <select name="month" class="form-select">
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m" selected="@(Model.SelectedMonth == m)">Tháng @m</option>
                                    }
                                </select>
                            </div>

                            <div class="col-lg-2 col-md-4 filter-quarter">
                                <label class="form-label small fw-semibold">Quý</label>
                                <select name="quarter" class="form-select">
                                    @for (int q = 1; q <= 4; q++)
                                    {
                                        <option value="@q" selected="@(Model.SelectedQuarter == q)">Quý @q</option>
                                    }
                                </select>
                            </div>

                            <div class="col-lg-2 col-md-4 filter-year">
                                <label class="form-label small fw-semibold">Năm</label>
                                <input type="number" name="year" class="form-control" min="2000" max="2100" value="@Model.SelectedYear" />
                            </div>

                            <div class="col-lg-2 col-md-4 filter-custom">
                                <label class="form-label small fw-semibold">Từ ngày</label>
                                <input type="date" name="fromDate" class="form-control" value="@Model.PeriodStart.ToString("yyyy-MM-dd")" />
                            </div>

                            <div class="col-lg-2 col-md-4 filter-custom">
                                <label class="form-label small fw-semibold">Đến ngày</label>
                                <input type="date" name="toDate" class="form-control" value="@Model.PeriodEnd.ToString("yyyy-MM-dd")" />
                            </div>

                            <div class="col-lg-2 col-md-4">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-funnel me-1"></i>Lọc
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- ── STATS CARDS ─────────────────────────── -->
            <div class="col-12">
                <div class="row">

                    <div class="col-xxl-3 col-md-6">
                        <div class="card info-card sales-card">
                            <div class="card-body">
                                <h5 class="card-title">Tổng phòng</h5>
                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="bi bi-building"></i>
                                    </div>
                                    <div class="ps-3">
                                        <h6>@Model.TotalRooms</h6>
                                        <div class="small">
                                            <span class="text-success fw-bold">@Model.AvailableRooms trống</span> &middot;
                                            <span class="text-primary fw-bold">@Model.OccupiedRooms thuê</span> &middot;
                                            <span class="text-warning fw-bold">@Model.MaintenanceRooms bảo trì</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xxl-3 col-md-6">
                        <div class="card info-card revenue-card">
                            <div class="card-body">
                                <h5 class="card-title">Hợp đồng <span>| Hiệu lực</span></h5>
                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="bi bi-file-text"></i>
                                    </div>
                                    <div class="ps-3">
                                        <h6>@Model.ActiveContracts</h6>
                                        @if (Model.ExpiringContractsIn30Days > 0)
                                        {
                                            <span class="text-warning small fw-bold">@Model.ExpiringContractsIn30Days HĐ sắp hết hạn</span>
                                        }
                                        else
                                        {
                                            <span class="text-success small fw-bold">hợp đồng đang hiệu lực</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xxl-3 col-md-6">
                        <div class="card info-card customers-card">
                            <div class="card-body">
                                <h5 class="card-title">Người thuê <span>| Đang thuê</span></h5>
                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="bi bi-people"></i>
                                    </div>
                                    <div class="ps-3">
                                        <h6>@Model.TotalTenants</h6>
                                        <span class="text-muted small fw-bold">người thuê đang hoạt động</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xxl-3 col-md-6">
                        <div class="card info-card">
                            <div class="card-body">
                                <h5 class="card-title">Doanh thu <span>| @Model.PeriodLabel</span></h5>
                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="bi bi-currency-dollar"></i>
                                    </div>
                                    <div class="ps-3">
                                        <h6>@Model.TotalRevenueThisMonth.ToString("N0") đ</h6>
                                        <span class="text-success small fw-bold">@Model.PaidInvoicesThisMonth đã TT</span>
                                        &middot;
                                        <span class="text-danger small fw-bold">
                                            @(Model.UnpaidInvoicesThisMonth + Model.OverdueInvoicesThisMonth) chưa TT
                                        </span>
                                        <div class="small text-muted mt-1">
                                            @Model.TotalInvoicesInPeriod hóa đơn &middot; dự kiến @Model.ExpectedRevenueInPeriod.ToString("N0") đ
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ── ĐỒNG HỒ ─────────────────────────────── -->
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Thời gian hiện tại</h5>
                        <div class="d-flex justify-content-center align-items-center" style="min-height:260px">
                            <div class="text-center">
                                <div id="current-time" class="display-4 text-primary fw-bold mb-2"
                                     style="font-size:3rem;letter-spacing:2px;"></div>
                                <div id="current-date" class="h5 text-muted"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── SHORTCUTS ──────────────────────────── -->
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Truy cập nhanh</h5>
                        <div class="d-grid gap-2 mt-3">
                            <a asp-area="Admin" asp-controller="Room" asp-action="Create"
                               class="btn btn-outline-primary">
                                <i class="bi bi-plus-circle me-1"></i> Thêm phòng mới
                            </a>
                            <a asp-area="Admin" asp-controller="Room" asp-action="Index"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-building me-1"></i> Quản lý phòng
                            </a>
                            <a asp-area="Admin" asp-controller="Tenant" asp-action="Index"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-people me-1"></i> Danh sách người thuê
                            </a>
                            <a asp-area="Admin" asp-controller="BookingRequest" asp-action="Index"
                               class="btn @(Model.PendingBookingRequests > 0 ? "btn-warning" : "btn-outline-secondary")">
                                <i class="bi bi-calendar2-check me-1"></i> Yêu cầu xem phòng
                                @if (Model.PendingBookingRequests > 0)
                                {
                                    <span class="badge bg-danger ms-1">@Model.PendingBookingRequests chờ</span>
                                }
                            </a>
                            <a asp-area="Admin" asp-controller="Chat" asp-action="Index"
                               class="btn @(Model.OpenChatSessions > 0 ? "btn-info" : "btn-outline-secondary")">
                                <i class="bi bi-chat-dots me-1"></i> Tin nhắn
                                @if (Model.OpenChatSessions > 0)
                                {
                                    <span class="badge bg-danger ms-1">@Model.OpenChatSessions</span>
                                }
                            </a>
                            <a asp-area="Admin" asp-controller="Invoice" asp-action="Index"
                            asp-route-status="0"
                               class="btn @(Model.UnpaidInvoicesThisMonth + Model.OverdueInvoicesThisMonth > 0 ? "btn-outline-danger" : "btn-outline-secondary")">
                                <i class="bi bi-receipt me-1"></i> Hóa đơn chưa thanh toán
                                @if (Model.UnpaidInvoicesThisMonth + Model.OverdueInvoicesThisMonth > 0)
                                {
                                    <span class="badge bg-danger ms-1">
                                        @(Model.UnpaidInvoicesThisMonth + Model.OverdueInvoicesThisMonth)
                                    </span>
                                }
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

</main>

@section Scripts {
    <script>
        function updateClock() {
            const now = new Date();
            document.getElementById('current-time').textContent =
                now.toLocaleTimeString('vi-VN', { hour12: false });
            document.getElementById('current-date').textContent =
                now.toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        }
        updateClock();
        setInterval(updateClock, 1000);

        function updateDashboardFilterControls() {
            const type = document.getElementById('periodType')?.value || 'month';
            document.querySelectorAll('.filter-month').forEach(el => el.classList.toggle('d-none', type !== 'month'));
            document.querySelectorAll('.filter-quarter').forEach(el => el.classList.toggle('d-none', type !== 'quarter'));
            document.querySelectorAll('.filter-year').forEach(el => el.classList.toggle('d-none', type === 'custom'));
            document.querySelectorAll('.filter-custom').forEach(el => el.classList.toggle('d-none', type !== 'custom'));
        }

        document.getElementById('periodType')?.addEventListener('change', updateDashboardFilterControls);
        updateDashboardFilterControls();
    </script>
}
