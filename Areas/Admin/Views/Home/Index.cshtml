@model dynamic
@{
    ViewData["Title"] = "Dashboard";
}

<main id="main" class="main">

    <div class="pagetitle">
      <h1>Dashboard</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/Admin">Home</a></li>
          <li class="breadcrumb-item active">Dashboard</li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section dashboard">
        <div class="row">

            <!-- Statistics Cards -->
            <div class="col-12">
                <div class="row">

                    <div class="col-xxl-3 col-md-6">
                        <div class="card info-card sales-card">
                            <div class="filter">
                                <a class="icon" href="#" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></a>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                    <li class="dropdown-header text-start">
                                        <h6>Filter</h6>
                                    </li>
                                    <li><a class="dropdown-item" href="#">Today</a></li>
                                    <li><a class="dropdown-item" href="#">This Month</a></li>
                                    <li><a class="dropdown-item" href="#">This Year</a></li>
                                </ul>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">Tổng Sách <span>| Hoạt động</span></h5>
                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="bi bi-book"></i>
                                    </div>
                                    <div class="ps-3">
                                        <h6>@ViewBag.TotalBooks</h6>
                                        <span class="text-success small pt-1 fw-bold">cuốn sách</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div><!-- End Tổng Sách Card -->

                    <div class="col-xxl-3 col-md-6">
                        <div class="card info-card revenue-card">
                            <div class="filter">
                                <a class="icon" href="#" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></a>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                    <li class="dropdown-header text-start">
                                        <h6>Filter</h6>
                                    </li>
                                    <li><a class="dropdown-item" href="#">Today</a></li>
                                    <li><a class="dropdown-item" href="#">This Month</a></li>
                                    <li><a class="dropdown-item" href="#">This Year</a></li>
                                </ul>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">Tác Giả <span>| Hoạt động</span></h5>
                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="bi bi-person"></i>
                                    </div>
                                    <div class="ps-3">
                                        <h6>@ViewBag.TotalAuthors</h6>
                                        <span class="text-success small pt-1 fw-bold">tác giả</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div><!-- End Tổng Tác Giả Card -->

                    <div class="col-xxl-3 col-md-6">
                        <div class="card info-card customers-card">
                            <div class="filter">
                                <a class="icon" href="#" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></a>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                    <li class="dropdown-header text-start">
                                        <h6>Filter</h6>
                                    </li>
                                    <li><a class="dropdown-item" href="#">Today</a></li>
                                    <li><a class="dropdown-item" href="#">This Month</a></li>
                                    <li><a class="dropdown-item" href="#">This Year</a></li>
                                </ul>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">Người Dùng <span>| Đã đăng ký</span></h5>
                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="bi bi-people"></i>
                                    </div>
                                    <div class="ps-3">
                                        <h6>@ViewBag.TotalUsers</h6>
                                        <span class="text-danger small pt-1 fw-bold">người dùng</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div><!-- End Tổng Người Dùng Card -->

                    <div class="col-xxl-3 col-md-6">
                        <div class="card info-card customers-card">
                            <div class="card-body">
                                <h5 class="card-title">Lượt Mượn <span>| Tổng cộng</span></h5>
                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="bi bi-journal-check"></i>
                                    </div>
                                    <div class="ps-3">
                                        <h6>@ViewBag.TotalBorrows</h6>
                                        <span class="text-danger small pt-1 fw-bold">lượt mượn</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div><!-- End Tổng Lượt Mượn Card -->

                </div>
            </div><!-- End Statistics Cards -->

            <!-- Main Content -->
            <div class="col-lg-8">
                <div class="row">

                    <!-- Clock Widget -->
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Thời Gian Hiện Tại</h5>
                                <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
                                    <div class="text-center">
                                        <div id="current-time" class="display-4 font-weight-bold text-primary mb-2" style="font-size: 3rem;"></div>
                                        <div id="current-date" class="h5 text-muted"></div>
                                        <div id="current-day" class="text-muted mt-2"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div><!-- End Clock Widget -->
                </div>
            </div><!-- End Main Content -->
            <!-- Right Sidebar -->
            <!-- Right side columns -->
            <div class="col-lg-4">

                <!-- Top Books -->
                <div class="card">
                    <div class="card-body pb-0">
                        <h5 class="card-title">Sách Được Mượn Nhiều Nhất</h5>

                        <div class="news">
                            @if (ViewBag.TopBorrowedBooks != null && ViewBag.TopBorrowedBooks.Count > 0)
                            {
                                foreach (var book in ViewBag.TopBorrowedBooks)
                                {
                                    <div class="post-item clearfix">
                                        <div>
                                            <h4><a href="#" class="text-truncate d-block">@book.BookName</a></h4>
                                            <p class="text-muted small">@book.BorrowCount lượt mượn</p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="bi bi-info-circle fs-1"></i>
                                    <p class="mt-2">Chưa có dữ liệu mượn sách</p>
                                </div>
                            }
                        </div><!-- End sidebar recent posts-->

                    </div>
                </div><!-- End Top Books -->
        </div>
    </section>

</main>

<script>
    // Real-time clock
    function updateClock() {
        const now = new Date();
        const timeString = now.toLocaleTimeString('vi-VN', {
            hour12: false,
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        });
        const dateString = now.toLocaleDateString('vi-VN', {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });
        const dayString = now.toLocaleDateString('vi-VN', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        });

        document.getElementById('current-time').textContent = timeString;
        document.getElementById('current-date').textContent = dateString;
        document.getElementById('current-day').textContent = dayString;
    }

    // Update clock immediately and then every second
    updateClock();
    setInterval(updateClock, 1000);
</script>