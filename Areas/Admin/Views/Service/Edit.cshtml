@model QuanLyPhongTro.Models.tblService
@using QuanLyPhongTro.Models
@{
    ViewData["Title"] = "Sửa dịch vụ";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">

    <div class="pagetitle">
        <h1>Sửa dịch vụ</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Service" asp-action="Index">Dịch vụ</a></li>
                <li class="breadcrumb-item active">Sửa — @Model.ServiceName</li>
            </ol>
        </nav>
    </div>

    <section class="section">
        <div class="card">
            <div class="card-body pt-4">

                <form asp-area="Admin" asp-controller="Service" asp-action="Edit"
                      asp-route-id="@Model.ServiceId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ServiceId" />

                    @await Html.PartialAsync("_ServiceForm", Model)

                    <div class="d-flex gap-2 pt-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Lưu thay đổi
                        </button>
                        <a asp-area="Admin" asp-controller="Service" asp-action="Index"
                           class="btn btn-outline-secondary">Huỷ</a>
                    </div>
                </form>

            </div>
        </div>
    </section>

</main>

@section Scripts {
    @await Html.PartialAsync("_ServiceFormScript")
}
