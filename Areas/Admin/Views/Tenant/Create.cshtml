@model QuanLyPhongTro.Models.tblTenant
@{
    ViewData["Title"] = "Thêm người thuê";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
<div class="pagetitle">
    <h1>Thêm người thuê</h1>
    <nav><ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Tenant" asp-action="Index">Người thuê</a></li>
        <li class="breadcrumb-item active">Thêm mới</li>
    </ol></nav>
</div>

<section class="section">
<form asp-area="Admin" asp-controller="Tenant" asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="linkedUserId" id="linkedUserId" />
    <input type="hidden" name="bookingId" id="bookingId" value="@(ViewBag.SelectedBookingId ?? "")" />
    <div class="row">

        @* ── Cột trái ── *@
        <div class="col-lg-8">

            @* Card chọn từ danh sách khách đặt lịch xem phòng *@
            <div class="card mb-3 border-primary shadow-sm">
                <div class="card-header fw-semibold bg-primary text-white d-flex align-items-center justify-content-between">
                    <div>
                        <i class="bi bi-calendar-check me-2"></i>Chọn từ khách đặt lịch xem phòng
                    </div>
                    @if (ViewBag.BookingList != null)
                    {
                        var count = ((Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.BookingList).Count();
                        <span class="badge bg-light text-primary">@count khách hẹn</span>
                    }
                </div>
                <div class="card-body pt-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-9">
                            <label class="form-label fw-semibold">Khách đã đặt lịch xem phòng</label>
                            <select id="bookingSelect" class="form-select"
                                    asp-items="@((Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.BookingList)">
                                <option value="">-- Chọn khách đặt lịch xem phòng --</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="button" id="btnClearBooking" class="btn btn-outline-secondary d-none w-100">
                                <i class="bi bi-x-lg me-1"></i>Bỏ chọn
                            </button>
                        </div>
                    </div>
                    <div class="form-text mt-1 text-muted">
                        <i class="bi bi-info-circle me-1"></i>Chỉ hiển thị những khách có lịch đặt xem phòng thuộc quyền quản lý của bạn và chưa chuyển thành người thuê.
                    </div>
                    <div id="linkedBookingInfo" class="d-none mt-3 p-3 bg-light border border-primary-subtle rounded-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Đã chọn</span>
                            <strong class="text-dark" id="infoCustomerName"></strong>
                        </div>
                        <div class="row g-2 small text-secondary">
                            <div class="col-sm-6">
                                <i class="bi bi-door-open text-primary me-1"></i>Phòng hẹn: <strong class="text-dark" id="infoRoomName"></strong>
                            </div>
                            <div class="col-sm-6">
                                <i class="bi bi-calendar3 text-primary me-1"></i>Ngày hẹn xem: <strong class="text-dark" id="infoPreferredDate"></strong>
                            </div>
                            <div class="col-12" id="infoMessageWrapper">
                                <i class="bi bi-chat-text text-primary me-1"></i>Lời nhắn: <span class="fst-italic text-dark" id="infoMessage"></span>
                            </div>
                            <div class="col-12 d-none text-success mt-1" id="infoAccountLink">
                                <i class="bi bi-person-badge-fill me-1"></i>Tìm thấy tài khoản website: <strong id="linkedUserName"></strong> (Mật khẩu tài khoản sẽ được đồng bộ tự động).
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold"><i class="bi bi-person me-2"></i>Thông tin cơ bản</div>
                <div class="card-body pt-3">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdentityNumber" class="form-label fw-semibold"></label>
                            <input asp-for="IdentityNumber" class="form-control font-monospace" placeholder="012345678901" />
                            <span asp-validation-for="IdentityNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Phone" class="form-control" placeholder="0901234567" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="example@email.com" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Gender" class="form-label fw-semibold"></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">-- Chọn --</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="IsActive" class="form-label fw-semibold d-block">Trạng thái</label>
                            <div class="form-check form-switch mt-1">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                                <label asp-for="IsActive" class="form-check-label">Kích hoạt</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="PermanentAddress" class="form-label fw-semibold"></label>
                            <textarea asp-for="PermanentAddress" class="form-control" rows="2"
                                      placeholder="Địa chỉ thường trú..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold"><i class="bi bi-key me-2"></i>Tài khoản đăng nhập <span class="text-muted fw-normal small">(tuỳ chọn)</span></div>
                <div class="card-body pt-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label fw-semibold"></label>
                            <input asp-for="Username" class="form-control" placeholder="username" autocomplete="off" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                            <div class="form-text">Để trống nếu không cho phép đăng nhập.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Mật khẩu</label>
                            <input type="password" name="password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                            <div class="form-text">Bắt buộc nếu có tên đăng nhập.</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        @* ── Cột phải: Ảnh ── *@
        <div class="col-lg-4">

            <div class="card mb-3">
                <div class="card-header fw-semibold"><i class="bi bi-image me-2"></i>Ảnh đại diện</div>
                <div class="card-body text-center pt-3">
                    <img id="prevAvatar" src="/assets/img/no-avatar.png" class="rounded-circle mb-2"
                         style="width:90px;height:90px;object-fit:cover;"
                         onerror="this.src='/assets/img/no-avatar.png'" />
                    <input type="file" name="avatarFile" class="form-control form-control-sm"
                           accept="image/*" onchange="previewImg(this,'prevAvatar')" />
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold"><i class="bi bi-card-image me-2"></i>Ảnh CCCD/CMND</div>
                <div class="card-body pt-3">
                    <label class="form-label small">Mặt trước</label>
                    <img id="prevFront" class="img-fluid rounded mb-1 d-none" style="max-height:120px;" />
                    <input type="file" name="frontFile" class="form-control form-control-sm mb-3"
                           accept="image/*" onchange="previewImg(this,'prevFront')" />

                    <label class="form-label small">Mặt sau</label>
                    <img id="prevBack" class="img-fluid rounded mb-1 d-none" style="max-height:120px;" />
                    <input type="file" name="backFile" class="form-control form-control-sm"
                           accept="image/*" onchange="previewImg(this,'prevBack')" />
                </div>
            </div>

        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <button type="submit" class="btn btn-primary"><i class="bi bi-floppy me-1"></i>Lưu</button>
        <a asp-area="Admin" asp-controller="Tenant" asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>
</section>
</main>

@section Scripts {
<script>
function previewImg(input, imgId) {
    const img = document.getElementById(imgId);
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { img.src = e.target.result; img.classList.remove('d-none'); };
        reader.readAsDataURL(input.files[0]);
    }
}

// Chọn từ danh sách khách đặt lịch xem phòng
const bookingSelect      = document.getElementById('bookingSelect');
const bookingIdInput     = document.getElementById('bookingId');
const linkedUserId       = document.getElementById('linkedUserId');
const btnClear           = document.getElementById('btnClearBooking');
const infoBox            = document.getElementById('linkedBookingInfo');
const infoCustomerName   = document.getElementById('infoCustomerName');
const infoRoomName       = document.getElementById('infoRoomName');
const infoPreferredDate  = document.getElementById('infoPreferredDate');
const infoMessageWrapper = document.getElementById('infoMessageWrapper');
const infoMessage        = document.getElementById('infoMessage');
const infoAccountLink    = document.getElementById('infoAccountLink');
const linkedUserName     = document.getElementById('linkedUserName');

async function handleBookingChange(bId) {
    if (!bId) {
        clearBookingSelection();
        return;
    }

    try {
        const res = await fetch('/Admin/Tenant/GetBookingInfo?bookingId=' + bId);
        if (!res.ok) { clearBookingSelection(); return; }
        const data = await res.json();

        // Tự động điền các thông tin
        setVal('FullName', data.fullName);
        setVal('Phone',    data.phone);
        if (data.email)    setVal('Email', data.email);
        if (data.username) setVal('Username', data.username);

        // Cập nhật card tóm tắt
        bookingIdInput.value = data.requestId;
        infoCustomerName.textContent = data.fullName + (data.phone ? ' (' + data.phone + ')' : '');
        infoRoomName.textContent = (data.roomCode ? '[' + data.roomCode + '] ' : '') + data.roomName + (data.propertyName ? ' - ' + data.propertyName : '');
        infoPreferredDate.textContent = data.preferredDate || 'Chưa ghi rõ';

        if (data.message) {
            infoMessage.textContent = data.message;
            infoMessageWrapper.classList.remove('d-none');
        } else {
            infoMessageWrapper.classList.add('d-none');
        }

        // Nếu khách có tài khoản website
        const pwCol = document.querySelector('[name="password"]')?.closest('.col-md-6');
        if (data.hasUserAccount && data.linkedUserId) {
            linkedUserId.value = data.linkedUserId;
            linkedUserName.textContent = data.username;
            infoAccountLink.classList.remove('d-none');

            if (data.avatar) {
                const av = document.getElementById('prevAvatar');
                if (av) av.src = data.avatar;
            }

            if (pwCol) {
                pwCol.style.opacity = '0.4';
                document.querySelector('[name="password"]').disabled = true;
            }
        } else {
            linkedUserId.value = '';
            infoAccountLink.classList.add('d-none');
            if (pwCol) {
                pwCol.style.opacity = '';
                document.querySelector('[name="password"]').disabled = false;
            }
        }

        infoBox.classList.remove('d-none');
        btnClear.classList.remove('d-none');
    } catch (err) {
        console.error(err);
        clearBookingSelection();
    }
}

bookingSelect.addEventListener('change', function () {
    handleBookingChange(this.value);
});

btnClear.addEventListener('click', function () {
    bookingSelect.value = '';
    clearBookingSelection();
});

function clearBookingSelection() {
    bookingIdInput.value = '';
    linkedUserId.value = '';
    infoBox.classList.add('d-none');
    btnClear.classList.add('d-none');
    const pwInput = document.querySelector('[name="password"]');
    if (pwInput) {
        pwInput.closest('.col-md-6').style.opacity = '';
        pwInput.disabled = false;
    }
}

function setVal(name, val) {
    const el = document.querySelector('[name="' + name + '"]');
    if (el) el.value = val || '';
}

// Nếu đã có sẵn bookingId khi mở trang (từ URL param hoặc ViewBag)
document.addEventListener('DOMContentLoaded', function () {
    if (bookingSelect && bookingSelect.value) {
        handleBookingChange(bookingSelect.value);
    }
});
</script>
}
