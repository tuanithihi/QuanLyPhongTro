@model QuanLyPhongTro.Models.tblTenant
@{
    ViewData["Title"] = "Sửa thông tin người thuê";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
<div class="pagetitle">
    <h1>Sửa người thuê</h1>
    <nav><ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Tenant" asp-action="Index">Người thuê</a></li>
        <li class="breadcrumb-item active">@Model.FullName</li>
    </ol></nav>
</div>

<section class="section">
<form asp-area="Admin" asp-controller="Tenant" asp-action="Edit"
      asp-route-id="@Model.TenantId" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input asp-for="TenantId" type="hidden" />
    <div class="row">

        @* ── Cột trái ── *@
        <div class="col-lg-8">

            <div class="card mb-3">
                <div class="card-header fw-semibold"><i class="bi bi-person me-2"></i>Thông tin cơ bản</div>
                <div class="card-body pt-3">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdentityNumber" class="form-label fw-semibold"></label>
                            <input asp-for="IdentityNumber" class="form-control font-monospace" />
                            <span asp-validation-for="IdentityNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Gender" class="form-label fw-semibold"></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">-- Chọn --</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="IsActive" class="form-label fw-semibold d-block">Trạng thái</label>
                            <div class="form-check form-switch mt-1">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label">Kích hoạt</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="PermanentAddress" class="form-label fw-semibold"></label>
                            <textarea asp-for="PermanentAddress" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold"><i class="bi bi-key me-2"></i>Tài khoản đăng nhập</div>
                <div class="card-body pt-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label fw-semibold"></label>
                            <input asp-for="Username" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                            <div class="form-text">Để trống để thu hồi quyền đăng nhập.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Mật khẩu mới</label>
                            <input type="password" name="password" class="form-control"
                                   placeholder="Để trống = giữ mật khẩu cũ" autocomplete="new-password" />
                        </div>
                    </div>
                </div>
            </div>

        </div>

        @* ── Cột phải: Ảnh ── *@
        <div class="col-lg-4">

            <div class="card mb-3">
                <div class="card-header fw-semibold"><i class="bi bi-image me-2"></i>Ảnh đại diện</div>
                <div class="card-body text-center pt-3">
                    <img id="prevAvatar"
                         src="@(string.IsNullOrEmpty(Model.Avatar) ? "/assets/img/no-avatar.png" : Model.Avatar)"
                         class="rounded-circle mb-2"
                         style="width:90px;height:90px;object-fit:cover;"
                         onerror="this.src='/assets/img/no-avatar.png'" />
                    <input type="file" name="avatarFile" class="form-control form-control-sm"
                           accept="image/*" onchange="previewImg(this,'prevAvatar')" />
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-semibold"><i class="bi bi-card-image me-2"></i>Ảnh CCCD/CMND</div>
                <div class="card-body pt-3">
                    <label class="form-label small">Mặt trước</label>
                    @if (!string.IsNullOrEmpty(Model.IdentityFrontImage))
                    {
                        <img src="@Model.IdentityFrontImage" class="img-fluid rounded mb-1" style="max-height:120px;" />
                    }
                    <img id="prevFront" class="img-fluid rounded mb-1 d-none" style="max-height:120px;" />
                    <input type="file" name="frontFile" class="form-control form-control-sm mb-3"
                           accept="image/*" onchange="previewImg(this,'prevFront')" />

                    <label class="form-label small">Mặt sau</label>
                    @if (!string.IsNullOrEmpty(Model.IdentityBackImage))
                    {
                        <img src="@Model.IdentityBackImage" class="img-fluid rounded mb-1" style="max-height:120px;" />
                    }
                    <img id="prevBack" class="img-fluid rounded mb-1 d-none" style="max-height:120px;" />
                    <input type="file" name="backFile" class="form-control form-control-sm"
                           accept="image/*" onchange="previewImg(this,'prevBack')" />
                </div>
            </div>

        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <button type="submit" class="btn btn-primary"><i class="bi bi-floppy me-1"></i>Lưu thay đổi</button>
        <a asp-area="Admin" asp-controller="Tenant" asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>
</section>
</main>

@section Scripts {
<script>
function previewImg(input, imgId) {
    const img = document.getElementById(imgId);
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { img.src = e.target.result; img.classList.remove('d-none'); };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
}
