@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<QuanLyThuVien.Models.tblAuthor>

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Quản lý tác giả</h2>
        <p>
            <a class="btn btn-primary" asp-area="Admin" asp-controller="Author" asp-action="Create">
                <i class="bi bi-person-plus-fill me-1"></i> Thêm tác giả
            </a>
        </p>
    </div>

    <section class="section dashboard">
        <div class="card recent-sales overflow-auto">
            <div class="card-body mt-3">
                <table class="table table-hover align-middle">
                    <thead class="table-light text-center">
                        <tr>
                            <th>#</th>
                            <th>Ảnh</th>
                            <th>Tên tác giả</th>
                            <th>Ngày sinh</th>
                            <th>Email</th>
                            <th>Tiểu sử</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            int stt = (Model.PageNumber - 1) * Model.PageSize + 1;
                            foreach (var author in Model)
                            {
                                <tr>
                                    <td class="text-center">@stt</td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(author.Avatar))
                                        {
                                            <img src="@author.Avatar" alt="Avatar" class="rounded-circle border" width="45" height="45" />
                                        }
                                        else
                                        {
                                            <img src="/uploads/authors/default.png" alt="No Avatar" class="rounded-circle border" width="45" height="45" />
                                        }
                                    </td>
                                    <td class="text-center">@author.AuthorName</td>
                                    <td class="text-center">
                                        @author.DateOfBirth?.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-center">@author.Email</td>
                                    <td class="text-truncate" style="max-width:200px;">
                                        @author.Biography
                                    </td>
                                    <td class="text-center">
                                        @if (author.IsActive == true)
                                        {
                                            <span class="badge bg-success">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Ngừng</span>
                                        }
                                    </td>
                                    <td class="text-center">@author.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <a asp-area="Admin" asp-controller="Author" asp-action="Details" asp-route-id="@author.AuthorID"
                                           class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                                        <a asp-area="Admin" asp-controller="Author" asp-action="Edit" asp-route-id="@author.AuthorID"
                                           class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i></a>
                                        <a asp-area="Admin" asp-controller="Author" asp-action="Delete" asp-route-id="@author.AuthorID"
                                           class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></a>
                                    </td>
                                </tr>
                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted">Không có tác giả nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- PHÂN TRANG -->
                <ul class="pagination justify-content-end mb-0">
                    <pager class="pager-container"
                           list="@Model"
                           options="@PagedListRenderOptions.Bootstrap4PageNumbersOnly"
                           asp-area="Admin"
                           asp-controller="Author"
                           asp-action="Index">
                    </pager>
                </ul>
            </div>
        </div>
    </section>
</main>
